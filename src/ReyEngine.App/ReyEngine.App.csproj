<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- M576: NAudio 3 ships its Windows output devices (WaveOutEvent) only for a
         windows TFM. This app is Windows-only already - D3D11, win-x64 publish - so the
         target now says so. Core/Formats/Rendering stay plain net10.0. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- M87: embeds the icon in the PE header (Explorer/taskbar .exe icon). This uses the Win32
         resource path, NOT Avalonia.Build.Tasks, so it's safe alongside the loose-PNG workaround below. -->
    <ApplicationIcon>Assets\reyengine.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <!-- M155: ColorPicker lives in its own assembly with its own control themes; FluentTheme does NOT
         merge them, so without this (and the StyleInclude in App.axaml) the control renders as nothing. -->
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- M576: NAudio 3 split the Windows output devices (WaveOutEvent) and Media Foundation out of
         the metapackage, which now carries only Core + Midi. Both halves are needed here. -->
    <PackageReference Include="NAudio" Version="3.0.1" />
    <PackageReference Include="NAudio.WinMM" Version="3.0.1" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copied next to the exe and loaded at runtime; embedding the logo as an AvaloniaResource
         corrupted the assembly IL via Avalonia.Build.Tasks, so we avoid the resource compiler. -->
    <Content Include="Assets\reyengine_logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\reyengine.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- M682: the Blender add-on ships beside the exe so Settings can install it into Blender. -->
    <Content Include="..\..\tools\blender\reyengine_bridge.py" Link="blender\reyengine_bridge.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReyEngine.Core\ReyEngine.Core.csproj" />
    <ProjectReference Include="..\ReyEngine.Formats\ReyEngine.Formats.csproj" />
    <ProjectReference Include="..\ReyEngine.Rendering\ReyEngine.Rendering.csproj" />
    <ProjectReference Include="..\ReyEngine.Rendering.D3D11\ReyEngine.Rendering.D3D11.csproj" />
  </ItemGroup>

</Project>
