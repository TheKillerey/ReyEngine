<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ReyEngine.App.ViewModels"
             xmlns:conv="clr-namespace:ReyEngine.App.Converters"
             x:Class="ReyEngine.App.Views.MapOutlinerView">
  <UserControl.Resources>
    <conv:BoolToBrushConverter x:Key="SelectionHighlight" TrueBrush="#3336E2C2" FalseBrush="Transparent" />
  </UserControl.Resources>

  <!-- M51: ONE unified hierarchy (Unity/Unreal style) — plain folders (Meshes / Particles / Mobs /
       Probes) in a single tree; select any object type here. No per-category collapse sections. -->
  <DockPanel IsVisible="{Binding MapContent.HasMap}">
    <TextBlock DockPanel.Dock="Top" Text="{Binding MapContent.MapName}" Foreground="{DynamicResource ReyAccentBrush}"
               FontSize="11" FontWeight="SemiBold" Margin="8,4,8,2" />

    <!-- scene-level visibility layers -->
    <StackPanel DockPanel.Dock="Top" Margin="8,2,8,4" Spacing="3" IsVisible="{Binding HasVisibilityAxes}">
      <TextBlock Classes="cardTitle" Text="VISIBILITY LAYERS" />
      <ItemsControl ItemsSource="{Binding VisibilityAxes}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,0,3">
              <TextBlock Text="{Binding Name}" FontSize="9" Foreground="{DynamicResource ReyTextDimBrush}" />
              <ComboBox ItemsSource="{Binding Options}" SelectedIndex="{Binding SelectedIndex}"
                        FontSize="10" HorizontalAlignment="Stretch"
                        ToolTip.Tip="States are read from this map's shipping .bin and applied through its mapgeo masks and visibility controllers." />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- view toggles (what renders in the viewport)

         M290: a WrapPanel, not a horizontal StackPanel. A StackPanel never wraps and never shrinks its
         children, so once the panel was narrower than the six buttons laid end to end the last ones -
         "Grid" and "Hear" - were simply clipped off the right edge, reachable only by widening the whole
         window. Wrapping puts them on a second row instead, so every toggle stays reachable at any panel
         width. Spacing is per-button margin rather than the panel's own spacing properties, which differ
         across Avalonia versions. -->
    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,5,4">
      <ToggleButton Classes="vp" Content="✨ Particles" IsChecked="{Binding ShowParticles}" FontSize="9" Padding="6,1" Margin="0,0,3,3"
                    ToolTip.Tip="Show particle markers in the viewport" />
      <ToggleButton Classes="vp" Content="▶ Play All" IsChecked="{Binding PlayAllParticles}" FontSize="9" Padding="6,1" Margin="0,0,3,3"
                    ToolTip.Tip="Simulate every placed particle system; only near, on-screen placements stay active" />
      <ToggleButton Classes="vp" Content="🎭 Props" IsChecked="{Binding ShowPropMeshes}" FontSize="9" Padding="6,1" Margin="0,0,3,3"
                    ToolTip.Tip="Render the actual prop meshes (Baron, dragons, camps…) at their placements" />
      <ToggleButton Classes="vp" Content="▶ Anim" IsChecked="{Binding PlayPropAnimations}" FontSize="9" Padding="6,1" Margin="0,0,3,3"
                    IsEnabled="{Binding ShowPropMeshes}"
                    ToolTip.Tip="Play each prop's idle animation (Baron breathing, camps shuffling…). Needs Props enabled." />
      <ToggleButton Classes="vp" Content="⌗ Grid" IsChecked="{Binding ShowBucketGrid}" FontSize="9" Padding="6,1" Margin="0,0,3,3"
                    ToolTip.Tip="Show the mapgeo's scene bucket grid (League's culling grid) as a ground overlay" />
      <ToggleButton Classes="vp" Content="🔊 Hear" IsChecked="{Binding AmbienceEnabled}" FontSize="9" Padding="6,1" Margin="0,0,3,3"
                    ToolTip.Tip="Positional ambience: loop the nearest sound placements with distance-based volume as you fly the camera (needs vgmstream-cli)" />
    </WrapPanel>

    <!-- M331: Blender-style object workflow. Ctrl toggles, Shift selects a range, X/Delete stages a
         batch delete. Eye is editor-only; Disable persists as visibility mask 0 and stays reversible. -->
    <Border DockPanel.Dock="Top" Classes="card" Margin="6,0,6,5" Padding="5"
            IsVisible="{Binding HasMapContentSelection}">
      <StackPanel Spacing="4">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding MapContentSelectionText}" FontSize="9" Foreground="{DynamicResource ReyAccentBrush}" />
          <TextBlock Grid.Column="1" Text="Ctrl select · Shift range · X delete" FontSize="8"
                     Foreground="{DynamicResource ReyTextDimBrush}" />
        </Grid>
        <WrapPanel>
          <Button Classes="tool" Content="◉ Show" Command="{Binding ShowMapContentSelectionCommand}" FontSize="9" Padding="5,1" Margin="0,0,3,3" />
          <Button Classes="tool" Content="○ Hide" Command="{Binding HideMapContentSelectionCommand}" FontSize="9" Padding="5,1" Margin="0,0,3,3"
                  ToolTip.Tip="Editor-only visibility; does not change exported map files" />
          <Button Classes="tool" Content="Enable" Command="{Binding EnableMapContentSelectionCommand}" FontSize="9" Padding="5,1" Margin="0,0,3,3" />
          <Button Classes="tool" Content="Disable" Command="{Binding DisableMapContentSelectionCommand}" FontSize="9" Padding="5,1" Margin="0,0,3,3"
                  ToolTip.Tip="Persistently disable selected objects by assigning visibility mask 0" />
          <Button Classes="tool" Content="Delete…" Command="{Binding DeleteMapContentSelectionCommand}" FontSize="9" Padding="5,1" Margin="0,0,3,3" />
          <Button Classes="primary" Content="Save Edits" Command="{Binding SaveMapContentEditsCommand}" FontSize="9" Padding="6,1" Margin="0,0,3,3" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- the hierarchy -->
    <TreeView x:Name="MapContentTree"
              ItemsSource="{Binding MapContent.OutlinerRoots}" SelectedItem="{Binding SelectedOutlinerItem, Mode=TwoWay}"
              Background="Transparent" BorderThickness="0" Padding="4,0">
      <TreeView.DataTemplates>
        <TreeDataTemplate DataType="vm:OutlinerFolderViewModel" ItemsSource="{Binding Items}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="{Binding Icon}" FontSize="10" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource ReyAccentBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </TreeDataTemplate>

        <TreeDataTemplate DataType="vm:MapLayerGroupViewModel" ItemsSource="{Binding Meshes}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="🗂" FontSize="10" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource ReyTextBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </TreeDataTemplate>
        <DataTemplate DataType="vm:MapPieceViewModel">
          <Border Background="{Binding IsSelected, Converter={StaticResource SelectionHighlight}}"
                  CornerRadius="2" Padding="3,0" Margin="-3,0">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="🧊" FontSize="9" VerticalAlignment="Center" />
              <TextBlock Text="OFF" FontSize="8" Foreground="#E5A227" IsVisible="{Binding IsDisabled}" />
              <TextBlock Text="DEL" FontSize="8" Foreground="#E5645B" IsVisible="{Binding IsRemoved}" />
              <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{DynamicResource ReyTextBrush}"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </DataTemplate>

        <TreeDataTemplate DataType="vm:ParticleSystemGroupViewModel" ItemsSource="{Binding Placements}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="✨" FontSize="9" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Header}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource ReyTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel>
        </TreeDataTemplate>
        <DataTemplate DataType="vm:ParticlePlacementViewModel">
          <Border Background="{Binding IsSelected, Converter={StaticResource SelectionHighlight}}" CornerRadius="2" Padding="3,0" Margin="-3,0">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="✦" FontSize="9" Foreground="#36E2C2" VerticalAlignment="Center" />
              <TextBlock Text="OFF" FontSize="8" Foreground="#E5A227" IsVisible="{Binding IsDisabled}" />
              <TextBlock Text="DEL" FontSize="8" Foreground="#E5645B" IsVisible="{Binding IsRemoved}" />
              <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{DynamicResource ReyTextDimBrush}"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </DataTemplate>

        <TreeDataTemplate DataType="vm:AnimatedPropGroupViewModel" ItemsSource="{Binding Props}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="🎭" FontSize="9" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Header}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource ReyTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel>
        </TreeDataTemplate>
        <DataTemplate DataType="vm:AnimatedPropViewModel">
          <Border Background="{Binding IsSelected, Converter={StaticResource SelectionHighlight}}" CornerRadius="2" Padding="3,0" Margin="-3,0">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Text="🐾" FontSize="9" VerticalAlignment="Center" />
              <TextBlock Text="OFF" FontSize="8" Foreground="#E5A227" IsVisible="{Binding IsDisabled}" />
              <TextBlock Text="DEL" FontSize="8" Foreground="#E5645B" IsVisible="{Binding IsRemoved}" />
              <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{DynamicResource ReyTextDimBrush}"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </DataTemplate>

        <DataTemplate DataType="vm:CubemapProbeViewModel">
          <Border Background="{Binding IsSelected, Converter={StaticResource SelectionHighlight}}" CornerRadius="2" Padding="3,0" Margin="-3,0"><StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="🪞" FontSize="9" VerticalAlignment="Center" />
            <TextBlock Text="OFF" FontSize="8" Foreground="#E5A227" IsVisible="{Binding IsDisabled}" />
            <TextBlock Text="DEL" FontSize="8" Foreground="#E5645B" IsVisible="{Binding IsRemoved}" />
            <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{DynamicResource ReyTextDimBrush}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel></Border>
        </DataTemplate>

        <DataTemplate DataType="vm:MapSoundViewModel">
          <Border Background="{Binding IsSelected, Converter={StaticResource SelectionHighlight}}" CornerRadius="2" Padding="3,0" Margin="-3,0"><StackPanel Orientation="Horizontal" Spacing="5" ToolTip.Tip="{Binding EventName}">
            <TextBlock Text="🔊" FontSize="9" VerticalAlignment="Center" />
            <TextBlock Text="OFF" FontSize="8" Foreground="#E5A227" IsVisible="{Binding IsDisabled}" />
            <TextBlock Text="DEL" FontSize="8" Foreground="#E5645B" IsVisible="{Binding IsRemoved}" />
            <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{DynamicResource ReyTextDimBrush}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel></Border>
        </DataTemplate>

        <DataTemplate DataType="vm:AddedMapMeshViewModel">
          <Border Background="{Binding IsSelected, Converter={StaticResource SelectionHighlight}}" CornerRadius="2" Padding="3,0" Margin="-3,0"><StackPanel Orientation="Horizontal" Spacing="5" ToolTip.Tip="{Binding Info}">
            <TextBlock Text="➕" FontSize="9" VerticalAlignment="Center" />
            <TextBlock Text="OFF" FontSize="8" Foreground="#E5A227" IsVisible="{Binding IsDisabled}" />
            <TextBlock Text="DEL" FontSize="8" Foreground="#E5645B" IsVisible="{Binding IsRemoved}" />
            <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{DynamicResource ReyTextDimBrush}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel></Border>
        </DataTemplate>

        <DataTemplate DataType="vm:PointLightViewModel">
          <StackPanel Orientation="Horizontal" Spacing="5" ToolTip.Tip="{Binding Info}">
            <Border Width="9" Height="9" CornerRadius="2" VerticalAlignment="Center"
                    Background="{Binding ColorHex}" BorderBrush="#555" BorderThickness="1" />
            <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{DynamicResource ReyTextDimBrush}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:BucketGridViewModel">
          <StackPanel Orientation="Horizontal" Spacing="5" ToolTip.Tip="{Binding Info}">
            <TextBlock Text="⌗" FontSize="9" Foreground="#9E73F2" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{DynamicResource ReyTextDimBrush}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </TreeView.DataTemplates>
    </TreeView>
  </DockPanel>
</UserControl>
