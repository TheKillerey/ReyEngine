<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ReyEngine.App.Views"
        xmlns:vm="clr-namespace:ReyEngine.App.ViewModels"
        x:Class="ReyEngine.App.Views.RitobinEditorWindow"
        x:DataType="vm:RitobinEditorViewModel"
        Title="ReyEngine — Bin as ritobin text" Width="1080" Height="740"
        MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource ReyBgBrush}">
  <DockPanel>
    <views:ReyTitleBar DockPanel.Dock="Top" />

    <!-- toolbar -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource ReyHeaderBrush}"
            BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="0,0,0,1" Padding="12,7">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="0,0,10,0"
                   Foreground="{DynamicResource ReyTextBrush}" TextTrimming="CharacterEllipsis" />
        <!-- M499: the buffer holds ONE object by default. Avalonia's TextBox does not virtualise, so a
             whole 36,697-line bin re-measures its entire layout on every keystroke. -->
        <ComboBox DockPanel.Dock="Left" ItemsSource="{Binding Scopes}" SelectedItem="{Binding SelectedScope}"
                  MinWidth="300" MaxWidth="440" FontSize="11" VerticalAlignment="Center"
                  IsEnabled="{Binding HasTarget}"
                  ToolTip.Tip="Which object is in the buffer. Editing one object is fast; the whole file is not. Apply replaces only what the buffer describes." />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <Button Classes="tool" Content="Import .py…" Name="ImportButton" FontSize="11" Padding="10,4"
                  IsEnabled="{Binding HasTarget}"
                  ToolTip.Tip="Load ritobin text from a file into the buffer. It is not written until you press Apply." />
          <Button Classes="tool" Content="Export .py…" Name="ExportButton" FontSize="11" Padding="10,4"
                  IsEnabled="{Binding HasTarget}"
                  ToolTip.Tip="Save the text as a .py file — the extension the community uses so editors highlight it." />
          <Button Classes="tool" Content="↺ Revert" Command="{Binding RevertCommand}" FontSize="11" Padding="10,4"
                  IsEnabled="{Binding HasTarget}" ToolTip.Tip="Throw away edits and re-read the bin." />
          <Button Classes="tool" Content="✓ Validate" Command="{Binding ValidateCommand}" FontSize="11" Padding="10,4"
                  IsEnabled="{Binding HasTarget}" ToolTip.Tip="Parse the text without writing anything." />
          <Button Classes="primary" Content="Apply to bin" Command="{Binding ApplyCommand}" FontSize="11" Padding="14,4"
                  IsEnabled="{Binding HasTarget}"
                  ToolTip.Tip="Parse, re-serialise and save. Nothing is written unless the text parses AND the result reads back cleanly." />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- status -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource ReyHeaderBrush}"
            BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="0,1,0,0" Padding="12,7">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="●" FontSize="11" VerticalAlignment="Center"
                   Foreground="{DynamicResource ReyAccent2Brush}" IsVisible="{Binding IsDirty}"
                   ToolTip.Tip="Unsaved edits" />
        <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                   Foreground="{DynamicResource ReyTextBrush}" />
      </StackPanel>
    </Border>

    <!-- errors -->
    <Border DockPanel.Dock="Bottom" IsVisible="{Binding HasErrors}" MaxHeight="150"
            Background="{DynamicResource ReyCardBrush}" BorderBrush="{DynamicResource ReyWarningBrush}"
            BorderThickness="0,1,0,0" Padding="12,6">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="PROBLEMS — nothing is written while these stand" FontSize="10"
                   FontWeight="SemiBold" Foreground="{DynamicResource ReyWarningBrush}" Margin="0,0,0,4" />
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding Errors}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" FontSize="10" FontFamily="Cascadia Mono, Consolas, monospace"
                           Foreground="{DynamicResource ReyTextBrush}" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- the text itself -->
    <Border Margin="12" CornerRadius="5" BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="1"
            ClipToBounds="True">
      <TextBox Text="{Binding Text}" AcceptsReturn="True" AcceptsTab="True" IsReadOnly="{Binding !HasTarget}"
               FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"
               Background="Transparent" BorderThickness="0" Padding="8"
               TextWrapping="NoWrap"
               ScrollViewer.HorizontalScrollBarVisibility="Auto"
               ScrollViewer.VerticalScrollBarVisibility="Auto" />
    </Border>
  </DockPanel>
</Window>
