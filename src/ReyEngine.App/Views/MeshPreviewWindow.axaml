<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ReyEngine.App.Views"
        xmlns:vm="clr-namespace:ReyEngine.App.ViewModels"
        x:Class="ReyEngine.App.Views.MeshPreviewWindow"
        x:DataType="vm:MeshPreviewViewModel"
        Title="{Binding WindowTitle}" Width="1400" Height="820"
        x:CompileBindings="True"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource ReyBgBrush}">
  <!-- M50: character/mesh preview in its own window; the main viewport stays on the map -->
  <DockPanel>
    <views:ReyTitleBar DockPanel.Dock="Top" />
    <Border DockPanel.Dock="Top" Background="{DynamicResource ReyHeaderBrush}"
            BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="0,0,0,1" Padding="8,5">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <ToggleButton Classes="vp" Content="🗺 Map" IsChecked="{Binding BackgroundVisible}"
                        IsVisible="{Binding HasBackground}" ToolTip.Tip="{Binding BackgroundMapName, StringFormat='Backdrop: {0}'}" />
          <ToggleButton Classes="vp" Content="🎯 Dummy" IsChecked="{Binding TargetDummyEnabled}"
                        ToolTip.Tip="Target dummy — a stand-in unit so targeted spells (Kayn R…) have somewhere to land. Drag its gizmo arrows to move it." />
          <ToggleButton Classes="vp" Content="▦ Grid" IsChecked="{Binding ShowGrid}" ToolTip.Tip="Show the reference grid" />
          <ToggleButton Classes="vp" Content="🔊 SFX" IsChecked="{Binding SfxEnabled}" ToolTip.Tip="Play the clip's sound events (like in-game)" />
          <!-- M672: the same mode list as the map viewport, bound to both renderers -->
          <ComboBox SelectedIndex="{Binding PreviewMode}" FontSize="11" MinWidth="120" VerticalAlignment="Center"
                    ToolTip.Tip="Shading mode. Basic / Riot Approx draw the material (on D3D11 both are Riot's own shaders); the Debug views show one input at a time - Base is the diffuse as painted, unlit">
            <ComboBoxItem>Basic</ComboBoxItem>
            <ComboBoxItem>Riot Approx</ComboBoxItem>
            <ComboBoxItem>Debug · Base</ComboBoxItem>
            <ComboBoxItem>Debug · Alpha</ComboBoxItem>
            <ComboBoxItem>Debug · Normals</ComboBoxItem>
            <ComboBoxItem>Debug · Mask</ComboBoxItem>
            <ComboBoxItem>Debug · Emissive</ComboBoxItem>
            <ComboBoxItem>Debug · MatCap</ComboBoxItem>
            <ComboBoxItem>Debug · UV Checker</ComboBoxItem>
            <ComboBoxItem>Debug · Specular</ComboBoxItem>
            <ComboBoxItem>Debug · Vertex Color</ComboBoxItem>
            <ComboBoxItem>Debug · Lightmap</ComboBoxItem>
            <ComboBoxItem>Debug · Face Orientation</ComboBoxItem>
            <ComboBoxItem>Debug · Two-Sided</ComboBoxItem>
            <ComboBoxItem>Debug · Mirrored</ComboBoxItem>
          </ComboBox>
          <ToggleButton Classes="vp" Content="⌗ Wire" IsChecked="{Binding Wireframe}" />
          <ToggleButton Classes="vp" Content="🦴 Bones" IsChecked="{Binding ShowBones}" />
          <ToggleButton Classes="vp" Content="✂ Cull" IsChecked="{Binding CullBackfaces}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="🧊 MODEL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ReyAccentBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Title}" FontSize="11" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Stats}" FontSize="10" Opacity="0.6" VerticalAlignment="Center" />
        </StackPanel>
      </DockPanel>
    </Border>
    <!-- M642: the character editor layout. The viewport keeps the left; the right is a resizable
         tabbed panel - Material (the skin bin, live on both renderers), Animate, Play, Scene - in
         place of the one 250px column every card used to share. -->
    <Grid ColumnDefinitions="250,4,*,4,340">
      <!-- M643: the left panel. The champion picker is M610's browser, embedded - the same view model,
           the same three lists - and the outliner is the SUBMESHES card grown up: each row names the
           material it draws with, and selecting one outlines it and opens that material on the right. -->
      <Border Grid.Column="0" Background="{DynamicResource ReyPanelBrush}"
              BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="0,0,1,0">
        <ScrollViewer>
          <StackPanel Margin="8" Spacing="8">
            <Border Classes="card" IsVisible="{Binding Browser, Converter={x:Static ObjectConverters.IsNotNull}}">
              <StackPanel Spacing="4">
                <TextBlock Classes="cardTitle" Text="CHARACTER" />
                <TextBox Text="{Binding Browser.Search}" PlaceholderText="Search champions" FontSize="11" Padding="4,2" />
                <ListBox ItemsSource="{Binding Browser.Champions}" SelectedItem="{Binding Browser.SelectedChampion}"
                         Height="180" Background="{DynamicResource ReyBgBrush}"
                         BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="1">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChampionRowViewModel">
                      <StackPanel Margin="2,0">
                        <TextBlock Text="{Binding Name}" FontSize="11" />
                        <TextBlock Text="{Binding SourceLabel}" FontSize="9" Foreground="{DynamicResource ReyTextDimBrush}" />
                        <TextBlock Text="{Binding Folder}" FontSize="9" IsVisible="{Binding ShowFolder}"
                                   Foreground="{DynamicResource ReyTextDimBrush}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <ComboBox ItemsSource="{Binding Browser.Characters}" SelectedItem="{Binding Browser.SelectedCharacter}"
                          HorizontalAlignment="Stretch" FontSize="11"
                          ToolTip.Tip="A champion WAD also ships its pets, summons and second forms - each a full character with its own skins.">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:CharacterRowViewModel">
                      <TextBlock FontSize="11"><Run Text="{Binding Name}" /><Run Text=" · " /><Run Text="{Binding SkinCountText}" /></TextBlock>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <ListBox ItemsSource="{Binding Browser.Skins}" SelectedItem="{Binding Browser.SelectedSkin}"
                         Height="160" Background="{DynamicResource ReyBgBrush}"
                         BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="1">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SkinRowViewModel">
                      <Grid ColumnDefinitions="28,*,Auto" Margin="2,0">
                        <TextBlock Grid.Column="0" Text="{Binding NumberText}" FontSize="10"
                                   Foreground="{DynamicResource ReyTextDimBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding Badge}" FontSize="9"
                                   Foreground="{DynamicResource ReyAccent2Brush}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Button Classes="primary" Content="Load skin" Command="{Binding Browser.OpenSkinCommand}"
                        HorizontalAlignment="Stretch" FontSize="11" Padding="8,3" />
                <TextBlock Text="{Binding Browser.Status}" FontSize="9" TextWrapping="Wrap"
                           Foreground="{DynamicResource ReyTextDimBrush}" />
              </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding HasSubmeshes}">
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                  <TextBlock Classes="cardTitle" Grid.Column="0" Text="SUBMESHES" VerticalAlignment="Center" />
                  <ToggleButton Classes="vp" Grid.Column="1" Content="Auto" FontSize="10" Padding="6,1" Margin="0,0,4,0"
                                IsChecked="{Binding AutoSubmeshVisibility}"
                                ToolTip.Tip="AUTO: apply the game's visibility (skin bin initial-hide + the playing clip's show/hide lists). Off = manual control." />
                  <Button Classes="icon" Grid.Column="2" Content="All" FontSize="10" Command="{Binding ShowAllSubmeshesCommand}" />
                  <Button Classes="icon" Grid.Column="3" Content="None" FontSize="10" Command="{Binding HideAllSubmeshesCommand}" />
                </Grid>
                <TextBlock Text="Tick to show. Click a row to outline it and open its material."
                           FontSize="9" Foreground="{DynamicResource ReyTextDimBrush}" TextWrapping="Wrap" />
                <ListBox ItemsSource="{Binding Submeshes}" SelectedItem="{Binding SelectedSubmesh}"
                         Background="Transparent" BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SubmeshToggleViewModel">
                      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,1">
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible}" Padding="0" MinWidth="0"
                                  VerticalAlignment="Center" ToolTip.Tip="Show / hide this submesh" />
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                          <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding MaterialName}" FontSize="9" IsVisible="{Binding HasMaterial}"
                                     Foreground="{DynamicResource ReyAccentBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <!-- M703: a submesh with no material of its own can be given one, which is what
                             makes its shader changeable at all. -->
                        <Button Grid.Column="2" Classes="icon" Content="+ material" FontSize="9" Padding="6,1"
                                VerticalAlignment="Center" IsVisible="{Binding CanAddMaterial}"
                                Command="{Binding AddMaterialForSubmeshCommand}"
                                ToolTip.Tip="Author a material for this submesh, starting from its current texture, and select it - then its shader can be changed here" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Grid Grid.Column="2">
      <views:ViewportControl x:Name="PreviewViewport"
                             HighlightSubmeshes="{Binding HighlightedSubmeshes}"
                             IsVisible="{Binding !UseDx11Preview}"
                             Mesh="{Binding Mesh}"
                             Skeleton="{Binding Skeleton}"
                             ModelTextures="{Binding Textures}"
                             ModelSubmeshMaterials="{Binding Materials}"
                             ModelMaskTextures="{Binding MaskTextures}"
                             ModelGradientTextures="{Binding GradientTextures}"
                             ModelEmissiveTextures="{Binding EmissiveTextures}"
                             ModelMatCapTextures="{Binding MatCapTextures}"
                             ModelLightmapTextures="{Binding LightmapTextures}"
                             UseVertexLightmap="{Binding UseVertexLightmap}"
                             VertexLightmapScale="{Binding VertexLightmapScale}"
                             LegacyMap="{Binding IsLegacyMap}"
                             NvrFourBlend="{Binding NvrFourBlend}"
                             NvrVertexLight="{Binding NvrVertexLight}"
                             NvrBrightness="{Binding NvrBrightness}"
                             NvrSun="{Binding NvrSun}"
                             NvrUseMapSun="{Binding NvrUseMapSun}"
                             AnimationClip="{Binding CurrentAnimation}"
                             AnimationTime="{Binding AnimationTime}"
                             ParticlePlayback="{Binding Playback}"
                             ParticleReplayToken="{Binding ParticleReplayToken}"
                             ParticleRig="{Binding Rig}"
                             Skybox="{Binding Skybox}"
                             TargetDummyPosition="{Binding DummyCubePosition}"
                             PropMeshes="{Binding SceneProps}"
                             FocusPoint="{Binding FocusPoint}"
                             RangeRingLines="{Binding RangeRingLines}"
                             PlayPropAnimations="True"
                             GizmoPivot="{Binding DummyGizmoPivot}"
                             ShowBones="{Binding ShowBones}"
                             Wireframe="{Binding Wireframe}"
                             CullBackfaces="{Binding CullBackfaces}"
                             PreviewMode="{Binding PreviewMode}"
                             ModelSubmeshVisible="{Binding SubmeshVisible}"
                             ModelScale="{Binding ModelScale}"
                             ModelPosition="{Binding CharacterPosition}"
                             ModelYaw="{Binding RenderedCharacterYaw}"
                             BackgroundMesh="{Binding BackgroundMesh}"
                             BackgroundTextures="{Binding BackgroundTextures}"
                             BackgroundBlendTextures="{Binding BackgroundBlendTextures}"
                             BackgroundColor1Textures="{Binding BackgroundColor1Textures}"
                             BackgroundColor2Textures="{Binding BackgroundColor2Textures}"
                             BackgroundColor3Textures="{Binding BackgroundColor3Textures}"
                             BackgroundMaterials="{Binding BackgroundMaterials}"
                             BackgroundMaskTextures="{Binding BackgroundMaskTextures}"
                             BackgroundLightmapTextures="{Binding BackgroundLightmapTextures}"
                             BackgroundVisible="{Binding BackgroundVisible}"
                             BackgroundOffset="{Binding BackgroundOffset}"
                             BackgroundRotation="{Binding BackgroundRotation}"
                             BackgroundVertexLight="{Binding BackgroundVertexLight}"
                             BackgroundBrightness="{Binding BackgroundBrightness}"
                             BackgroundSun="{Binding BackgroundSun}"
                             BackgroundUseMapSun="{Binding BackgroundUseMapSun}"
                             ShowGrid="{Binding ShowGrid}"
                             DynamicLights="{Binding BackgroundLights}"
                             DynamicLightsEnabled="{Binding BackgroundLightsEnabled}"
                             DynamicLightIntensity="{Binding BackgroundLightIntensity}"
                             ShowLightMarkers="False" />
      <!-- M120: texture preview overlay - the window is the single preview surface for images too -->
      <Border Background="{DynamicResource ReyBgVeilBrush}" IsVisible="{Binding HasImagePreview}">
        <DockPanel Margin="14">
          <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Classes="tool" Content="✕ Close image" FontSize="11" Padding="8,3"
                    Command="{Binding CloseImagePreviewCommand}" />
            <TextBlock Text="{Binding ImagePreviewInfo}" FontSize="11" VerticalAlignment="Center"
                       Foreground="{DynamicResource ReyTextDimBrush}" />
          </DockPanel>
          <Border Background="{DynamicResource ReyPanelAltBrush}" CornerRadius="6" Padding="8" Margin="0,10,0,0">
            <Image Source="{Binding ImagePreview}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
          </Border>
        </DockPanel>
      </Border>
      <!-- M618: the D3D11 surface and the GL control are siblings that swap by visibility, the pattern
           the map viewport has used since M248. ViewportControl derives from OpenGlControlBase, so it IS
           the GL surface and cannot draw D3D itself. Stretch=Fill, not None: the frame is rendered at
           device pixels and wrapped in a 96-dpi bitmap, and None centre-crops that mismatch. -->
      <Image x:Name="Dx11Preview" Stretch="Fill"
             RenderOptions.BitmapInterpolationMode="None"
             IsVisible="{Binding UseDx11Preview}" />
      <Border x:Name="PreviewInput" Background="Transparent" IsVisible="{Binding !HasImagePreview}" />
      <TextBlock Text="LMB orbit · MMB pan · wheel zoom" FontSize="9" Opacity="0.35"
                 Margin="8,6" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
      </Grid>
      <GridSplitter Grid.Column="3" Background="{DynamicResource ReyBorderBrush}" ResizeDirection="Columns" />
      <Border Grid.Column="4" Background="{DynamicResource ReyPanelBrush}"
              BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="1,0,0,0">
        <TabControl SelectedIndex="{Binding PanelTab}" Padding="0" Margin="4,2,4,0">
          <TabItem FontSize="12" IsVisible="{Binding HasMaterialEditor}">
            <TabItem.Header><TextBlock Text="Material" FontSize="12" /></TabItem.Header>
            <DockPanel>
              <!-- M647: the state switch. A champion's materials do not draw what their paramValues say -
                   Locke authors VCDissolve_Value 1.23 and drives it from an IsDead lerp to -0.8 while
                   alive - so the preview needs to be told which situation to draw. The switches are the
                   skin's OWN driver conditions, not a hardcoded list, and the card hides itself for a
                   skin whose materials carry no dynamicMaterial (619 of 690 skin bins). -->
              <Border Classes="card" DockPanel.Dock="Top" Margin="10,10,10,2" IsVisible="{Binding HasConditions}">
                <StackPanel Spacing="5">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="cardTitle" Grid.Column="0" Text="STATE" VerticalAlignment="Center"
                               ToolTip.Tip="What situation to draw this skin in. Every condition comes from the skin's own material drivers; each one that is on is applied to every material of the skin that asks about it." />
                    <Button Grid.Column="1" Classes="tool" Content="↺ Alive" FontSize="10" Padding="6,1"
                            Command="{Binding ResetStateCommand}" IsEnabled="{Binding !IsRestState}"
                            ToolTip.Tip="Back to rest - alive, unbuffed, idle." />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Conditions}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CharacterConditionViewModel">
                        <ToggleButton Classes="vp" Content="{Binding Label}" IsChecked="{Binding IsOn}"
                                      FontSize="10" Margin="0,0,4,4" ToolTip.Tip="{Binding Tip}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <!-- Riot's drivers are lerps with their own durations, so a state is a ramp rather than
                       one picture: Locke's five materials dissolve over 6, 8 and 10 s, and held to the end
                       the dissolve has removed him entirely. Flipping a switch parks this at 40% of that
                       condition's ramp; from there the slider walks the whole of it. -->
                  <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding !IsRestState}">
                    <TextBlock Grid.Column="0" Text="Since" FontSize="10" VerticalAlignment="Center"
                               Foreground="{DynamicResource ReyTextDimBrush}" Margin="0,0,6,0"
                               ToolTip.Tip="How long the switched-on conditions have held. Each driver walks its own turn-on time, so this scrubs the transition - a death dissolve is only visible part-way through it." />
                    <Slider Grid.Column="1" Minimum="0" Maximum="{Binding StateSecondsMax}"
                            Value="{Binding StateSeconds}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding StateSeconds, StringFormat='{}{0:0.##} s'}"
                               FontSize="10" VerticalAlignment="Center" MinWidth="42"
                               HorizontalAlignment="Right" Foreground="{DynamicResource ReyTextDimBrush}" />
                  </Grid>
                  <TextBlock Text="{Binding StateSummary}" FontSize="9" TextWrapping="Wrap"
                             Foreground="{DynamicResource ReyTextDimBrush}" />
                  <TextBlock Text="The GL preview approximates these materials and ignores the state - switch the viewport to D3D11 to see it."
                             FontSize="9" TextWrapping="Wrap" Foreground="{DynamicResource ReyAccent2Brush}"
                             IsVisible="{Binding !UseDx11Preview}" />
                </StackPanel>
              </Border>
              <views:MaterialEditorView DataContext="{Binding MaterialEditor}" />
            </DockPanel>
          </TabItem>
          <TabItem FontSize="12">
            <TabItem.Header><TextBlock Text="Animate" FontSize="12" /></TabItem.Header>
            <ScrollViewer>
              <StackPanel Margin="10" Spacing="8">
                  <!-- M612: ACTIONS - what the character DOES. Q/W/E/R come from the champion record in slot
                       order; the clip for each comes from Riot's SpellN naming. Playing one prefers the M116
                       VFX composite for the same slot, and falls back to the clip, whose own particle and sound
                       events still fire. -->
                  <Border Classes="card" IsVisible="{Binding HasActions}">
                    <StackPanel Spacing="5">
                      <TextBlock Classes="cardTitle" Text="ACTIONS" />
                      <ListBox ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                               MaxHeight="230" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:CharacterActionRowViewModel">
                            <Grid ColumnDefinitions="30,*" Margin="0,1">
                              <TextBlock Grid.Column="0" Text="{Binding Group}" FontSize="8" VerticalAlignment="Center"
                                         Opacity="0.45" TextTrimming="CharacterEllipsis" />
                              <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Label}" FontSize="11"
                                           Opacity="{Binding HasClip, Converter={x:Static views:M612Converters.ClipOpacity}}" />
                                <TextBlock Text="{Binding Detail}" FontSize="9" Opacity="0.5" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Classes="tool" Content="↺ Replay" Command="{Binding ReplayActionCommand}" />
                        <Button Classes="tool" Content="■ Stop" Command="{Binding StopEventCommand}" />
                      </StackPanel>
                      <TextBlock Text="{Binding ActionSummary}" FontSize="9"
                                 Foreground="{DynamicResource ReyTextDimBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                  <Border Classes="card">
                    <StackPanel Spacing="6">
                      <TextBlock Classes="cardTitle" Text="ANIMATIONS" />
                      <TextBlock Text="Pure .anm playback — no VFX or sounds. Use EVENTS below for the full sequence."
                                 FontSize="9" Foreground="{DynamicResource ReyTextDimBrush}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Animation.SkeletonStatus}" Foreground="{DynamicResource ReyAccentBrush}" FontSize="11" />
                      <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Select animation…"
                                ItemsSource="{Binding Animation.Animations}"
                                SelectedItem="{Binding Animation.SelectedAnimation, Mode=TwoWay}"
                                IsVisible="{Binding Animation.HasAnimations}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <!-- M115: grouped by skin — the loaded skin's clips glow green, others carry a badge -->
                            <Border CornerRadius="3" Padding="4,1" Margin="-2,0"
                                    Background="{Binding IsCurrentSkin, Converter={x:Static views:M115Converters.CurrentSkinBrush}}">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{DynamicResource ReyPanelAltBrush}" CornerRadius="3"
                                        Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding SkinGroup}" FontSize="8" Foreground="{DynamicResource ReyTextDimBrush}" />
                                </Border>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <!-- M84 fix: the Loop checkbox overflowed the 250px panel and was cut off — compact ⟳ toggle -->
                      <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding Animation.HasClip}">
                        <Button Classes="tool" Content="◀|" Command="{Binding Animation.StepBackCommand}" />
                        <Button Classes="tool" Content="Play / Pause" Command="{Binding Animation.TogglePlayCommand}" />
                        <Button Classes="tool" Content="|▶" Command="{Binding Animation.StepForwardCommand}" />
                        <ToggleButton Classes="vp" Content="⟳" IsChecked="{Binding Animation.Loop}" ToolTip.Tip="Loop playback" />
                      </StackPanel>
                      <Slider Minimum="0" Maximum="{Binding Animation.Duration}" Value="{Binding Animation.Time, Mode=TwoWay}"
                              IsVisible="{Binding Animation.HasClip}" />
                      <TextBlock Text="{Binding Animation.TimeText}" Foreground="{DynamicResource ReyTextDimBrush}"
                                 FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" IsVisible="{Binding Animation.HasClip}" />
                      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Animation.HasClip}">
                        <TextBlock Text="Speed" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="11" VerticalAlignment="Center" />
                        <Slider Minimum="0.1" Maximum="2" Value="{Binding Animation.Speed, Mode=TwoWay}" Width="110" />
                        <TextBlock Text="{Binding Animation.Speed, StringFormat='{}{0:0.0}x'}" FontSize="11" VerticalAlignment="Center" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <!-- M116: EVENTS — complete sequences: animation + VFX + SFX, with caster systems on the
                       champion, _tar systems on the target dummy and missiles travelling between. -->
                  <Border Classes="card" IsVisible="{Binding HasEvents}">
                    <StackPanel Spacing="5">
                      <TextBlock Classes="cardTitle" Text="EVENTS" />
                      <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Play an event…"
                                ItemsSource="{Binding ChampionEvents}"
                                SelectedItem="{Binding SelectedEvent, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <StackPanel>
                              <TextBlock Text="{Binding Name}" FontSize="11" />
                              <TextBlock Text="{Binding Description}" FontSize="9" Opacity="0.55" />
                            </StackPanel>
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Classes="tool" Content="↺ Replay" Command="{Binding ReplayEventCommand}" />
                        <Button Classes="tool" Content="■ Stop" Command="{Binding StopEventCommand}" />
                      </StackPanel>
                      <TextBlock Text="Spell composites are assembled from Riot's VFX naming — timing between caster, missile and target is approximate."
                                 FontSize="9" Foreground="{DynamicResource ReyTextDimBrush}" TextWrapping="Wrap" />
                      <!-- M663: the composite carries no bone, because Riot's spell scripts are compiled
                           out of the game files. A clip that authors its own particle event still uses the
                           bone it names; this only decides where a name-assembled caster effect rides. -->
                      <TextBlock Text="Caster bone" FontSize="9" Foreground="{DynamicResource ReyTextDimBrush}" Margin="0,3,0,0" />
                      <ComboBox HorizontalAlignment="Stretch" FontSize="10"
                                ItemsSource="{Binding CasterBoneOptions}"
                                SelectedItem="{Binding SelectedCasterBone, Mode=TwoWay}"
                                IsVisible="{Binding HasCasterBones}" />
                      <TextBlock Text="Composite effects have no authored bone — the spell script that binds them ships compiled. The default is Riot's own attachment locator; pick the real one to put an effect on a hand or a weapon."
                                 FontSize="9" Foreground="{DynamicResource ReyTextDimBrush}" TextWrapping="Wrap"
                                 IsVisible="{Binding HasCasterBones}" />
                    </StackPanel>
                  </Border>
                  <!-- M95c: voice lines — the skin's authored Play_vo_ events; picking one plays it -->
                  <Border Classes="card" IsVisible="{Binding HasVoiceEvents}">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="cardTitle" Grid.Column="0" Text="VOICE LINES" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="tool" Content="▶" FontSize="10" Padding="8,1"
                                Command="{Binding ReplayVoiceEventCommand}" ToolTip.Tip="Replay the selected line" />
                      </Grid>
                      <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Pick a voice line…" FontSize="11"
                                ItemsSource="{Binding VoiceEvents}" SelectedItem="{Binding SelectedVoiceEvent, Mode=TwoWay}" />
                    </StackPanel>
                  </Border>
                  <Border Classes="card" IsVisible="{Binding HasVfx}">
                    <StackPanel Spacing="6">
                      <TextBlock Classes="cardTitle" Text="CHAMPION VFX" />
                      <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Play effect…"
                                ItemsSource="{Binding VfxSystems}"
                                SelectedItem="{Binding SelectedVfx, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate><TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <Button Classes="tool" Content="⏹ Stop VFX" Command="{Binding StopVfxCommand}" HorizontalAlignment="Left" />

                      <!-- M726: the skin's own idleParticlesEffects - the ones the game plays for as long
                           as the character exists, riding their bones. They play UNDER everything else, so
                           the tick is how you look at one effect on its own. -->
                      <CheckBox Content="Idle effects" IsChecked="{Binding IdleEffectsEnabled}" FontSize="11"
                                IsVisible="{Binding IdleEffectCount}"
                                ToolTip.Tip="The skin's idleParticlesEffects — always-on VFX attached to named bones, like Lux's two wand glows." />
                      <TextBlock Text="{Binding IdleEffectCount, StringFormat='{}{0} idle effect(s) on bones'}"
                                 IsVisible="{Binding IdleEffectCount}"
                                 Foreground="{DynamicResource ReyTextDimBrush}" FontSize="10" />
                      <!-- M715: the rig, for the manual pick only. A cast composite and a clip event
                           already move better than a rig can, so the viewport ignores it for both. -->
                      <StackPanel Spacing="5" IsVisible="{Binding SelectedVfx, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="RIG" FontSize="10" FontWeight="Bold" Margin="0,4,0,0"
                                   Foreground="{DynamicResource ReyTextDimBrush}" />
                        <Border Background="{DynamicResource ReyPanelAltBrush}" CornerRadius="4" Padding="2">
                          <UniformGrid Columns="4">
                            <ToggleButton Classes="vp" Content="Still" IsChecked="{Binding IsRigStill}"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                          ToolTip.Tip="It stays where the pick put it." />
                            <ToggleButton Classes="vp" Content="Burst" IsChecked="{Binding IsRigBurst}"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                          ToolTip.Tip="Still, but the whole run starts over as soon as it ends." />
                            <ToggleButton Classes="vp" Content="Missile" IsChecked="{Binding IsRigMissile}"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                          ToolTip.Tip="It flies from where it is anchored and stops emitting where it lands." />
                            <ToggleButton Classes="vp" Content="Trail" IsChecked="{Binding IsRigTrail}"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                          ToolTip.Tip="It circles, so a trail or a ribbon has a path to lay itself along." />
                          </UniformGrid>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                          <Border Classes="badge" IsVisible="{Binding VfxRoleIsAuthored}">
                            <TextBlock Text="FROM THE SPELL RECORD" FontSize="8" />
                          </Border>
                          <Border Classes="badge"
                                  IsVisible="{Binding VfxRoleIsAuthored, Converter={x:Static BoolConverters.Not}}">
                            <TextBlock Text="GUESSED FROM THE NAME" FontSize="8" />
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding RigNote}" FontSize="9" Opacity="0.5" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding RigSpeed, StringFormat='Speed   {0:0} u/s'}" FontSize="10"
                                   Opacity="0.7" IsVisible="{Binding IsRigMissile}" />
                        <Slider Minimum="100" Maximum="6000" Value="{Binding RigSpeed}"
                                IsVisible="{Binding IsRigMissile}" />
                        <TextBlock Text="{Binding RigHeight, StringFormat='Height   {0:0} u'}" FontSize="10" Opacity="0.7" />
                        <Slider Minimum="0" Maximum="600" Value="{Binding RigHeight}" />
                        <StackPanel Orientation="Horizontal" Spacing="5">
                          <ToggleButton Classes="vp" Content="Replay" IsChecked="{Binding RigReplay}" />
                          <ToggleButton Classes="vp" Content="Stop mid-run" IsChecked="{Binding RigStopMidRun}" />
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>
                  </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem FontSize="12">
            <TabItem.Header><TextBlock Text="Play" FontSize="12" /></TabItem.Header>
            <ScrollViewer>
              <StackPanel Margin="10" Spacing="8">
                  <!-- M613: control mode - right-click to move, right-click the dummy to attack, QWER to cast. -->
                  <Border Classes="card" IsVisible="{Binding HasActions}">
                    <StackPanel Spacing="5">
                      <TextBlock Classes="cardTitle" Text="CONTROL" />
                      <CheckBox Content="Drive the character" IsChecked="{Binding ControlMode}" FontSize="11" />
                      <TextBlock Text="{Binding ControlStatus}" FontSize="9" TextWrapping="Wrap"
                                 Foreground="{DynamicResource ReyAccentBrush}" />
                      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="3"
                            IsVisible="{Binding ControlMode}">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Speed" FontSize="10" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ReyTextDimBrush}" />
                        <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding MoveSpeed}" FontSize="10"
                                       Minimum="10" Maximum="2000" Increment="10" FormatString="0" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Range" FontSize="10" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ReyTextDimBrush}" />
                        <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding AttackRange}" FontSize="10"
                                       Minimum="25" Maximum="2000" Increment="25" FormatString="0" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Att/s" FontSize="10" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ReyTextDimBrush}" />
                        <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding AttacksPerSecond}" FontSize="10"
                                       Minimum="0.1" Maximum="5" Increment="0.05" FormatString="0.00" />
                      </Grid>
                      <Button Classes="tool" Content="Reset position (S)" Command="{Binding ResetCharacterCommand}"
                              IsVisible="{Binding ControlMode}" />
                      <TextBlock IsVisible="{Binding ControlMode}" FontSize="9" TextWrapping="Wrap"
                                 Foreground="{DynamicResource ReyTextDimBrush}"
                                 Text="Speed, range and attack speed are per-champion values the editor does not read - these are editable defaults, not this champion's real numbers." />
                    </StackPanel>
                  </Border>
                  <!-- M636: the ARENA - a shipped map as a floor to play on, with its navgrid driving movement -->
                  <Border Classes="card" IsVisible="{Binding HasArenaMaps}">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="cardTitle" Grid.Column="0" Text="ARENA" VerticalAlignment="Center" />
                        <ToggleButton Grid.Column="1" Classes="vp" Content="Follow" FontSize="10" Padding="6,1"
                                      IsChecked="{Binding ArenaFollowCamera}" ToolTip.Tip="Keep the camera on the character while it moves" />
                      </Grid>
                      <TextBlock Text="Play the character on a shipped map. Movement follows the map's navigation grid."
                                 Foreground="{DynamicResource ReyTextDimBrush}" FontSize="11" TextWrapping="Wrap" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <ComboBox Width="120" ItemsSource="{Binding ArenaMaps}" SelectedItem="{Binding SelectedArenaMap}" FontSize="11" />
                        <Button Classes="tool" Content="Load" Command="{Binding LoadArenaCommand}" IsEnabled="{Binding !ArenaLoading}" />
                        <Button Classes="tool" Content="Unload" Command="{Binding UnloadArenaCommand}" IsVisible="{Binding HasArena}" />
                      </StackPanel>
                      <TextBlock Text="{Binding ArenaStatus}" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="11" TextWrapping="Wrap" />
                      <StackPanel DataContext="{Binding ArenaViewport}" Spacing="4">
                        <CheckBox Content="Props" IsChecked="{Binding ShowPropMeshes}" />
                        <CheckBox Content="Prop animations" IsChecked="{Binding PlayPropAnimations}" />
                        <CheckBox Content="Map particles" IsChecked="{Binding PlayAllParticles}" />
                        <CheckBox Content="Fog" IsChecked="{Binding ShowFog}" />
                        <CheckBox Content="Render-region meshes" IsChecked="{Binding RenderRegionsEnabled}" />
                        <ComboBox ItemsSource="{Binding SkyboxOptions}" SelectedIndex="{Binding SelectedSkyboxIndex}" />
                        <TextBlock Classes="cardTitle" Text="VISIBILITY LAYERS" IsVisible="{Binding HasVisibilityAxes}" />
                        <ItemsControl ItemsSource="{Binding VisibilityAxes}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="9" Foreground="{DynamicResource ReyTextDimBrush}" />
                                <ComboBox ItemsSource="{Binding Options}" SelectedIndex="{Binding SelectedIndex}" FontSize="10" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding MapEvents}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn}" FontSize="10" /></DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding BoardStageSelectors}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate><ComboBox ItemsSource="{Binding Options}" SelectedIndex="{Binding SelectedIndex}" FontSize="10" /></DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                      <TextBlock Text="{Binding StatsSummary, StringFormat='Champion: {0}'}" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="11" TextWrapping="Wrap" />
                      <!-- M639: pin a slot's cast-range ring on the ground; a cast shows its own ring briefly anyway -->
                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                        <TextBlock Text="Range" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="11" VerticalAlignment="Center" Width="42" />
                        <ToggleButton Classes="vp" Content="Q" FontSize="10" Padding="7,1" IsChecked="{Binding IsRangeRingQ, Mode=OneWay}"
                                      Command="{Binding ToggleRangeRingCommand}" CommandParameter="Q" ToolTip.Tip="Show Q's cast range" />
                        <ToggleButton Classes="vp" Content="W" FontSize="10" Padding="7,1" IsChecked="{Binding IsRangeRingW, Mode=OneWay}"
                                      Command="{Binding ToggleRangeRingCommand}" CommandParameter="W" ToolTip.Tip="Show W's cast range" />
                        <ToggleButton Classes="vp" Content="E" FontSize="10" Padding="7,1" IsChecked="{Binding IsRangeRingE, Mode=OneWay}"
                                      Command="{Binding ToggleRangeRingCommand}" CommandParameter="E" ToolTip.Tip="Show E's cast range" />
                        <ToggleButton Classes="vp" Content="R" FontSize="10" Padding="7,1" IsChecked="{Binding IsRangeRingR, Mode=OneWay}"
                                      Command="{Binding ToggleRangeRingCommand}" CommandParameter="R" ToolTip.Tip="Show R's cast range" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <!-- M114: target dummy — position + behaviour -->
                  <Border Classes="card" IsVisible="{Binding TargetDummyEnabled}">
                    <StackPanel Spacing="4">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="cardTitle" Grid.Column="0" Text="TARGET DUMMY" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="tool" Content="Reset" FontSize="10" Padding="6,1"
                                Command="{Binding ResetDummyCommand}" ToolTip.Tip="Back to 350 units in front" />
                      </Grid>
                      <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" >
                        <TextBlock Grid.Column="0" Text="X" FontSize="10" VerticalAlignment="Center" Margin="0,0,3,0" Foreground="{DynamicResource ReyAxisXBrush}" />
                        <TextBox Grid.Column="1" Text="{Binding DummyX, StringFormat='{}{0:0.#}'}" FontSize="10" Padding="3,1" />
                        <TextBlock Grid.Column="2" Text="Y" FontSize="10" VerticalAlignment="Center" Margin="5,0,3,0" Foreground="{DynamicResource ReyAxisYBrush}" />
                        <TextBox Grid.Column="3" Text="{Binding DummyY, StringFormat='{}{0:0.#}'}" FontSize="10" Padding="3,1" />
                        <TextBlock Grid.Column="4" Text="Z" FontSize="10" VerticalAlignment="Center" Margin="5,0,3,0" Foreground="{DynamicResource ReyAxisZBrush}" />
                        <TextBox Grid.Column="5" Text="{Binding DummyZ, StringFormat='{}{0:0.#}'}" FontSize="10" Padding="3,1" />
                      </Grid>
                      <CheckBox Content="Play selected VFX at dummy" IsChecked="{Binding PlaySelectedAtDummy}" FontSize="10"
                                ToolTip.Tip="Force the manually picked system onto the dummy. Systems named *_tar* go there automatically." />
                      <TextBlock Text="Drag the gizmo arrows in the viewport to move it. Target-bound systems (*_tar*) land here automatically."
                                 FontSize="9" Foreground="{DynamicResource ReyTextDimBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem FontSize="12">
            <TabItem.Header><TextBlock Text="Scene" FontSize="12" /></TabItem.Header>
            <ScrollViewer>
              <StackPanel Margin="10" Spacing="8">
                  <!-- M90: model scale — size the champion against the map backdrop -->
                  <Border Classes="card">
                    <StackPanel Spacing="4">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="cardTitle" Grid.Column="0" Text="MODEL" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="tool" Content="1×" FontSize="10" Padding="6,1"
                                Command="{Binding ResetModelScaleCommand}" ToolTip.Tip="Reset scale" />
                      </Grid>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Scale" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="11" VerticalAlignment="Center" Width="42" />
                        <Slider Minimum="0.1" Maximum="5" Value="{Binding ModelScale, Mode=TwoWay}" Width="120" />
                        <TextBlock Text="{Binding ModelScale, StringFormat='{}{0:0.00}×'}" FontSize="11" VerticalAlignment="Center" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <!-- M618: which renderer draws this window. -->
                  <Border Classes="card">
                    <StackPanel Spacing="5">
                      <TextBlock Classes="cardTitle" Text="RENDERER" />
                      <CheckBox Content="Direct3D 11" IsChecked="{Binding UseDx11Preview}" FontSize="11"
                                ToolTip.Tip="Draw this character with Riot's own compiled shaders instead of the OpenGL approximation." />
                      <TextBlock Text="{Binding Dx11Status}" FontSize="9" TextWrapping="Wrap"
                                 Foreground="{DynamicResource ReyTextDimBrush}" />
                      <!-- M758: tangents for PBR skins, LTK Manager's bake byte for byte -->
                      <Button Content="Bake tangents" Command="{Binding BakeSkinTangentsCommand}" FontSize="11"
                              HorizontalAlignment="Left" Margin="0,4,0,0"
                              ToolTip.Tip="Write MikkTSpace tangents into this skin's .skn, for PBR skins with a normal map and RMA textures. The mesh is written into your project; the file is byte-identical to LTK Manager's bake. Bake normal maps in MikkTSpace against this same mesh." />
                    </StackPanel>
                  </Border>
                    <!-- M122: skybox picker (same catalogue as the map viewport, independent pick) -->
                  <Border Classes="card" IsVisible="{Binding HasSkyboxOptions}">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="cardTitle" Text="SKYBOX" />
                      <ComboBox HorizontalAlignment="Stretch" FontSize="10" MaxDropDownHeight="420"
                                ItemsSource="{Binding SkyboxOptions}" SelectedIndex="{Binding SelectedSkyboxIndex}" />
                      <TextBlock Text="☁ cubemap · ⛰ authored dome · 🖼 sky texture. 'Custom image…' loads your own (png/jpg/tex/dds)."
                                 FontSize="9" Foreground="{DynamicResource ReyTextDimBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                  <!-- M89: NVR map backdrop tuning — move the map, boost its lights, tune baked ground shading -->
                  <Border Classes="card" IsVisible="{Binding HasBackground}">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="cardTitle" Grid.Column="0" Text="MAP BACKDROP" VerticalAlignment="Center" />
                        <ToggleButton Grid.Column="1" Classes="vp" Content="Show" FontSize="10" Padding="6,1"
                                      IsChecked="{Binding BackgroundVisible}" />
                      </Grid>
                      <TextBlock Text="{Binding BackgroundMapName, StringFormat='Map: {0}'}"
                                 Foreground="{DynamicResource ReyTextDimBrush}" FontSize="11" />

                      <TextBlock Text="Move map (world units)" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="11" Margin="0,2,0,0" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="X" VerticalAlignment="Center" FontSize="11" Width="12" />
                        <NumericUpDown Width="182" Value="{Binding BackgroundOffsetX}" Increment="50" FormatString="0" FontSize="11" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Y" VerticalAlignment="Center" FontSize="11" Width="12" />
                        <NumericUpDown Width="182" Value="{Binding BackgroundOffsetY}" Increment="20" FormatString="0" FontSize="11" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Z" VerticalAlignment="Center" FontSize="11" Width="12" />
                        <NumericUpDown Width="182" Value="{Binding BackgroundOffsetZ}" Increment="50" FormatString="0" FontSize="11" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                        <TextBlock Text="Rotate" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="11" VerticalAlignment="Center" Width="42" />
                        <Slider Minimum="0" Maximum="360" Value="{Binding BackgroundRotation, Mode=TwoWay}" Width="120" />
                        <TextBlock Text="{Binding BackgroundRotation, StringFormat='{}{0:0}°'}" FontSize="11" VerticalAlignment="Center" />
                      </StackPanel>
                      <Button Classes="tool" Content="Reset position" Command="{Binding ResetBackgroundOffsetCommand}" HorizontalAlignment="Stretch"
                              ToolTip.Tip="Back to this map's own default placement. Dominion has a hand-tuned hero-shot framing; every other map sits where the loader anchored its spawn." />

                      <!-- M725: the D3D11 host has no NVR material model, so it draws the backdrop as
                           diffuse-only geometry. It used to draw nothing at all while these controls stayed
                           live, which reads as the backdrop being broken rather than being simpler. -->
                      <TextBlock Text="Direct3D 11 draws the backdrop diffuse-only — no baked light, blend layers or Light.dat."
                                 IsVisible="{Binding BackdropIsDiffuseOnly}" TextWrapping="Wrap"
                                 Foreground="{DynamicResource ReyTextDimBrush}" FontSize="10" Margin="0,2,0,0" />

                      <!-- M729: the level's authored sun and ambient, and where they came from. The packs ship without
                           terrain.inibin, so for Dominion this names ReyEngine's built-in copy of the client's file. -->
                      <TextBlock Text="{Binding BackgroundSunSource}" IsVisible="{Binding HasBackgroundSun}" TextWrapping="Wrap"
                                 Foreground="{DynamicResource ReyAccent2Brush}" FontSize="10" Margin="0,4,0,0" />
                      <CheckBox Content="Map's sun / ambient" IsChecked="{Binding BackgroundUseMapSun}" FontSize="11"
                                IsVisible="{Binding HasBackgroundSun}"
                                ToolTip.Tip="Light the map the way the game's own environment shader does: its authored sun direction and colour (doubled, as LIT_VS does), its ambient, and the baked vertex light below. Off falls back to a neutral reference sun." />

                      <!-- M725: the enable tick the card never had. M729: both maps bake these pools - Twisted Treeline
                           into its composite atlas, Dominion into its vertex colours - so it starts OFF on both. -->
                      <CheckBox Content="Light.dat point lights" IsChecked="{Binding BackgroundLightsEnabled}" FontSize="11"
                                Margin="0,4,0,0"
                                ToolTip.Tip="Evaluate the map's Light.dat torches and braziers at runtime. Off by default: the game bakes these pools into the map (Twisted Treeline's composite atlas, Dominion's vertex colours), so turning this on counts every light twice. Every light draws when it is on." />
                      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding BackgroundLightsEnabled}">
                        <TextBlock Text="Light" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="11" VerticalAlignment="Center" Width="42" />
                        <Slider Minimum="0" Maximum="8" Value="{Binding BackgroundLightIntensity, Mode=TwoWay}" Width="120" />
                        <TextBlock Text="{Binding BackgroundLightIntensity, StringFormat='{}{0:0.0}'}" FontSize="11" VerticalAlignment="Center" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6"
                                  ToolTip.Tip="Scales the sun and the ambient together. 0.55 is the map's own level.">
                        <TextBlock Text="Bright" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="11" VerticalAlignment="Center" Width="42" />
                        <Slider Minimum="0" Maximum="2" Value="{Binding BackgroundBrightness, Mode=TwoWay}" Width="120" />
                        <TextBlock Text="{Binding BackgroundBrightness, StringFormat='{}{0:0.00}'}" FontSize="11" VerticalAlignment="Center" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6"
                                  ToolTip.Tip="Baked vertex light - the torch pools the map bakes into its vertex colours. The game multiplies them by 4.">
                        <TextBlock Text="Ground" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="11" VerticalAlignment="Center" Width="42" />
                        <Slider Minimum="0" Maximum="8" Value="{Binding BackgroundVertexLight, Mode=TwoWay}" Width="120" />
                        <TextBlock Text="{Binding BackgroundVertexLight, StringFormat='{}{0:0.0}'}" FontSize="11" VerticalAlignment="Center" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <!-- M148: legacy (NVR) map render settings — only shown when the subject IS a map. Old levels
                       split into two ground models and the right one is picked on load; these expose the knobs so
                       any map can be tuned by eye. -->
                  <Border Classes="card" IsVisible="{Binding IsLegacyMap}">
                    <StackPanel Spacing="5">
                      <TextBlock Classes="cardTitle" Text="NVR MAP" />
                      <TextBlock FontSize="10" Foreground="{DynamicResource ReyTextDimBrush}" TextWrapping="Wrap"
                                 Text="Height-blend ground (baked composite atlas + baked vertex lighting)."
                                 IsVisible="{Binding NvrHeightBlend}" />
                      <TextBlock FontSize="10" Foreground="{DynamicResource ReyTextDimBrush}" TextWrapping="Wrap"
                                 Text="Mask-blend ground (four-blend BLEND_MAP) lit by a flat sun/sky."
                                 IsVisible="{Binding !NvrHeightBlend}" />

                      <TextBlock Text="{Binding NvrSunSource}" FontSize="10" TextWrapping="Wrap"
                                 Foreground="{DynamicResource ReyAccent2Brush}" />
                      <CheckBox Content="Use map's sun / ambient" IsChecked="{Binding NvrUseMapSun}" FontSize="11"
                                IsVisible="{Binding HasNvrSun}"
                                ToolTip.Tip="Light the map with the sun direction and sun/ambient colours it actually shipped (terrain.inibin on newer levels, sun.ini on older ones). Off falls back to a flat neutral sun/sky." />
                      <CheckBox Content="Four-blend ground" IsChecked="{Binding NvrFourBlend}" FontSize="11"
                                ToolTip.Tip="Blend the ground's 4 colour maps through its BLEND_MAP (CREATE_GROUND_MOSAIC_FOUR_BLEND). Off shows only the base tile — useful for checking the raw layer." />
                      <CheckBox Content="Baked vertex lighting" IsChecked="{Binding UseVertexLightmap}" FontSize="11"
                                ToolTip.Tip="Use each mesh's PrimaryColor AS its lightmap. Correct for height-blend maps (Twisted Treeline), whose statics carry real baked night lighting. Wrong for maps whose vertex colours are near-black mask/AO data (Dominion) — they go black." />

                      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding UseVertexLightmap}">
                        <TextBlock Text="Baked" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="11" VerticalAlignment="Center" Width="46" />
                        <Slider Minimum="0" Maximum="6" Value="{Binding VertexLightmapScale, Mode=TwoWay}" Width="110" />
                        <TextBlock Text="{Binding VertexLightmapScale, StringFormat='{}{0:0.0}'}" FontSize="11" VerticalAlignment="Center" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !UseVertexLightmap}">
                        <TextBlock Text="Bright" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="11" VerticalAlignment="Center" Width="46"
                                   ToolTip.Tip="Flat sun/sky level for mask-blend and plain maps." />
                        <Slider Minimum="0" Maximum="2" Value="{Binding NvrBrightness, Mode=TwoWay}" Width="110" />
                        <TextBlock Text="{Binding NvrBrightness, StringFormat='{}{0:0.00}'}" FontSize="11" VerticalAlignment="Center" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !UseVertexLightmap}">
                        <TextBlock Text="Ground" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="11" VerticalAlignment="Center" Width="46"
                                   ToolTip.Tip="Add the mesh's baked vertex colour on top (NVR paints ground shading/AO there). 0 = off." />
                        <Slider Minimum="0" Maximum="6" Value="{Binding NvrVertexLight, Mode=TwoWay}" Width="110" />
                        <TextBlock Text="{Binding NvrVertexLight, StringFormat='{}{0:0.0}'}" FontSize="11" VerticalAlignment="Center" />
                      </StackPanel>

                      <CheckBox Content="Light.dat point lights" IsChecked="{Binding BackgroundLightsEnabled}" FontSize="11"
                                ToolTip.Tip="Render the map's own Light.dat torches/braziers. Off by default on maps whose lighting is already baked in, where they would double up." />
                      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding BackgroundLightsEnabled}">
                        <TextBlock Text="Lights" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="11" VerticalAlignment="Center" Width="46" />
                        <Slider Minimum="0" Maximum="16" Value="{Binding BackgroundLightIntensity, Mode=TwoWay}" Width="110" />
                        <TextBlock Text="{Binding BackgroundLightIntensity, StringFormat='{}{0:0.0}'}" FontSize="11" VerticalAlignment="Center" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <!-- M812: the Chroma Studio starts here, read-only. Everything colour-bearing the open skin or chroma
               draws, Body and Effects, each item marked shared or unshared with the champion's other skins. The scan
               runs when the button is pressed - opening a skin reads none of this. The two lists virtualise: an
               inventory runs to thousands of rows, so they are not inside a ScrollViewer. -->
          <TabItem FontSize="12" IsVisible="{Binding HasChromaCard}">
            <TabItem.Header><TextBlock Text="Chroma" FontSize="12" /></TabItem.Header>
            <Border Classes="card" Margin="10">
              <!-- M824: the whole tab scrolls as one: the BODY RECOLOUR section and the M812 inventory below it each keep their own height
                   (the two inventory lists have a fixed one and scroll inside it), so neither squeezes the other at any window height. -->
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <Grid RowDefinitions="Auto,Auto" RowSpacing="8" Margin="0,0,6,0">
              <!-- M824: BODY RECOLOUR. One colour transform over the body textures the list switches on, drawn live on the character
                   while a slider moves (from the original texels, never compounding), written into the project by Apply & Save or
                   Ctrl+S. -->
              <Border Grid.Row="0">
                <StackPanel Spacing="4">
                  <StackPanel.Styles>
                    <!-- the Fluent slider template is ~50 px tall (tick rows above and below the track); six of them plus the rest
                         would push the texture list off the card. A negative margin takes the empty rows back without clipping the thumb. -->
                    <Style Selector="Slider">
                      <Setter Property="Margin" Value="0,-10" />
                    </Style>
                  </StackPanel.Styles>
                  <TextBlock Classes="cardTitle" Text="BODY RECOLOUR"
                             ToolTip.Tip="Recolour the body textures and the colour parameters (TintColor and its like) of this skin with one transform: hue, saturation, brightness, colourise, a hue range and grey protection. The character shows it live; Apply and Save (or Ctrl+S) writes the textures and the skin bin into the project from Riot's untouched originals, so Build Package and .fantome ship them." />
                  <TextBlock Text="{Binding ChromaRecolourStatus}" FontSize="10" TextWrapping="Wrap"
                             Foreground="{DynamicResource ReyAccentBrush}" />
                  <TextBlock Text="Press Scan colours to list the body textures and colour parameters this recolour can act on." FontSize="10" TextWrapping="Wrap"
                             Foreground="{DynamicResource ReyTextDimBrush}" IsVisible="{Binding !HasChromaRecolourControls}" />
                  <StackPanel Spacing="4" IsVisible="{Binding HasChromaRecolourControls}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button Classes="tool" Content="Apply &amp; Save" FontSize="11" Padding="8,2" Command="{Binding ApplyChromaRecolourCommand}"
                              ToolTip.Tip="Write the recoloured textures into the project (re-derived from Riot's originals) and record the sliders in the project file. Ctrl+S does the same." />
                      <Button Classes="tool" Content="Reset sliders" FontSize="11" Padding="8,2" Command="{Binding ResetChromaSlidersCommand}"
                              ToolTip.Tip="Put every slider back to no change. Nothing is written until Apply and Save." />
                      <Button Classes="tool" Content="Revert saved" FontSize="11" Padding="8,2" Command="{Binding RevertChromaRecolourCommand}"
                              ToolTip.Tip="Put this skin's saved recolour back to Riot's original textures and forget it." />
                    </StackPanel>
                    <TextBlock Text="{Binding ChromaShareWarning}" FontSize="10" TextWrapping="Wrap" IsVisible="{Binding HasChromaShareWarning}"
                               Foreground="{DynamicResource ReyWarningBrush}" />
                  </StackPanel>
                  <StackPanel Spacing="3" IsVisible="{Binding HasChromaRecolourControls}">
                    <Grid ColumnDefinitions="86,*,40">
                      <TextBlock Text="Hue" FontSize="11" VerticalAlignment="Center" ToolTip.Tip="Turn every colour round the hue wheel. +120 turns red into green." />
                      <Slider Grid.Column="1" Minimum="-180" Maximum="180" Value="{Binding ChromaHue, Mode=TwoWay}" />
                      <TextBlock Grid.Column="2" Text="{Binding ChromaHue, StringFormat='{}{0:0}'}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*,40">
                      <TextBlock Text="Saturation" FontSize="11" VerticalAlignment="Center" ToolTip.Tip="1 leaves the colours as they are, 0 makes them grey." />
                      <Slider Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding ChromaSaturation, Mode=TwoWay}" />
                      <TextBlock Grid.Column="2" Text="{Binding ChromaSaturation, StringFormat='{}{0:0.00}'}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*,40">
                      <TextBlock Text="Brightness" FontSize="11" VerticalAlignment="Center" ToolTip.Tip="Multiplies the brightest channel of every colour. Greys that grey protection covers stay as they are." />
                      <Slider Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding ChromaBrightness, Mode=TwoWay}" />
                      <TextBlock Grid.Column="2" Text="{Binding ChromaBrightness, StringFormat='{}{0:0.00}'}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*,40">
                      <TextBlock Text="Strength" FontSize="11" VerticalAlignment="Center" ToolTip.Tip="How much of the change is kept: 0 is the original, 1 the full recolour." />
                      <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding ChromaStrength, Mode=TwoWay}" />
                      <TextBlock Grid.Column="2" Text="{Binding ChromaStrength, StringFormat='{}{0:0.00}'}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <CheckBox Content="Colourise" IsChecked="{Binding ChromaColorize}" FontSize="11"
                              ToolTip.Tip="Give every colour one chosen hue, keeping its own saturation and brightness. The Hue slider is ignored while this is on." />
                    <Grid ColumnDefinitions="86,*,40" IsVisible="{Binding ChromaColorize}">
                      <TextBlock Text="Colour hue" FontSize="11" VerticalAlignment="Center" />
                      <Slider Grid.Column="1" Minimum="0" Maximum="360" Value="{Binding ChromaColorizeHue, Mode=TwoWay}" />
                      <TextBlock Grid.Column="2" Text="{Binding ChromaColorizeHue, StringFormat='{}{0:0}'}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <CheckBox Content="Only a hue range" IsChecked="{Binding ChromaRangeOn}" FontSize="11"
                              ToolTip.Tip="Change only the colours whose hue lies in a range - the reds, the blues - and leave the rest. Red is 0, green 120, blue 240." />
                    <Grid ColumnDefinitions="86,*,40" IsVisible="{Binding ChromaRangeOn}">
                      <TextBlock Text="Range centre" FontSize="11" VerticalAlignment="Center" />
                      <Slider Grid.Column="1" Minimum="0" Maximum="360" Value="{Binding ChromaRangeCenter, Mode=TwoWay}" />
                      <TextBlock Grid.Column="2" Text="{Binding ChromaRangeCenter, StringFormat='{}{0:0}'}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*,40" IsVisible="{Binding ChromaRangeOn}">
                      <TextBlock Text="Range width" FontSize="11" VerticalAlignment="Center" />
                      <Slider Grid.Column="1" Minimum="0" Maximum="360" Value="{Binding ChromaRangeWidth, Mode=TwoWay}" />
                      <TextBlock Grid.Column="2" Text="{Binding ChromaRangeWidth, StringFormat='{}{0:0}'}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*,40" IsVisible="{Binding ChromaRangeOn}">
                      <TextBlock Text="Range feather" FontSize="11" VerticalAlignment="Center" ToolTip.Tip="How far outside the range the change fades out." />
                      <Slider Grid.Column="1" Minimum="0" Maximum="180" Value="{Binding ChromaRangeFeather, Mode=TwoWay}" />
                      <TextBlock Grid.Column="2" Text="{Binding ChromaRangeFeather, StringFormat='{}{0:0}'}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*,40">
                      <TextBlock Text="Grey guard" FontSize="11" VerticalAlignment="Center"
                                 ToolTip.Tip="Colours with less saturation than this are left alone, so steel, bone and cloth greys do not pick up a tint. Compressed textures store greys slightly off-grey, so 0.05 to 0.1 is right; 0 turns the guard off." />
                      <Slider Grid.Column="1" Minimum="0" Maximum="0.5" Value="{Binding ChromaGreyThreshold, Mode=TwoWay}" />
                      <TextBlock Grid.Column="2" Text="{Binding ChromaGreyThreshold, StringFormat='{}{0:0.00}'}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="86,*,40">
                      <TextBlock Text="Guard feather" FontSize="11" VerticalAlignment="Center" ToolTip.Tip="How softly the guard lets colour back in above its threshold." />
                      <Slider Grid.Column="1" Minimum="0" Maximum="0.5" Value="{Binding ChromaGreyFeather, Mode=TwoWay}" />
                      <TextBlock Grid.Column="2" Text="{Binding ChromaGreyFeather, StringFormat='{}{0:0.00}'}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="TEXTURES" FontSize="10" Margin="0,6,0,0" Foreground="{DynamicResource ReyTextDimBrush}" IsVisible="{Binding HasChromaTextures}"
                               ToolTip.Tip="The body textures the recolour acts on. A texture the project writer cannot write back (DDS, BC5, BGRA8) is listed with the reason and stays as it is." />
                    <CheckBox Content="Show masks and data maps (left out by default)" IsChecked="{Binding ChromaShowExcluded}" FontSize="10" IsVisible="{Binding HasChromaTextures}"
                              ToolTip.Tip="Masks, normal maps and channel-packed data maps hold lighting data, not colour: recolouring one corrupts the lighting it carries. They can be switched on here if you know what you are doing." />
                    <ScrollViewer MaxHeight="150" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasChromaTextures}">
                      <ItemsControl ItemsSource="{Binding ChromaTextures}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ChromaTextureRowViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Tip}" Margin="0,1">
                              <CheckBox Grid.Column="0" IsChecked="{Binding IsIncluded, Mode=TwoWay}" IsEnabled="{Binding CanInclude}" MinWidth="0" Margin="0,0,4,0" />
                              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" FontSize="9" Foreground="{DynamicResource ReyTextDimBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Note}" FontSize="9" IsVisible="{Binding HasNote}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource ReyWarningBrush}" />
                              </StackPanel>
                              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="6,0,0,0" VerticalAlignment="Center">
                                <Border Classes="badge outline" IsVisible="{Binding IsOutside}">
                                  <TextBlock Text="{Binding OutsideBadge}" />
                                </Border>
                                <Border Classes="badge warn" IsVisible="{Binding IsShared}" ToolTip.Tip="{Binding SharedTip}">
                                  <TextBlock Text="{Binding SharedBadge}" />
                                </Border>
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>

                    <!-- M825: the skin bin's colour parameters (TintColor and its like), recoloured by the same sliders. The two swatches are
                         Riot's colour and what the sliders make of it. -->
                    <TextBlock Text="COLOUR PARAMETERS" FontSize="10" Margin="0,6,0,0" Foreground="{DynamicResource ReyTextDimBrush}" IsVisible="{Binding HasChromaParameters}"
                               ToolTip.Tip="The colour parameters of this skin's materials (TintColor, OutlineColor, the skin's fresnel colour...). Apply and Save writes them into the skin bin, derived from Riot's value, so Build Package and .fantome ship them. The Direct3D 11 viewport shows them live; a parameter that is a number named after a colour, a negative colour or one in a linked bin is listed with the reason and left alone." />
                    <TextBlock Text="{Binding ChromaParameterProblem}" FontSize="10" TextWrapping="Wrap" IsVisible="{Binding HasChromaParameterProblem}"
                               Foreground="{DynamicResource ReyWarningBrush}" />
                    <ScrollViewer MaxHeight="150" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasChromaParameters}">
                      <ItemsControl ItemsSource="{Binding ChromaParameters}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ChromaParameterRowViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Tip}" Margin="0,1">
                              <CheckBox Grid.Column="0" IsChecked="{Binding IsIncluded, Mode=TwoWay}" IsEnabled="{Binding CanInclude}" MinWidth="0" Margin="0,0,4,0" />
                              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" FontSize="9" Foreground="{DynamicResource ReyTextDimBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Note}" FontSize="9" IsVisible="{Binding HasNote}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource ReyWarningBrush}" />
                              </StackPanel>
                              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="6,0,0,0" VerticalAlignment="Center" IsVisible="{Binding CanInclude}">
                                <Border Width="16" Height="16" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource ReyBorderBrush}"
                                        Background="{Binding OriginalBrush}" />
                                <Border Width="16" Height="16" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource ReyBorderBrush}"
                                        Background="{Binding ResultBrush}" />
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>

                    <!-- M826: EFFECTS RECOLOUR. The same sliders recolour the colour values (birth colour, colour over life, linger and fresnel colours) and the
                         colour textures of the effects this skin plays. One switch a system, one a field, one a texture file; what is left alone is listed with the
                         reason. The effects restart with the new colours while a slider moves. -->
                    <TextBlock Text="EFFECTS RECOLOUR" FontSize="10" Margin="0,8,0,0" Foreground="{DynamicResource ReyTextDimBrush}" IsVisible="{Binding HasChromaEffects}"
                               ToolTip.Tip="The colours and colour textures of the effects this skin plays. Brightness and saturation act once per particle (on the emitter's most colourful value, never on a texture); hue, colourise, the hue range and the grey guard act on every colour and texture. Apply and Save writes the bins and textures from Riot's originals. Masks, data maps and cubemaps are listed below and left alone." />
                    <TextBlock Text="{Binding ChromaEffectSummary}" FontSize="9" TextWrapping="Wrap" Foreground="{DynamicResource ReyTextDimBrush}" IsVisible="{Binding HasChromaEffects}" />
                    <TextBlock Text="{Binding ChromaEffectProblem}" FontSize="10" TextWrapping="Wrap" IsVisible="{Binding HasChromaEffectProblem}"
                               Foreground="{DynamicResource ReyWarningBrush}" />
                    <TextBlock Text="{Binding ChromaEffectShareWarning}" FontSize="10" TextWrapping="Wrap" IsVisible="{Binding HasChromaEffectShareWarning}"
                               Foreground="{DynamicResource ReyWarningBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasChromaEffects}">
                      <Button Classes="tool" Content="All colours" FontSize="10" Padding="6,1" Command="{Binding SelectAllEffectColorsCommand}" />
                      <Button Classes="tool" Content="No colours" FontSize="10" Padding="6,1" Command="{Binding SelectNoEffectColorsCommand}" />
                      <Button Classes="tool" Content="All textures" FontSize="10" Padding="6,1" Command="{Binding SelectAllEffectTexturesCommand}"
                              ToolTip.Tip="Switch on every effect texture of this character's own folder that can be written back. Shared sprites outside it (other characters use them) are switched on one by one." />
                      <Button Classes="tool" Content="No textures" FontSize="10" Padding="6,1" Command="{Binding SelectNoEffectTexturesCommand}" />
                    </StackPanel>
                    <ScrollViewer MaxHeight="230" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasChromaEffects}">
                      <ItemsControl ItemsSource="{Binding ChromaEffectSystems}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ChromaEffectSystemRowViewModel">
                            <StackPanel Margin="0,1">
                              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ToolTip.Tip="{Binding Tip}">
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsIncluded, Mode=TwoWay}" IsEnabled="{Binding CanInclude}" MinWidth="0" Margin="0,0,4,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding Detail}" FontSize="9" Foreground="{DynamicResource ReyTextDimBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="2" Classes="badge warn" IsVisible="{Binding IsShared}" ToolTip.Tip="{Binding SharedTip}" Margin="6,0,0,0" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding SharedBadge}" />
                                </Border>
                                <ToggleButton Grid.Column="3" Classes="tool" Content="Fields" FontSize="9" Padding="6,0" Margin="6,0,0,0" VerticalAlignment="Center"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay}" ToolTip.Tip="List this system's colour fields, each with its own switch." />
                              </Grid>
                              <ItemsControl ItemsSource="{Binding Fields}" IsVisible="{Binding IsExpanded}" Margin="18,0,0,2">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:ChromaEffectFieldRowViewModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Tip}" Margin="0,1">
                                      <CheckBox Grid.Column="0" IsChecked="{Binding IsIncluded, Mode=TwoWay}" IsEnabled="{Binding CanInclude}" MinWidth="0" Margin="0,0,4,0" />
                                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" FontSize="9" Foreground="{DynamicResource ReyTextDimBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Note}" FontSize="9" IsVisible="{Binding HasNote}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource ReyWarningBrush}" />
                                      </StackPanel>
                                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="6,0,0,0" VerticalAlignment="Center" IsVisible="{Binding CanInclude}">
                                        <Border Width="16" Height="16" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource ReyBorderBrush}"
                                                Background="{Binding OriginalBrush}" />
                                        <Border Width="16" Height="16" CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource ReyBorderBrush}"
                                                Background="{Binding ResultBrush}" />
                                      </StackPanel>
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="EFFECT TEXTURES" FontSize="10" Margin="0,4,0,0" Foreground="{DynamicResource ReyTextDimBrush}" IsVisible="{Binding HasChromaEffectTextures}"
                               ToolTip.Tip="The colour textures the effects draw with: sprites, multiplier maps, colour lookups and palettes. They take the hue-only form of the transform (a texture multiplies the colour values, so brightness and saturation would count twice). Files outside this character's folder are shared with other characters and start off." />
                    <ScrollViewer MaxHeight="150" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasChromaEffectTextures}">
                      <ItemsControl ItemsSource="{Binding ChromaEffectTextures}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ChromaEffectTextureRowViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Tip}" Margin="0,1">
                              <CheckBox Grid.Column="0" IsChecked="{Binding IsIncluded, Mode=TwoWay}" IsEnabled="{Binding CanInclude}" MinWidth="0" Margin="0,0,4,0" />
                              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" FontSize="9" Foreground="{DynamicResource ReyTextDimBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Note}" FontSize="9" IsVisible="{Binding HasNote}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource ReyWarningBrush}" />
                              </StackPanel>
                              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="6,0,0,0" VerticalAlignment="Center">
                                <Border Classes="badge outline" IsVisible="{Binding IsOutside}">
                                  <TextBlock Text="{Binding OutsideBadge}" />
                                </Border>
                                <Border Classes="badge warn" IsVisible="{Binding IsShared}" ToolTip.Tip="{Binding SharedTip}">
                                  <TextBlock Text="{Binding SharedBadge}" />
                                </Border>
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="LEFT ALONE" FontSize="10" Margin="0,4,0,0" Foreground="{DynamicResource ReyTextDimBrush}" IsVisible="{Binding HasChromaEffects}"
                               ToolTip.Tip="What the effects recolour never touches, and why: channel mixers typed as colours, data maps and reflection cubemaps." />
                    <ItemsControl ItemsSource="{Binding ChromaEffectExcluded}" IsVisible="{Binding HasChromaEffects}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChromaRowViewModel">
                          <StackPanel Margin="0,1" ToolTip.Tip="{Binding Tip}">
                            <TextBlock Text="{Binding Title}" FontSize="10" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" FontSize="9" Foreground="{DynamicResource ReyTextDimBrush}" TextWrapping="Wrap" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                  </StackPanel>
                </StackPanel>
              </Border>
              <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="5">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                  <TextBlock Classes="cardTitle" Grid.Column="0" Text="CHROMA" VerticalAlignment="Center"
                             ToolTip.Tip="Everything colour-bearing this skin draws: the body's colour textures and colour parameters, and the colours and colour textures of the effects it uses. Read-only - nothing is written." />
                  <Button Grid.Column="1" Classes="tool" Content="Scan colours" FontSize="11" Padding="8,2"
                          Command="{Binding ScanColoursCommand}"
                          ToolTip.Tip="Read this skin's files and list its colours. Runs in the background; opening a skin does not do it." />
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding ChromaSkinLabel}" FontSize="11"
                           Foreground="{DynamicResource ReyAccentBrush}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Text="{Binding ChromaSummary}" FontSize="10"
                           Foreground="{DynamicResource ReyTextDimBrush}" TextWrapping="Wrap" />
                <!-- what could not be read, so the lists may be incomplete: in the warning colour, and capped like the notes -->
                <ScrollViewer Grid.Row="3" MaxHeight="84" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasChromaWarnings}">
                  <TextBlock Text="{Binding ChromaWarnings}" FontSize="10"
                             Foreground="{DynamicResource ReyWarningBrush}" TextWrapping="Wrap" />
                </ScrollViewer>
                <!-- how far the comparison reached and what was left out: capped, so a long list scrolls instead of
                     squeezing the two lists below it away -->
                <ScrollViewer Grid.Row="4" MaxHeight="96" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasChromaNotes}">
                  <TextBlock Text="{Binding ChromaNotes}" FontSize="9"
                             Foreground="{DynamicResource ReyTextDimBrush}" TextWrapping="Wrap" />
                </ScrollViewer>
                <TextBlock Grid.Row="5" Classes="cardTitle" Text="BODY" Margin="0,4,0,0" IsVisible="{Binding HasChromaResult}" />
                <ListBox Grid.Row="6" Height="220" ItemsSource="{Binding ChromaBodyRows}" Background="Transparent" BorderThickness="0"
                         IsVisible="{Binding HasChromaResult}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChromaRowViewModel">
                      <Grid ColumnDefinitions="*,Auto" Margin="{Binding Indent}" ToolTip.Tip="{Binding Tip}">
                        <StackPanel Grid.Column="0">
                          <TextBlock Classes.chromaHeader="{Binding IsHeader}" Text="{Binding Title}" FontSize="11"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Detail}" FontSize="9" IsVisible="{Binding HasDetail}"
                                     Foreground="{DynamicResource ReyTextDimBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="6,0,0,0" VerticalAlignment="Center">
                          <Border Classes="badge outline" IsVisible="{Binding IsOutside}" ToolTip.Tip="{Binding OutsideTip}">
                            <TextBlock Text="{Binding OutsideBadge}" />
                          </Border>
                          <Border Classes="badge warn" IsVisible="{Binding IsShared}" ToolTip.Tip="{Binding SharedTip}">
                            <TextBlock Text="{Binding SharedBadge}" />
                          </Border>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="7" Classes="cardTitle" Text="EFFECTS" Margin="0,4,0,0" IsVisible="{Binding HasChromaResult}" />
                <ListBox Grid.Row="8" Height="320" ItemsSource="{Binding ChromaEffectRows}" Background="Transparent" BorderThickness="0"
                         IsVisible="{Binding HasChromaResult}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChromaRowViewModel">
                      <Grid ColumnDefinitions="*,Auto" Margin="{Binding Indent}" ToolTip.Tip="{Binding Tip}">
                        <StackPanel Grid.Column="0">
                          <TextBlock Classes.chromaHeader="{Binding IsHeader}" Text="{Binding Title}" FontSize="11"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Detail}" FontSize="9" IsVisible="{Binding HasDetail}"
                                     Foreground="{DynamicResource ReyTextDimBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="6,0,0,0" VerticalAlignment="Center">
                          <Border Classes="badge outline" IsVisible="{Binding IsOutside}" ToolTip.Tip="{Binding OutsideTip}">
                            <TextBlock Text="{Binding OutsideBadge}" />
                          </Border>
                          <Border Classes="badge warn" IsVisible="{Binding IsShared}" ToolTip.Tip="{Binding SharedTip}">
                            <TextBlock Text="{Binding SharedBadge}" />
                          </Border>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
              </Grid>
              </ScrollViewer>
            </Border>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>
  </DockPanel>
</Window>
