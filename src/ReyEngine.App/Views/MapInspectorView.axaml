<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ReyEngine.App.ViewModels"
             x:Class="ReyEngine.App.Views.MapInspectorView">
  <!-- M471: the MAP-scoped half of the old SceneObjectInspectorView, moved VERBATIM so the split is a
       pure refactor and the redesign is reviewable on its own (the same discipline M351a used).
       These cards describe the MAP, not the selected object: which shared rendering systems the map
       turns on, its lightgrid, its gameplay texture, and its layer sets. They were interleaved with
       per-selection cards in one scrolling column, which is what made the inspector hard to read. -->
  <StackPanel Spacing="8">

    <!-- M472: fine-tune a WGEO/NVR port's alignment. Only appears on a map that actually holds imported
         legacy geometry, since on any other map every control here would be a no-op. -->
    <Border Classes="card" IsVisible="{Binding HasLegacyImport}">
      <StackPanel Spacing="4">
        <TextBlock Classes="cardTitle" Text="LEGACY IMPORT POSITION" />
        <TextBlock FontSize="10" Foreground="{DynamicResource ReyTextDimBrush}" TextWrapping="Wrap">
          <Run Text="{Binding LegacyImportedMeshCount}" /><Run Text=" imported mesh(es) · " /><Run Text="{Binding LegacyPortCorrectionText}" />
        </TextBlock>
        <TextBlock Text="Nudge (world units, added to the current position)" FontSize="9"
                   Foreground="{DynamicResource ReyTextDimBrush}" Margin="0,2,0,0" />
        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*">
          <TextBlock Grid.Column="0" Text="X" FontSize="10" VerticalAlignment="Center" Margin="0,0,3,0" Foreground="{DynamicResource ReyAxisXBrush}" />
          <TextBox Grid.Column="1" Text="{Binding LegacyNudgeX}" FontSize="10" Padding="3,1" />
          <TextBlock Grid.Column="2" Text="Y" FontSize="10" VerticalAlignment="Center" Margin="5,0,3,0" Foreground="{DynamicResource ReyAxisYBrush}" />
          <TextBox Grid.Column="3" Text="{Binding LegacyNudgeY}" FontSize="10" Padding="3,1" />
          <TextBlock Grid.Column="4" Text="Z" FontSize="10" VerticalAlignment="Center" Margin="5,0,3,0" Foreground="{DynamicResource ReyAxisZBrush}" />
          <TextBox Grid.Column="5" Text="{Binding LegacyNudgeZ}" FontSize="10" Padding="3,1" />
        </Grid>
        <Button Classes="tool" Content="Nudge Imported Geometry" HorizontalAlignment="Left"
                Command="{Binding NudgeLegacyImportCommand}"
                ToolTip.Tip="Move every mesh that came from the WGEO/NVR port by this delta, as one undoable edit. Additive — nudging twice by 10 moves 20 — so you can walk the alignment in. Only meshes with LegacyPort/ materials move; the destination map's own geometry is never touched. The per-mesh TRANSFORM box takes ABSOLUTE world positions instead, which is why it cannot be used to fine-tune a whole import." />
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding HasMapGraphicsFeatures}">
      <StackPanel Spacing="3">
        <TextBlock Classes="cardTitle" Text="MAP GRAPHICS FEATURES" />
        <TextBlock Text="Components in the map's materials.bin that switch on shared rendering resources. 179 of 206 shipped map bins declare MapLightingV2; the ones that don't are the map11 family."
                   FontSize="9" Foreground="{DynamicResource ReyTextDimBrush}" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding MapGraphicsFeatures}" Margin="0,2,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,3">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="0" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock Text="{Binding Name}" FontSize="10" VerticalAlignment="Center"
                                 Foreground="{DynamicResource ReyTextBrush}" />
                      <TextBlock Text="{Binding StateLabel}" FontSize="9" VerticalAlignment="Center"
                                 Foreground="{DynamicResource ReyTextDimBrush}" />
                      <!-- M436: 5 of the 9 features appear in 0 shipped map bins. MapGameplayTexture is
                           one, and adding it as a bare marker breaks the client. -->
                      <Border IsVisible="{Binding IsUnshipped}" Background="{DynamicResource ReyErrorSoftBrush}" CornerRadius="2" Padding="4,0">
                        <TextBlock Text="{Binding ShippedLabel}" FontSize="9" Foreground="{DynamicResource ReyErrorBrush}" />
                      </Border>
                      <TextBlock IsVisible="{Binding !IsUnshipped}" Text="{Binding ShippedLabel}" FontSize="9"
                                 VerticalAlignment="Center" Foreground="{DynamicResource ReyTextDimBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Purpose}" FontSize="9" TextWrapping="Wrap"
                               Foreground="{DynamicResource ReyTextDimBrush}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                    <!-- M438: copy the whole component out of a map Riot ships with it - textures,
                         nested structs and all. Absent for the features no shipped map declares. -->
                    <Button Content="{Binding PresetLabel}" FontSize="10" Padding="6,1"
                            IsVisible="{Binding HasPreset}"
                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).FillMapGraphicsPresetCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="Copy this component's real configuration from a shipped Riot map, including texture paths and nested settings. Link fields cannot cross bins and are reported rather than copied." />
                    <Button Content="{Binding ActionLabel}" FontSize="10" Padding="8,1"
                            Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ToggleMapGraphicsFeatureCommand}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </Grid>

                <!-- M436: the component's own fields, named and typed by the meta-class dump. -->
                <ItemsControl ItemsSource="{Binding Fields}" IsVisible="{Binding HasFields}" Margin="10,2,0,4">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="150,*,Auto" Margin="0,1">
                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                          <TextBlock Text="{Binding Name}" FontSize="9" TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource ReyTextBrush}" ToolTip.Tip="{Binding Hint}" />
                          <TextBlock Text="{Binding Hint}" FontSize="8" TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource ReyTextDimBrush}" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding Value}" FontSize="9" Padding="3,1"
                                 IsEnabled="{Binding IsEditable}" VerticalAlignment="Center"
                                 Watermark="(unset - takes the engine default)" />
                        <Button Grid.Column="2" Content="Set" FontSize="9" Padding="6,1" Margin="4,0,0,0"
                                VerticalAlignment="Center" IsEnabled="{Binding IsEditable}"
                                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).SetMapGraphicsFieldCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="Write this value into the component. Empty clears the field, which is not the same as zero." />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- M442: the lightgrid is MapLightingV2's prerequisite - 180 of 180 shipped maps that declare V2 also
         set MapBakeProperties.lightGridFileName. Baking it needs no lightmap layout and no atlases. -->
    <Border Classes="card" IsVisible="{Binding CanBakeLightGrid}">
      <StackPanel Spacing="3">
        <TextBlock Classes="cardTitle" Text="LIGHTGRID" />
        <TextBlock Text="The probe volume that lights characters, effects and NO_BAKED_LIGHTING surfaces. Every shipped map declaring MapLightingV2 has one."
                   FontSize="9" TextWrapping="Wrap" Foreground="{DynamicResource ReyTextDimBrush}" />
        <TextBlock Text="{Binding LightGridStatus}" FontSize="9" TextWrapping="Wrap"
                   Foreground="{DynamicResource ReyAccentBrush}" Margin="0,2,0,0" />
        <Button Content="Bake + Link Lightgrid" Command="{Binding BakeLightGridCommand}"
                FontSize="11" Padding="8,2" Margin="0,3,0,0" HorizontalAlignment="Left"
                ToolTip.Tip="Bake a 256x256 probe volume from the map's own sun/sky and lights, write lightgrid.dat next to the map, and set MapBakeProperties.lightGridFileName to point at it. No atlases and no lightmap layout needed." />
      </StackPanel>
    </Border>

    <!-- M439: MapGameplayTexture is the one feature whose content cannot be typed into the generic field
         list: its texture lives in an embedded sampler list and its four colour slots are object links
         that must point at real GameplayTextureChannel objects in this same bin. -->
    <Border Classes="card" IsVisible="{Binding HasGameplayTexture}">
      <StackPanel Spacing="3">
        <TextBlock Classes="cardTitle" Text="MAP GAMEPLAY TEXTURE" />
        <TextBlock Text="Riot ships no map with this component and no instance of its two sub-classes anywhere, so the structure below is from the schema and the values are yours to choose."
                   FontSize="9" TextWrapping="Wrap" Foreground="{DynamicResource ReyTextDimBrush}" />
        <TextBlock Text="{Binding GameplayTextureStatus}" FontSize="9" TextWrapping="Wrap"
                   Foreground="{DynamicResource ReyAccentBrush}" Margin="0,2,0,0" />

        <TextBlock Text="Texture (GameplayTextureSampler — no link needed)" FontSize="9" Margin="0,4,0,0"
                   Foreground="{DynamicResource ReyTextDimBrush}" />
        <Grid ColumnDefinitions="90,*,Auto">
          <TextBox Grid.Column="0" Text="{Binding GameplayTextureSamplerName}" FontSize="9" Padding="3,1"
                   Watermark="name" Margin="0,0,4,0" />
          <TextBox Grid.Column="1" Text="{Binding GameplayTexturePath}" FontSize="9" Padding="3,1"
                   Watermark="ASSETS/Maps/.../Texture.tex" />
          <Button Grid.Column="2" Content="Set" FontSize="9" Padding="6,1" Margin="4,0,0,0"
                  Command="{Binding SetGameplayTextureSamplerCommand}"
                  ToolTip.Tip="Add or replace a sampler entry. This is where the texture actually goes — GameplayTextureChannel has no texture field." />
        </Grid>

        <TextBlock Text="Channel slots (each creates a GameplayTextureChannel object and links it)"
                   FontSize="9" Margin="0,4,0,0" Foreground="{DynamicResource ReyTextDimBrush}" />
        <Grid ColumnDefinitions="90,*,Auto">
          <ComboBox Grid.Column="0" ItemsSource="{Binding GameplayChannelSlots}"
                    SelectedItem="{Binding GameplayChannelSlot}" FontSize="9" Margin="0,0,4,0" />
          <TextBox Grid.Column="1" Text="{Binding GameplayChannelName}" FontSize="9" Padding="3,1"
                   Watermark="channel name, e.g. Grass" />
          <Button Grid.Column="2" Content="Link" FontSize="9" Padding="6,1" Margin="4,0,0,0"
                  Command="{Binding SetGameplayTextureChannelCommand}"
                  ToolTip.Tip="Create a GameplayTextureChannel in this bin and point the slot at it. A null slot link is what makes the client fail with Missing sampler AlphaMask." />
        </Grid>
      </StackPanel>
    </Border>

    <!-- MATERIALS — the materials assigned to the selected mesh (Unity Mesh-Renderer style) -->
    <Border Classes="card" IsVisible="{Binding HasLayerSelection}">
      <StackPanel Spacing="4">
        <TextBlock Classes="cardTitle" Text="MAP LAYERS" />
        <TextBlock Text="{Binding LayerSummary}" FontSize="9" Foreground="{DynamicResource ReyAccentBrush}" TextWrapping="Wrap" />

        <TextBlock Text="Map visibility layers (from the shipping map .bin)" FontSize="9"
                   Foreground="{DynamicResource ReyTextDimBrush}" Margin="0,2,0,0" />
        <ItemsControl ItemsSource="{Binding VisibilityLayerBits}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox Content="{Binding Name}" IsChecked="{Binding IsOn}" FontSize="10" Margin="0,0,8,2" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Visibility controller (combined states and timed events)" FontSize="9"
                   Foreground="{DynamicResource ReyTextDimBrush}" Margin="0,4,0,0" />
        <ComboBox ItemsSource="{Binding LayerControllerChoices}" SelectedIndex="{Binding SelectedLayerControllerIndex}"
                  FontSize="10" HorizontalAlignment="Stretch"
                  ToolTip.Tip="Controllers come from this map's .bin files. 'None' keeps the mesh on its mapgeo visibility mask." />

        <CheckBox Content="Disable backface culling (two-sided)" IsChecked="{Binding MeshBackfaceDisabled}" FontSize="10"
                  Margin="0,2,0,0" ToolTip.Tip="The mapgeo's own per-mesh backface flag (M102)" />

        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
          <Button Content="All Layers" Command="{Binding SetLayersAllCommand}" FontSize="10" Padding="8,2"
                  ToolTip.Tip="Mask 255 — visible for every declared map state" />
          <Button Content="Reset Edits" Command="{Binding ResetLayerEditsCommand}" FontSize="10" Padding="8,2"
                  ToolTip.Tip="Discard pending layer edits on the selected meshes (back to the file's values)" />
          <Button Classes="primary" Content="Save to Mod" Command="{Binding SaveMeshMovesCommand}" FontSize="10" Padding="8,2"
                  IsEnabled="{Binding HasMapMoves}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- MESH DETAILS — read-only mapgeo diagnostics, collapsed by default. Everything editable lives
         above (Transform card, Map Layers card, Materials); these rows have no writable .bin field. -->
    <!-- M331: the authored visibility mask is editable for placements, not only mapgeo meshes. -->
    <Border Classes="card" IsVisible="{Binding HasPlacementLayerSelection}">
      <StackPanel Spacing="4">
        <TextBlock Classes="cardTitle" Text="OBJECT VISIBILITY LAYERS" />
        <TextBlock Text="{Binding PlacementLayerSummary}" FontSize="9"
                   Foreground="{DynamicResource ReyAccentBrush}" TextWrapping="Wrap" />
        <TextBlock Text="Map visibility layers (from the shipping map .bin)" FontSize="9"
                   Foreground="{DynamicResource ReyTextDimBrush}" Margin="0,2,0,0" />
        <ItemsControl ItemsSource="{Binding PlacementVisibilityLayerBits}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox Content="{Binding Name}" IsChecked="{Binding IsOn}" FontSize="10" Margin="0,0,8,2" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Applies to selected particles, sounds, mobs/props, and probes. Disable sets the mask to zero."
                   FontSize="9" Foreground="{DynamicResource ReyTextDimBrush}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
          <Button Content="All Layers" Command="{Binding SetPlacementLayersAllCommand}" FontSize="10" Padding="8,2" />
          <Button Content="Reset Edits" Command="{Binding ResetPlacementLayerEditsCommand}" FontSize="10" Padding="8,2" />
          <Button Classes="primary" Content="Save to Mod" Command="{Binding SaveMapContentEditsCommand}"
                  FontSize="10" Padding="8,2" IsEnabled="{Binding HasParticleMoves}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
