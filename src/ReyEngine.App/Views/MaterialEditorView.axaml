<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ReyEngine.App.Views"
             xmlns:vm="clr-namespace:ReyEngine.App.ViewModels"
             xmlns:conv="clr-namespace:ReyEngine.App.Converters"
             x:Class="ReyEngine.App.Views.MaterialEditorView"
             x:DataType="vm:MaterialEditorViewModel"
             x:CompileBindings="True">
  <!-- M642: the material editor, lifted byte for byte out of InspectorView's Materials tab so that
       the map inspector and the character window can each host one. Every binding used to read
       "MaterialEditor.X" against the main window's view model; the prefix is the only change. -->
  <ScrollViewer>
    <StackPanel Spacing="8" Margin="0,8,4,0">
      <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource ReyTextBrush}" FontSize="12" FontWeight="SemiBold" />
      <!-- M101: the list is scoped to the selected mesh's materials -->
      <Border Background="{DynamicResource ReyPanelAltBrush}" CornerRadius="4" Padding="6,3"
              IsVisible="{Binding HasMeshFilter}">
        <TextBlock Text="{Binding MeshFilterLabel}" FontSize="10"
                   Foreground="{DynamicResource ReyAccent2Brush}" TextWrapping="Wrap" />
      </Border>
      <Border Background="{DynamicResource ReyPanelAltBrush}" CornerRadius="4" Padding="6" IsVisible="{Binding HasUnresolved}">
        <TextBlock Text="⚠ Some texture paths don't resolve in this WAD — see the ⚠ slots below." Foreground="{DynamicResource ReyWarningBrush}" FontSize="11" TextWrapping="Wrap" />
      </Border>
      <!-- M125: the tolerant reader had to repair this bin — red banner, details + fix in the Issues window -->
      <Border Background="{DynamicResource ReyErrorSoftBrush}" CornerRadius="4" Padding="6" IsVisible="{Binding HasBinIssues}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="tool" Content="View Issues"
                  Command="{Binding ShowIssuesCommand}" VerticalAlignment="Center"
                  ToolTip.Tip="Every repaired problem, where it lives, and a one-click fix" />
          <TextBlock Text="{Binding BinIssuesLabel}" Foreground="{DynamicResource ReyErrorBrush}" FontSize="11"
                     TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
      <TextBox PlaceholderText="Search materials / textures…" Text="{Binding Search}" FontSize="11" Padding="4,2" />
      <StackPanel Orientation="Horizontal" Spacing="10">
        <CheckBox Content="Only unresolved" IsChecked="{Binding OnlyUnresolved}" FontSize="11" />
        <CheckBox Content="Show modified only" IsChecked="{Binding ShowModifiedOnly}" FontSize="11"
                  ToolTip.Tip="Only materials with unsaved edits. Applied when you toggle it — the list is not re-filtered while you type, so a material does not jump out from under you as you edit it." />
        <Ellipse Width="7" Height="7" Fill="{DynamicResource ReyAccent2Brush}" VerticalAlignment="Center" IsVisible="{Binding IsDirty}" ToolTip.Tip="Unsaved edits" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Classes="tool" Content="Apply (preview)" Command="{Binding ApplyCommand}" />
        <CheckBox Content="Live" IsChecked="{Binding LivePreview}" FontSize="11" VerticalAlignment="Center"
                  ToolTip.Tip="Push every edit to the viewport automatically (debounced)" />
        <Button Classes="tool" Content="Save To Override" Command="{Binding SaveCommand}" />
        <Button Classes="tool" Content="Revert All" Command="{Binding RevertAllCommand}" />
      </StackPanel>

      <!-- M351e: the selector is a ComboBox ABOVE the detail (user feedback on the
           M351b side list), and the detail is flat sections in the mockup order -
           General / Samplers / Render State / Derived / Switches / Parameters /
           Advanced - instead of one nested stack. Every block inside the sections is
           the previous markup verbatim, so no editing capability is lost; pieces
           moved out of the shader group keep their CanChangeShader gate. -->
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" FontSize="11"
                    ItemsSource="{Binding FilteredMaterials}"
                    SelectedItem="{Binding SelectedMaterial}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:MaterialBindingViewModel">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Text="⚠" Foreground="{DynamicResource ReyErrorBrush}" FontSize="11" VerticalAlignment="Center"
                             IsVisible="{Binding HasIssue}" ToolTip.Tip="{Binding IssueTip}" />
                  <TextBlock Text="●" Foreground="{DynamicResource ReyAccent2Brush}" FontSize="10"
                             VerticalAlignment="Center" IsVisible="{Binding IsDirty}"
                             ToolTip.Tip="Modified — not saved to an override yet" />
                  <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                  <TextBlock Text="{Binding ShaderName}" FontSize="9" VerticalAlignment="Center"
                             Foreground="{DynamicResource ReyTextDimBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Grid.Column="1" Text="{Binding ListSummary}" FontSize="10"
                     Foreground="{DynamicResource ReyTextDimBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
        </Grid>

        <!-- M645: SELECT SEVERAL. Two or more picked materials turn the detail pane below into the shared
             inspector: a field shows the value every picked material agrees on, or mixed, and an edit
             writes all of them as one undo step. The map inspector and the character window both host
             this control, so both get it. -->
        <Expander FontSize="11" IsExpanded="{Binding ShowBulkPicker}">
          <Expander.Header><TextBlock Classes="cardTitle" Text="{Binding BulkPickerHeader}" /></Expander.Header>
          <StackPanel Spacing="4" Margin="0,4,0,0">
            <TextBlock Text="Click rows to pick materials, click again to unpick. Two or more picked edit together."
                       FontSize="9" Foreground="{DynamicResource ReyTextDimBrush}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Classes="tool" Content="Pick all shown" Command="{Binding SelectAllShownCommand}"
                      ToolTip.Tip="Pick every material the search and filters above currently show" />
              <Button Classes="tool" Content="Clear" Command="{Binding ClearBulkCommand}" />
            </StackPanel>
            <ListBox ItemsSource="{Binding FilteredMaterials}" SelectedItems="{Binding BulkSelection}"
                     SelectionMode="Multiple,Toggle" MaxHeight="220" FontSize="10"
                     Background="{DynamicResource ReyBgBrush}" BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="1">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MaterialBindingViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="●" Foreground="{DynamicResource ReyAccent2Brush}" FontSize="9" VerticalAlignment="Center"
                               IsVisible="{Binding IsDirty}" ToolTip.Tip="Modified — not saved to an override yet" />
                    <TextBlock Text="{Binding Name}" FontSize="10" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ShaderName}" FontSize="8" VerticalAlignment="Center"
                               Foreground="{DynamicResource ReyTextDimBrush}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Expander>

        <!-- M645: BULK EDIT - the shared inspector -->
        <Border Classes="card" IsVisible="{Binding IsBulk}">
          <StackPanel Spacing="6">
            <TextBlock Classes="cardTitle" Text="BULK EDIT" />
            <TextBlock Text="{Binding BulkStatus}" FontSize="10" Foreground="{DynamicResource ReyAccentBrush}" TextWrapping="Wrap" />
            <TextBlock Text="A value shown is common to every picked material; mixed means they differ. An edit writes every picked material that has the field, as one undo step. A material without the field is left alone."
                       FontSize="9" Foreground="{DynamicResource ReyTextDimBrush}" TextWrapping="Wrap" />
            <Button Classes="tool" Content="Revert picked materials" Command="{Binding RevertBulkCommand}" HorizontalAlignment="Left"
                    ToolTip.Tip="Put every picked material back to what the file authored" />

            <Expander IsExpanded="True" FontSize="11" IsVisible="{Binding BulkCanChangeShader}">
              <Expander.Header><TextBlock Classes="cardTitle" Text="SHADER" /></Expander.Header>
              <StackPanel Spacing="3" Margin="0,4,0,0">
                <TextBlock Text="{Binding BulkShaderLabel}" FontSize="10" Foreground="{DynamicResource ReyTextDimBrush}" TextTrimming="CharacterEllipsis" />
                <Grid ColumnDefinitions="*,Auto">
                  <AutoCompleteBox Grid.Column="0" Text="{Binding BulkShader}" FontSize="10"
                                   ItemsSource="{Binding KnownShaders}" FilterMode="Contains" PlaceholderText="Shaders/StaticMesh/…" />
                  <Button Grid.Column="1" Content="Set on all" Command="{Binding ApplyBulkShaderCommand}" FontSize="10" Padding="7,1" Margin="3,0,0,0"
                          ToolTip.Tip="Switch every picked material with a technique pass to this shader, adding the sampler slots it declares - one undo step" />
                </Grid>
                <TextBlock Text="{Binding ShaderListNote}" FontSize="9" TextWrapping="Wrap"
                           Foreground="{DynamicResource ReyTextDimBrush}"
                           IsVisible="{Binding ShaderListNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding BulkPickShaderStatus}" FontSize="9" Foreground="{DynamicResource ReyAccentBrush}" TextWrapping="Wrap"
                           IsVisible="{Binding BulkPickShaderStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Expander>

            <Expander IsExpanded="True" FontSize="11">
              <Expander.Header><TextBlock Classes="cardTitle" Text="SAMPLERS" /></Expander.Header>
              <ItemsControl ItemsSource="{Binding BulkSamplers}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BulkFieldViewModel">
                    <StackPanel Spacing="2" Margin="0,3,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{DynamicResource ReyTextDimBrush}" MinWidth="110" />
                        <TextBlock Text="{Binding Presence}" FontSize="9" Foreground="{DynamicResource ReyWarningBrush}"
                                   IsVisible="{Binding Presence, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Text="— mixed —" FontSize="9" Foreground="{DynamicResource ReyWarningBrush}" IsVisible="{Binding Mixed}" />
                      </StackPanel>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding EditedText}" PlaceholderText="{Binding ValueLabel}" FontSize="10" Padding="4,1"
                                 FontFamily="Cascadia Mono, Consolas, monospace">
                          <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding ApplyCommand}" /></TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="✓ all" Command="{Binding ApplyCommand}" FontSize="10" Padding="5,0" Margin="3,0,0,0"
                                ToolTip.Tip="Write this path into every picked material that has this sampler" />
                      </Grid>
                      <TextBlock Text="{Binding Error}" FontSize="9" Foreground="{DynamicResource ReyErrorBrush}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>

            <Expander IsExpanded="True" FontSize="11">
              <Expander.Header><TextBlock Classes="cardTitle" Text="PARAMETERS" /></Expander.Header>
              <ItemsControl ItemsSource="{Binding BulkParameters}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:BulkFieldViewModel">
                    <StackPanel Spacing="2" Margin="0,3,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{DynamicResource ReyTextDimBrush}" MinWidth="110" />
                        <TextBlock Text="{Binding Presence}" FontSize="9" Foreground="{DynamicResource ReyWarningBrush}"
                                   IsVisible="{Binding Presence, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Text="— mixed —" FontSize="9" Foreground="{DynamicResource ReyWarningBrush}" IsVisible="{Binding Mixed}" />
                      </StackPanel>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding EditedText}" PlaceholderText="{Binding ValueLabel}" FontSize="10" Padding="4,1"
                                 FontFamily="Cascadia Mono, Consolas, monospace">
                          <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding ApplyCommand}" /></TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="✓ all" Command="{Binding ApplyCommand}" FontSize="10" Padding="5,0" Margin="3,0,0,0"
                                ToolTip.Tip="Write this value into every picked material that has this parameter. A value one of them cannot take rolls the whole edit back." />
                      </Grid>
                      <TextBlock Text="{Binding Error}" FontSize="9" Foreground="{DynamicResource ReyErrorBrush}" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>

            <Expander IsExpanded="True" FontSize="11">
              <Expander.Header><TextBlock Classes="cardTitle" Text="SWITCHES &amp; MACROS" /></Expander.Header>
              <StackPanel Spacing="3" Margin="0,4,0,0">
                <TextBlock Text="FEATURE SWITCHES" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource ReyTextDimBrush}"
                           IsVisible="{Binding HasBulkSwitches}" />
                <ItemsControl ItemsSource="{Binding BulkSwitches}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BulkToggleViewModel">
                      <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,1">
                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding StateLabel}" FontSize="9" Margin="4,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ReyTextDimBrush}" />
                        <Button Grid.Column="2" Classes="tool" Content="On" FontSize="8" Padding="4,0" Command="{Binding TurnOnCommand}" />
                        <Button Grid.Column="3" Classes="tool" Content="Off" FontSize="8" Padding="4,0" Margin="2,0,0,0" Command="{Binding TurnOffCommand}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="SHADER MACROS" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource ReyTextDimBrush}" Margin="0,3,0,0"
                           IsVisible="{Binding HasBulkMacros}" />
                <ItemsControl ItemsSource="{Binding BulkMacros}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BulkToggleViewModel">
                      <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,1">
                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding StateLabel}" FontSize="9" Margin="4,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ReyTextDimBrush}" />
                        <Button Grid.Column="2" Classes="tool" Content="1" FontSize="8" Padding="4,0" Command="{Binding TurnOnCommand}"
                                ToolTip.Tip="Set the define to 1 on every picked material that has it - a material without it is not given one" />
                        <Button Grid.Column="3" Classes="tool" Content="0" FontSize="8" Padding="4,0" Margin="2,0,0,0" Command="{Binding TurnOffCommand}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Expander>

            <Expander IsExpanded="True" FontSize="11" IsVisible="{Binding BulkCanEditRenderState}">
              <Expander.Header><TextBlock Classes="cardTitle" Text="RENDER STATE" /></Expander.Header>
              <StackPanel Spacing="3" Margin="0,4,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="4">
                  <TextBlock Grid.Column="0" Text="Culling" FontSize="9" VerticalAlignment="Center" Foreground="{DynamicResource ReyTextDimBrush}" />
                  <TextBlock Grid.Column="1" Text="{Binding BulkCullLabel}" FontSize="9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <Button Grid.Column="2" Classes="tool" Content="Cull" FontSize="8" Padding="4,0" Command="{Binding SetBulkCullCommand}" CommandParameter="on" />
                  <Button Grid.Column="3" Classes="tool" Content="Two-sided" FontSize="8" Padding="4,0" Command="{Binding SetBulkCullCommand}" CommandParameter="off" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="4">
                  <TextBlock Grid.Column="0" Text="Blending" FontSize="9" VerticalAlignment="Center" Foreground="{DynamicResource ReyTextDimBrush}" />
                  <TextBlock Grid.Column="1" Text="{Binding BulkBlendLabel}" FontSize="9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <Button Grid.Column="2" Classes="tool" Content="Blend" FontSize="8" Padding="4,0" Command="{Binding SetBulkBlendCommand}" CommandParameter="on" />
                  <Button Grid.Column="3" Classes="tool" Content="Opaque" FontSize="8" Padding="4,0" Command="{Binding SetBulkBlendCommand}" CommandParameter="off" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                  <TextBlock Grid.Column="0" Text="Src blend" FontSize="9" VerticalAlignment="Center" Foreground="{DynamicResource ReyTextDimBrush}" />
                  <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="{Binding BulkSrcLabel}" FontSize="9" Foreground="{DynamicResource ReyTextDimBrush}" />
                    <ComboBox FontSize="9" HorizontalAlignment="Stretch" ItemsSource="{Binding BulkBlendChoices}" SelectedIndex="{Binding BulkSrcChoice}"
                              ToolTip.Tip="Picking a factor writes it on every picked material with a pass, colour and alpha together; 'not set' removes the field" />
                  </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                  <TextBlock Grid.Column="0" Text="Dst blend" FontSize="9" VerticalAlignment="Center" Foreground="{DynamicResource ReyTextDimBrush}" />
                  <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="{Binding BulkDstLabel}" FontSize="9" Foreground="{DynamicResource ReyTextDimBrush}" />
                    <ComboBox FontSize="9" HorizontalAlignment="Stretch" ItemsSource="{Binding BulkBlendChoices}" SelectedIndex="{Binding BulkDstChoice}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>

        <ContentControl Content="{Binding SelectedMaterial}" IsVisible="{Binding !IsBulk}">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:MaterialBindingViewModel">
            <Border Classes="card">
              <StackPanel Spacing="6">
                <!-- M351k: the material ball - a CPU-lit sphere sampling the diffuse through the UV
                     transform. Honest about scope: it shows texture, tiling and shape, not the Riot
                     shader; Riot Approx in the viewport stays the truth for that. -->
                <Grid ColumnDefinitions="Auto,*">
                  <Border Background="{DynamicResource ReyBgBrush}" CornerRadius="6" Padding="4" VerticalAlignment="Top">
                    <Image Source="{Binding SpherePreview}" Width="96" Height="96" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="5" Margin="10,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <!-- M125: red name + ⚠ when this material's bin object needed repairs -->
                  <TextBlock Text="⚠" Foreground="{DynamicResource ReyErrorBrush}" FontSize="12" VerticalAlignment="Center"
                             IsVisible="{Binding HasIssue}" ToolTip.Tip="{Binding IssueTip}" />
                  <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                             Classes.issue="{Binding HasIssue}" ToolTip.Tip="{Binding IssueTip}">
                    <TextBlock.Styles>
                      <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ReyTextBrush}" /></Style>
                      <Style Selector="TextBlock.issue"><Setter Property="Foreground" Value="{DynamicResource ReyErrorBrush}" /></Style>
                    </TextBlock.Styles>
                  </TextBlock>
                  <Ellipse Width="7" Height="7" Fill="{DynamicResource ReyAccent2Brush}" VerticalAlignment="Center" IsVisible="{Binding IsDirty}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding ShaderName}" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="10" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding AssignedTo, StringFormat='→ {0}'}" Foreground="{DynamicResource ReyAccentBrush}" FontSize="10" VerticalAlignment="Center" IsVisible="{Binding HasAssignment}" />
                </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Border Background="{DynamicResource ReyAccentBrush}" CornerRadius="3" Padding="5,1">
                        <TextBlock Text="{Binding ProfileLabel}" Foreground="{DynamicResource ReyOnAccentBrush}" FontSize="9" FontWeight="SemiBold" />
                      </Border>
                      <TextBlock Text="{Binding FeatureSummary}" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="10" VerticalAlignment="Center" />
                      <Border Background="{DynamicResource ReyAccent2SoftBrush}" CornerRadius="3" Padding="5,1" VerticalAlignment="Center" IsVisible="{Binding UsesSpecular}">
                        <TextBlock Text="SPECULAR" Foreground="{DynamicResource ReyTextBrush}" FontSize="8" FontWeight="SemiBold" />
                      </Border>
                      <TextBlock Text="⚠ profile unresolved" Foreground="{DynamicResource ReyWarningBrush}" FontSize="9" VerticalAlignment="Center" IsVisible="{Binding ProfileUnresolved}" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
      <Expander IsExpanded="True" FontSize="11" Margin="0,2,0,0">
        <Expander.Header><TextBlock Classes="cardTitle" Text="GENERAL" /></Expander.Header>
        <StackPanel Spacing="3" Margin="0,4,0,0">
        <StackPanel IsVisible="{Binding CanChangeShader}">
                  <TextBlock Text="Shader" FontSize="9" Foreground="{DynamicResource ReyTextDimBrush}" />
                  <Grid ColumnDefinitions="*,Auto">
                    <AutoCompleteBox Grid.Column="0" Text="{Binding EditedShader}" FontSize="10"
                                     ItemsSource="{Binding Owner.KnownShaders}" FilterMode="Contains"
                                     PlaceholderText="Shaders/StaticMesh/…" />
                    <Button Grid.Column="1" Content="Set" Command="{Binding ApplyShaderCommand}" FontSize="10" Padding="7,1" Margin="3,0,0,0"
                            ToolTip.Tip="Switch to this shader and auto-add the sampler slots materials of that shader use" />
                  </Grid>
                  <!-- M701: which family the list was narrowed to, and why -->
                  <TextBlock Text="{Binding Owner.ShaderListNote}" FontSize="9" TextWrapping="Wrap"
                             Foreground="{DynamicResource ReyTextDimBrush}"
                             IsVisible="{Binding Owner.ShaderListNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Text="{Binding ShaderChangeStatus}" FontSize="9" Foreground="{DynamicResource ReyAccentBrush}"
                             TextWrapping="Wrap" IsVisible="{Binding ShaderChangeStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Text="{Binding ShaderDefSummary}" FontSize="9" TextWrapping="Wrap"
                             Foreground="{DynamicResource ReyTextDimBrush}"
                             IsVisible="{Binding ShaderDefSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
                    <!-- M351j: texture settings. UV was a read-only line pointing at the parameter list; now the
                         scale/offset are edited here and written THROUGH the parameter machinery (undo, dirty,
                         live preview all behave as if the parameter row was edited by hand). -->
                    <StackPanel Spacing="2" IsVisible="{Binding CanEditUv}">
                      <Grid ColumnDefinitions="Auto,*,Auto,*,Auto" ColumnSpacing="4">
                        <TextBlock Grid.Column="0" Text="UV scale" FontSize="9" VerticalAlignment="Center" Foreground="{DynamicResource ReyTextDimBrush}" />
                        <TextBox Grid.Column="1" Text="{Binding UvScaleText}" FontSize="10" Padding="4,1" FontFamily="Cascadia Mono, Consolas, monospace">
                          <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding ApplyUvCommand}" /></TextBox.KeyBindings>
                        </TextBox>
                        <TextBlock Grid.Column="2" Text="offset" FontSize="9" VerticalAlignment="Center" Foreground="{DynamicResource ReyTextDimBrush}" />
                        <TextBox Grid.Column="3" Text="{Binding UvOffsetText}" FontSize="10" Padding="4,1" FontFamily="Cascadia Mono, Consolas, monospace">
                          <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding ApplyUvCommand}" /></TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="4" Content="Set" Command="{Binding ApplyUvCommand}" FontSize="10" Padding="7,1"
                                ToolTip.Tip="Writes the UV scale/offset into this material's UV parameters (created under the canonical name when missing)" />
                      </Grid>
                      <TextBlock Text="{Binding UvStatus}" FontSize="9" TextWrapping="Wrap" Foreground="{DynamicResource ReyAccentBrush}"
                                 IsVisible="{Binding UvStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding UvTransformText}" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="10"
                               IsVisible="{Binding !CanEditUv}" />
                    <TextBlock Text="{Binding UvSourceText}" Foreground="{DynamicResource ReyAccentBrush}" FontSize="9" IsVisible="{Binding HasUvSource}" />
                    <TextBlock Text="{Binding RenderModeLabel, StringFormat='Blend mode: {0}'}" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="10" />
        </StackPanel>
      </Expander>
      <Expander IsExpanded="True" FontSize="11" Margin="0,2,0,0">
        <Expander.Header><TextBlock Classes="cardTitle" Text="SAMPLERS" /></Expander.Header>
        <StackPanel Spacing="3" Margin="0,4,0,0">
                <ItemsControl ItemsSource="{Binding Slots}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Spacing="2" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding SamplerName}" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="10" MinWidth="110" VerticalAlignment="Center" />
                          <Ellipse Width="6" Height="6" Fill="{DynamicResource ReyAccentBrush}" VerticalAlignment="Center" IsVisible="{Binding IsDiffuse}" ToolTip.Tip="Diffuse" />
                          <TextBlock Text="⚠" Foreground="{DynamicResource ReyWarningBrush}" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding Unresolved}" ToolTip.Tip="Path not found in this WAD" />
                          <TextBlock Text="?" Foreground="{DynamicResource ReyWarningBrush}" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding NotInShader}"
                                     ToolTip.Tip="The selected shader declares no sampler by this name — it will be ignored" />
                          <Ellipse Width="6" Height="6" Fill="{DynamicResource ReyAccent2Brush}" VerticalAlignment="Center" IsVisible="{Binding IsDirty}" />
                        </StackPanel>
                        <!-- M96: star-sized so long paths shrink the textbox instead of pushing ✓/↺ off the panel -->
                        <Grid ColumnDefinitions="*,Auto,Auto">
                          <TextBox Grid.Column="0" Text="{Binding EditedPath}" FontSize="10" Padding="4,1" FontFamily="Cascadia Mono, Consolas, monospace">
                            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding ApplyCommand}" /></TextBox.KeyBindings>
                          </TextBox>
                          <Button Grid.Column="1" Content="✓" Command="{Binding ApplyCommand}" FontSize="10" Padding="5,0" Margin="3,0,0,0" ToolTip.Tip="Apply path" />
                          <Button Grid.Column="2" Content="↺" Command="{Binding RevertCommand}" FontSize="10" Padding="5,0" Margin="3,0,0,0" ToolTip.Tip="Revert" />
                        </Grid>
                        <!-- M493: sampler address modes. Four choices per axis, because
                             "not set" and "0" are different in the file even though they
                             behave the same — Riot writes the field only when it has
                             something to say (4,726 shipped samplers author none at all,
                             8,667 author addressW=1 alone). -->
                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" Margin="0,2,0,0" IsVisible="{Binding CanEditAddress}">
                          <TextBlock Grid.Column="0" Text="U" FontSize="9" VerticalAlignment="Center" Margin="0,0,3,0"
                                     Foreground="{DynamicResource ReyTextDimBrush}" />
                          <ComboBox Grid.Column="1" ItemsSource="{Binding AddressOptions}" SelectedIndex="{Binding AddressUIndex}"
                                    FontSize="9" Padding="4,0" MinWidth="0" HorizontalAlignment="Stretch"
                                    ToolTip.Tip="addressU — Riot's enum is Unity's TextureWrapMode ordering (0 Wrap, 1 Clamp, 2 Mirror), not D3D11's. 'Not set' omits the field, which is the schema default and what most shipped samplers do." />
                          <TextBlock Grid.Column="2" Text="V" FontSize="9" VerticalAlignment="Center" Margin="5,0,3,0"
                                     Foreground="{DynamicResource ReyTextDimBrush}" />
                          <ComboBox Grid.Column="3" ItemsSource="{Binding AddressOptions}" SelectedIndex="{Binding AddressVIndex}"
                                    FontSize="9" Padding="4,0" MinWidth="0" HorizontalAlignment="Stretch"
                                    ToolTip.Tip="addressV — see addressU." />
                          <TextBlock Grid.Column="4" Text="W" FontSize="9" VerticalAlignment="Center" Margin="5,0,3,0"
                                     Foreground="{DynamicResource ReyTextDimBrush}" />
                          <ComboBox Grid.Column="5" ItemsSource="{Binding AddressOptions}" SelectedIndex="{Binding AddressWIndex}"
                                    FontSize="9" Padding="4,0" MinWidth="0" HorizontalAlignment="Stretch"
                                    ToolTip.Tip="addressW — only affects volume textures, but Riot sets it to 1 on most map samplers." />
                        </Grid>
                        <!-- M96: wraps instead of clipping when the inspector is narrow -->
                        <WrapPanel>
                          <Button Classes="tool" Content="Open" Command="{Binding OpenCommand}" Margin="0,0,4,2" />
                          <Button Classes="tool" Content="Copy" Command="{Binding CopyPathCommand}" Margin="0,0,4,2" />
                          <Button Classes="tool" Content="Replace Texture…" Command="{Binding ReplaceCommand}" Margin="0,0,4,2" />
                          <Button Classes="tool" Content="✕" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}" Margin="0,0,4,2" ToolTip.Tip="Remove this sampler" />
                        </WrapPanel>
                        <Border Background="{DynamicResource ReyBgBrush}" CornerRadius="3" Padding="3" HorizontalAlignment="Left" IsVisible="{Binding HasThumbnail}">
                          <Image Source="{Binding Thumbnail}" Stretch="Uniform" MaxHeight="96" MaxWidth="96" />
                        </Border>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
        <Button Classes="tool" Content="+ Add Sampler" Command="{Binding AddSamplerCommand}"
                IsVisible="{Binding CanEditSamplers}" HorizontalAlignment="Left" Margin="0,4,0,0" />
        <StackPanel IsVisible="{Binding CanChangeShader}">
                  <StackPanel Spacing="2" Margin="0,3,0,0" IsVisible="{Binding HasMissingSamplers}">
                    <TextBlock Text="SAMPLERS THIS SHADER SUPPORTS" FontSize="8" FontWeight="SemiBold"
                               Foreground="{DynamicResource ReyTextDimBrush}" />
                    <ItemsControl ItemsSource="{Binding MissingSamplers}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Classes="tool" FontSize="9" Margin="0,0,3,3"
                                  Content="{Binding Name, StringFormat='+ {0}'}"
                                  ToolTip.Tip="{Binding DefaultTexturePath}"
                                  Command="{Binding $parent[ItemsControl].DataContext.AddShaderSamplerCommand}"
                                  CommandParameter="{Binding}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
        </StackPanel>
        </StackPanel>
      </Expander>
      <Expander IsExpanded="True" FontSize="11" Margin="0,2,0,0" IsVisible="{Binding CanEditRenderState}">
        <Expander.Header><TextBlock Classes="cardTitle" Text="RENDER STATE" /></Expander.Header>
        <StackPanel Spacing="3" Margin="0,4,0,0">
                    <StackPanel Spacing="2" Margin="0,4,0,0" IsVisible="{Binding CanEditRenderState}">
                      <CheckBox Content="Cull back faces (off = two-sided)" IsChecked="{Binding CullEnable}" FontSize="9"
                                ToolTip.Tip="pass.cullEnable — also what drives Two-Sided Lighting below" />
                      <CheckBox Content="Alpha blending (blendEnable)" IsChecked="{Binding BlendEnable}" FontSize="9"
                                ToolTip.Tip="pass.blendEnable — the material's own transparency flag" />
                      <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                        <TextBlock Grid.Column="0" Text="Src blend" FontSize="9" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ReyTextDimBrush}" Margin="0,0,6,0" />
                        <ComboBox Grid.Column="1" FontSize="9" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding BlendFactorChoices}" SelectedIndex="{Binding SrcBlendChoice}"
                                  ToolTip.Tip="Riot blend factor. Map22 shadow receivers use 4 (DstColor); normal alpha materials use 6 (SrcAlpha). 'not set' REMOVES the field — absent is not the same as 0 (Zero), and it is what most shipped materials do." />
                      </Grid>
                      <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="Dst blend" FontSize="9" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ReyTextDimBrush}" Margin="0,0,6,0" />
                        <ComboBox Grid.Column="1" FontSize="9" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding BlendFactorChoices}" SelectedIndex="{Binding DstBlendChoice}"
                                  ToolTip.Tip="Sets both the colour and alpha destination factor; 'not set' removes both." />
                      </Grid>
                    </StackPanel>
        </StackPanel>
      </Expander>
      <Expander IsExpanded="True" FontSize="11" Margin="0,2,0,0">
        <Expander.Header><TextBlock Classes="cardTitle" Text="DERIVED — COMPUTED, NO .BIN FIELD" /></Expander.Header>
        <StackPanel Spacing="3" Margin="0,4,0,0">
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="Culling" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="9" Margin="0,0,10,0" />
                      <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CullEnabledText}" Foreground="{DynamicResource ReyTextBrush}" FontSize="9" />
                      <TextBlock Grid.Row="1" Grid.Column="0" Text="Depth Write" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="9" Margin="0,0,10,0" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DepthWriteText}" Foreground="{DynamicResource ReyTextBrush}" FontSize="9"
                                 ToolTip.Tip="Follows the blend mode: transparent and transparent-cutout materials don't write depth" />
                      <TextBlock Grid.Row="2" Grid.Column="0" Text="Alpha Cutout" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="9" Margin="0,0,10,0" />
                      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AlphaCutoutText}" Foreground="{DynamicResource ReyTextBrush}" FontSize="9"
                                 ToolTip.Tip="Threshold comes from the AlphaTestValue parameter — edit it in the parameter list below" />
                      <TextBlock Grid.Row="3" Grid.Column="0" Text="Two-Sided Lighting" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="9" Margin="0,0,10,0" />
                      <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TwoSidedText}" Foreground="{DynamicResource ReyTextBrush}" FontSize="9"
                                 ToolTip.Tip="Active when back-face culling is off — untick 'Cull back faces' above" />
                    </Grid>
        </StackPanel>
      </Expander>
      <Expander IsExpanded="True" FontSize="11" Margin="0,2,0,0" IsVisible="{Binding CanChangeShader}">
        <Expander.Header><TextBlock Classes="cardTitle" Text="SWITCHES &amp; MACROS" /></Expander.Header>
        <StackPanel Spacing="3" Margin="0,4,0,0">
                  <StackPanel Spacing="2" Margin="0,3,0,0" IsVisible="{Binding HasSwitches}">
                    <TextBlock Text="FEATURE SWITCHES" FontSize="8" FontWeight="SemiBold"
                               Foreground="{DynamicResource ReyTextDimBrush}" />
                    <ItemsControl ItemsSource="{Binding Switches}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,1">
                            <!-- Name in a TextBlock, not CheckBox.Content: content text treats
                                 the first underscore as an access-key marker and eats it. -->
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsOn}" FontSize="9"
                                      Padding="0" MinWidth="0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="9" Margin="4,0,0,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Ellipse Grid.Column="2" Width="6" Height="6" VerticalAlignment="Center" Margin="3,0"
                                     Fill="{DynamicResource ReyAccent2Brush}" IsVisible="{Binding IsDirty}" />
                            <Button Grid.Column="3" Classes="tool" Content="✕" FontSize="8" Padding="4,0"
                                    Command="{Binding RemoveCommand}" ToolTip.Tip="Remove this switch" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <StackPanel Spacing="2" IsVisible="{Binding HasShaderSwitches}">
                    <TextBlock Text="FEATURE SWITCHES THIS SHADER SUPPORTS" FontSize="8" FontWeight="SemiBold"
                               Foreground="{DynamicResource ReyTextDimBrush}" />
                    <ItemsControl ItemsSource="{Binding ShaderSwitches}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Classes="tool" FontSize="9" Margin="0,0,3,3"
                                  Command="{Binding $parent[ItemsControl].DataContext.AddShaderSwitchCommand}"
                                  CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <TextBlock Text="+" FontSize="9" />
                              <TextBlock Text="{Binding}" FontSize="9" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <StackPanel Spacing="2" Margin="0,3,0,0" IsVisible="{Binding HasMacros}">
                    <TextBlock Text="SHADER MACROS" FontSize="8" FontWeight="SemiBold"
                               Foreground="{DynamicResource ReyTextDimBrush}" />
                    <ItemsControl ItemsSource="{Binding Macros}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,1"
                                ToolTip.Tip="{Binding StatusTip}">
                            <!-- The name goes in a TextBlock, not CheckBox.Content: content is
                                 access-key text, so NO_BAKED_LIGHTING rendered as NOBAKED_LIGHTING
                                 (the first underscore was eaten as a mnemonic marker). -->
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsOn}" FontSize="9"
                                      Padding="0" MinWidth="0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="9" Margin="4,0,0,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <!-- Two badges rather than one recoloured: "would crash" and
                                 "ignored" are opposite problems and must not read alike. -->
                            <Border Grid.Column="2" Padding="4,0" CornerRadius="3" Margin="4,0,0,0"
                                    VerticalAlignment="Center" IsVisible="{Binding IsFatal}"
                                    Background="{DynamicResource ReyCardBrush}"
                                    BorderBrush="{DynamicResource ReyErrorBrush}" BorderThickness="1">
                              <TextBlock Text="{Binding StatusLabel}" FontSize="8" Foreground="{DynamicResource ReyErrorBrush}" />
                            </Border>
                            <Border Grid.Column="2" Padding="4,0" CornerRadius="3" Margin="4,0,0,0"
                                    VerticalAlignment="Center" IsVisible="{Binding IsWarning}"
                                    Background="{DynamicResource ReyCardBrush}">
                              <TextBlock Text="{Binding StatusLabel}" FontSize="8"
                                         Foreground="{DynamicResource ReyTextDimBrush}" />
                            </Border>
                            <Ellipse Grid.Column="3" Width="6" Height="6" VerticalAlignment="Center" Margin="3,0"
                                     Fill="{DynamicResource ReyAccent2Brush}" IsVisible="{Binding IsDirty}" />
                            <Button Grid.Column="4" Classes="tool" Content="✕" FontSize="8" Padding="4,0"
                                    Command="{Binding RemoveCommand}"
                                    ToolTip.Tip="Remove the define entirely — not the same as unticking it, which writes 0. Absent means the shader's own default applies." />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <StackPanel Spacing="2" IsVisible="{Binding HasMissingMacros}">
                    <TextBlock Text="ADD SHADER MACRO" FontSize="8" FontWeight="SemiBold"
                               Foreground="{DynamicResource ReyTextDimBrush}" />
                    <TextBlock Text="Macros select precompiled DX11 permutations. Unsupported combinations can crash in-game."
                               FontSize="8" TextWrapping="Wrap" Foreground="{DynamicResource ReyWarningBrush}" />
                    <ItemsControl ItemsSource="{Binding MissingMacros}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <!-- A define the game never cooked for this shader is never
                               APPLIED (M486), but the chip stays clickable: M533 made
                               clicking it explain the refusal and name the remedy in the
                               console, because a disabled chip reads as "nothing happened"
                               and sent the user looking for a broken save instead. The name
                               lives in a TextBlock because Button.Content eats the first
                               underscore as an access key. -->
                          <Button Classes="tool" FontSize="9" Margin="0,0,3,3"
                                  ToolTip.Tip="{Binding Tip}"
                                  Command="{Binding $parent[ItemsControl].DataContext.AddMacroCommand}"
                                  CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <TextBlock Text="+" FontSize="9" />
                              <TextBlock Text="{Binding Name}" FontSize="9" />
                              <TextBlock Text="{Binding StatusLabel}" FontSize="8" IsVisible="{Binding IsWarning}"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource ReyTextDimBrush}" />
                              <TextBlock Text="{Binding StatusLabel}" FontSize="8" IsVisible="{Binding IsFatal}"
                                         VerticalAlignment="Center" Foreground="{DynamicResource ReyErrorBrush}" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
        </StackPanel>
      </Expander>
                <Expander Header="Parameters" IsVisible="{Binding HasParameters}" FontSize="11" Margin="0,4,0,0">
                  <StackPanel>
                  <!-- M55: add a parameter (clones an existing one's schema; edit the value after) -->
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4" IsVisible="{Binding CanEditParameters}">
                    <TextBox Grid.Column="0" Text="{Binding NewParamName}" PlaceholderText="new param name (e.g. AlphaTestValue)"
                             FontSize="10" Padding="4,1">
                      <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding AddParameterCommand}" /></TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="1" Content="+ Add" Command="{Binding AddParameterCommand}" FontSize="10" Padding="6,1" Margin="3,0,0,0"
                            ToolTip.Tip="Add a parameter (value type is cloned from this material's first param — edit it after)" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Parameters}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                          <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="10" MinWidth="110" VerticalAlignment="Center" />
                          <!-- M50c: live colour swatch for Tint/Color params -->
                          <Border Width="16" Height="16" CornerRadius="3" BorderThickness="1" VerticalAlignment="Center"
                                  BorderBrush="{DynamicResource ReyBorderBrush}" IsVisible="{Binding IsColorLike}"
                                  Background="{Binding EditedText, Converter={x:Static conv:VecColorBrushConverter.Instance}}"
                                  ToolTip.Tip="Colour preview (r, g, b as 0..1)" />
                          <TextBox Text="{Binding EditedText}" MinWidth="150" FontSize="10" Padding="4,1" IsEnabled="{Binding IsEditable}" FontFamily="Cascadia Mono, Consolas, monospace">
                            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding ApplyCommand}" /></TextBox.KeyBindings>
                          </TextBox>
                          <Button Content="✓" Command="{Binding ApplyCommand}" FontSize="10" Padding="5,0" />
                          <Button Content="↺" Command="{Binding RevertCommand}" FontSize="10" Padding="5,0" />
                          <Button Content="✕" FontSize="10" Padding="5,0" IsVisible="{Binding IsRemovable}"
                                  Command="{Binding $parent[ItemsControl].DataContext.RemoveParameterCommand}"
                                  CommandParameter="{Binding}" ToolTip.Tip="Remove this parameter" />
                          <Ellipse Width="6" Height="6" Fill="{DynamicResource ReyAccent2Brush}" VerticalAlignment="Center" IsVisible="{Binding IsDirty}" />
                          <!-- M646: a dynamicMaterial driver overrides this value in the game -->
                          <TextBlock Text="⚡" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource ReyAccent2Brush}"
                                     IsVisible="{Binding IsDriven}" ToolTip.Tip="{Binding DrivenNote}" />
                          <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource ReyErrorBrush}" FontSize="9" VerticalAlignment="Center" IsVisible="{Binding HasError}" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <!-- M646: the material's runtime drivers (dynamicMaterial). The preview draws each driver's rest value. -->
                  <StackPanel Spacing="1" Margin="0,6,0,0" IsVisible="{Binding HasDrivers}">
                    <TextBlock Text="DRIVEN AT RUNTIME" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource ReyTextDimBrush}"
                               ToolTip.Tip="This material's dynamicMaterial overrides these parameters in the game - by buffs, death, movement. The preview draws each driver's value at rest; an authored value a driver overrides is marked with a bolt." />
                    <ItemsControl ItemsSource="{Binding DriverLines}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Text="{Binding}" FontSize="9" Foreground="{DynamicResource ReyTextDimBrush}" TextWrapping="Wrap" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  </StackPanel>
                </Expander>
        <StackPanel IsVisible="{Binding CanChangeShader}">
                  <StackPanel Spacing="2" IsVisible="{Binding HasMissingParameters}">
                    <TextBlock Text="PARAMETERS THIS SHADER SUPPORTS" FontSize="8" FontWeight="SemiBold"
                               Foreground="{DynamicResource ReyTextDimBrush}" />
                    <ItemsControl ItemsSource="{Binding MissingParameters}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Classes="tool" FontSize="9" Margin="0,0,3,3"
                                  Content="{Binding Name, StringFormat='+ {0}'}"
                                  ToolTip.Tip="{Binding DefaultText, StringFormat='default {0}'}"
                                  Command="{Binding $parent[ItemsControl].DataContext.AddShaderParameterCommand}"
                                  CommandParameter="{Binding}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
        </StackPanel>
      <!-- M368: what StaticMaterialDef declares that this material omits, and the value the
           game falls back to. Same shared panel the Particle Editor shows. Collapsed by
           default, and hidden entirely when the meta-class database was never synced. -->
      <Expander IsExpanded="False" FontSize="11" Margin="0,2,0,0"
                IsVisible="{Binding Schema.HasSchema}">
        <Expander.Header>
          <StackPanel>
            <TextBlock Classes="cardTitle" Text="UNSET FIELDS" />
            <TextBlock Text="{Binding Schema.Summary}" FontSize="9" Opacity="0.6" />
          </StackPanel>
        </Expander.Header>
        <StackPanel Spacing="2" Margin="0,4,0,0">
          <TextBlock Text="{Binding Schema.ClassDisplayName}" FontSize="9" Opacity="0.5"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Text="Declared by the class but absent here — the game uses the default shown."
                     FontSize="9" Opacity="0.45" TextWrapping="Wrap" Margin="0,0,0,3" />
          <ItemsControl ItemsSource="{Binding Schema.UnsetRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MetaSchemaRowViewModel">
                <DockPanel Margin="0,1">
                  <!-- M370: write the field at the schema's own default. Disabled with a
                       reason for types ReyEngine will not synthesise. -->
                  <Button DockPanel.Dock="Right" Classes="tool" Content="+" FontSize="9"
                          Padding="5,0" Margin="4,0,0,0" MinWidth="0"
                          Command="{Binding AddCommand}" IsEnabled="{Binding CanAdd}"
                          IsVisible="{Binding !Added}" ToolTip.Tip="{Binding AddTip}" />
                  <TextBlock DockPanel.Dock="Right" Text="added" FontSize="8" Opacity="0.6"
                             Margin="4,0,0,0" VerticalAlignment="Center"
                             IsVisible="{Binding Added}" />
                  <TextBlock DockPanel.Dock="Right" Text="{Binding DefaultText}" FontSize="9"
                             Opacity="0.55" MaxWidth="110" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding DefaultText}" />
                  <TextBlock DockPanel.Dock="Left" Text="{Binding TypeName}" FontSize="8"
                             Opacity="0.4" Margin="0,0,6,0" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Name}" FontSize="10" Opacity="0.75"
                             ToolTip.Tip="{Binding Error}" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Expander>
      <Expander IsExpanded="True" FontSize="11" Margin="0,2,0,0">
        <Expander.Header><TextBlock Classes="cardTitle" Text="ADVANCED" /></Expander.Header>
        <StackPanel Spacing="3" Margin="0,4,0,0">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Classes="tool" Content="Copy name" Command="{Binding CopyNameCommand}" />
          <Button Classes="tool" Content="Revert material" Command="{Binding RevertCommand}" />
        </StackPanel>
        <StackPanel IsVisible="{Binding CanChangeShader}">
                  <Button Classes="tool" Content="Use most-used Riot material setup"
                          Command="{Binding ApplyCommonShaderSetupCommand}"
                          IsVisible="{Binding HasShaderDef}" HorizontalAlignment="Stretch"
                          ToolTip.Tip="Loads real materials from the installed patch, selects the most frequent parameter/switch/macro/render-state setup for this shader, and keeps your texture paths." />
        </StackPanel>
        </StackPanel>
      </Expander>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ContentControl.ContentTemplate>
        </ContentControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
