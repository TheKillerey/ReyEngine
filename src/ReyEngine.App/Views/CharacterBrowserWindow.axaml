<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ReyEngine.App.Views"
        xmlns:vm="clr-namespace:ReyEngine.App.ViewModels"
        x:Class="ReyEngine.App.Views.CharacterBrowserWindow"
        x:DataType="vm:CharacterBrowserViewModel"
        Title="ReyEngine - Characters" Width="980" Height="660"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource ReyBgBrush}">
  <DockPanel>
    <views:ReyTitleBar DockPanel.Dock="Top" />

    <Border DockPanel.Dock="Bottom" Background="{DynamicResource ReyHeaderBrush}"
            BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="0,1,0,0" Padding="12,9">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="primary" Content="Open in Preview"
                Command="{Binding OpenSkinCommand}" Padding="16,5" />
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap"
                   Margin="0,0,12,0" Foreground="{DynamicResource ReyTextDimBrush}" />
      </DockPanel>
    </Border>

    <Grid ColumnDefinitions="230,190,*" Margin="12">

      <!-- champions -->
      <DockPanel Grid.Column="0" Margin="0,0,10,0">
        <TextBlock DockPanel.Dock="Top" Text="CHAMPIONS" FontSize="10" FontWeight="Bold"
                   Foreground="{DynamicResource ReyTextDimBrush}" Margin="0,0,0,6" />
        <TextBox DockPanel.Dock="Top" Text="{Binding Search}" Watermark="Search"
                 Margin="0,0,0,6" />
        <ListBox ItemsSource="{Binding Champions}" SelectedItem="{Binding SelectedChampion}"
                 Background="{DynamicResource ReyPanelBrush}"
                 BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="1">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ChampionRowViewModel">
              <StackPanel Margin="2,1">
                <TextBlock Text="{Binding Name}" FontSize="12" />
                <TextBlock Text="{Binding Folder}" FontSize="10" IsVisible="{Binding ShowFolder}"
                           Foreground="{DynamicResource ReyTextDimBrush}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- characters inside the champion -->
      <DockPanel Grid.Column="1" Margin="0,0,10,0">
        <TextBlock DockPanel.Dock="Top" Text="CHARACTERS" FontSize="10" FontWeight="Bold"
                   Foreground="{DynamicResource ReyTextDimBrush}" Margin="0,0,0,6" />
        <TextBlock DockPanel.Dock="Bottom" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"
                   Foreground="{DynamicResource ReyTextDimBrush}"
                   Text="A champion WAD also ships its pets, summons and second forms - each a full character with its own skins." />
        <ListBox ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}"
                 Background="{DynamicResource ReyPanelBrush}"
                 BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="1">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CharacterRowViewModel">
              <StackPanel Margin="2,1">
                <TextBlock Text="{Binding Name}" FontSize="12" />
                <TextBlock FontSize="10" Foreground="{DynamicResource ReyTextDimBrush}">
                  <Run Text="{Binding KindText}" /><Run Text=" · " /><Run Text="{Binding SkinCountText}" />
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- skins + the selected skin -->
      <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="SKINS" FontSize="10" FontWeight="Bold"
                   Foreground="{DynamicResource ReyTextDimBrush}" Margin="0,0,0,6" />

        <Border Grid.Row="1" Background="{DynamicResource ReyPanelBrush}"
                BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="1">
          <ListBox ItemsSource="{Binding Skins}" SelectedItem="{Binding SelectedSkin}"
                   Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SkinRowViewModel">
                <Grid ColumnDefinitions="46,*,66">
                  <TextBlock Grid.Column="0" Text="{Binding NumberText}" FontSize="11"
                             Foreground="{DynamicResource ReyTextDimBrush}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" />
                  <TextBlock Grid.Column="2" Text="{Binding Badge}" FontSize="10"
                             Foreground="{DynamicResource ReyAccent2Brush}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <StackPanel Grid.Row="2" Spacing="4" Margin="0,10,0,0" IsVisible="{Binding HasSkinDetails}">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                ColumnSpacing="10" RowSpacing="3">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Code name" FontSize="11"
                       Foreground="{DynamicResource ReyTextDimBrush}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CodeName}" FontSize="11" TextWrapping="Wrap" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Skin line" FontSize="11"
                       Foreground="{DynamicResource ReyTextDimBrush}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SkinLine}" FontSize="11" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Mesh" FontSize="11"
                       Foreground="{DynamicResource ReyTextDimBrush}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MeshPath}" FontSize="11" TextWrapping="Wrap" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Skeleton" FontSize="11"
                       Foreground="{DynamicResource ReyTextDimBrush}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SkeletonPath}" FontSize="11" TextWrapping="Wrap" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Texture" FontSize="11"
                       Foreground="{DynamicResource ReyTextDimBrush}" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TexturePath}" FontSize="11" TextWrapping="Wrap" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Hidden at load" FontSize="11"
                       Foreground="{DynamicResource ReyTextDimBrush}" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding HiddenSubmeshes}" FontSize="11" TextWrapping="Wrap" />
          </Grid>

          <TextBlock Text="Per-submesh overrides" FontSize="10" FontWeight="Bold" Margin="0,6,0,0"
                     Foreground="{DynamicResource ReyTextDimBrush}" />
          <ItemsControl ItemsSource="{Binding Overrides}" MaxHeight="90">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource ReyTextDimBrush}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
