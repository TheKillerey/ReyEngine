<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ReyEngine.App.Views"
             xmlns:vm="clr-namespace:ReyEngine.App.ViewModels"
             xmlns:conv="clr-namespace:ReyEngine.App.Converters"
             x:Class="ReyEngine.App.Views.InspectorView"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="True">
  <!-- M351a: the asset inspector, lifted verbatim out of MainWindow.axaml.

       It was 581 lines nested eight levels deep in a 129 KB file, which is why it had drifted into a
       list of fully-expanded materials rather than a real inspector. Moving it first, byte for byte,
       keeps this commit a pure refactor - the redesign that follows is then reviewable on its own. -->
              <!-- INSPECTOR TABS (M8): Overview / Materials / Raw BIN Tree — hidden by default (M50b);
                   expand on demand, or automatically when a .materials.bin is opened. -->
              <Expander IsExpanded="{Binding AssetDataExpanded, Mode=TwoWay}" IsVisible="{Binding HasInspectorBody}" FontSize="11" Margin="0,4,0,0">
                <Expander.Header>
                  <TextBlock Text="ASSET DATA · Overview / Materials / Raw BIN" FontSize="10" FontWeight="SemiBold"
                             Foreground="{DynamicResource ReyTextDimBrush}" />
                </Expander.Header>
              <TabControl SelectedIndex="{Binding InspectorTab}" Padding="0">
                <TabItem FontSize="12">
                  <TabItem.Header><TextBlock Text="Overview" FontSize="12" /></TabItem.Header>
                  <StackPanel Spacing="10" Margin="0,8,0,0">

              <!-- mesh stats (SKN) -->
              <Border Classes="card" IsVisible="{Binding MeshInspector.HasMesh}">
                <StackPanel Spacing="7">
                  <TextBlock Classes="cardTitle" Text="MESH" />
                  <TextBlock Classes="mono" Text="{Binding MeshInspector.Stats}" />
                  <TextBlock Text="{Binding MeshInspector.SkeletonStatus}" Foreground="{DynamicResource ReyAccentBrush}" FontSize="11" />
                  <Button Classes="tool" Content="Assign Skeleton…" HorizontalAlignment="Left"
                          Command="{Binding AssignSkeletonCommand}" />
                  <TextBlock Text="Submeshes / materials" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="11" />
                  <TextBlock Classes="mono" Text="{Binding MeshInspector.SubMeshes}"
                             Foreground="{DynamicResource ReyTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <!-- animation -->
              <Border Classes="card" IsVisible="{Binding MeshInspector.HasMesh}">
              <StackPanel Spacing="6">
                <TextBlock Classes="cardTitle" Text="ANIMATION" />
                <TextBlock Text="{Binding Animation.SkeletonStatus}" Foreground="{DynamicResource ReyAccentBrush}" FontSize="11" />

                <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Select animation…"
                          ItemsSource="{Binding Animation.Animations}"
                          SelectedItem="{Binding Animation.SelectedAnimation, Mode=TwoWay}"
                          IsVisible="{Binding Animation.HasAnimations}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <!-- M115: grouped by skin — the loaded skin's clips glow green, others carry a badge -->
                    <Border CornerRadius="3" Padding="4,1" Margin="-2,0"
                            Background="{Binding IsCurrentSkin, Converter={x:Static views:M115Converters.CurrentSkinBrush}}">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Background="{DynamicResource ReyPanelAltBrush}" CornerRadius="3"
                                Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding SkinGroup}" FontSize="8" Foreground="{DynamicResource ReyTextDimBrush}" />
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Classes="tool" Content="Assign Animation…" HorizontalAlignment="Left"
                        Command="{Binding AssignAnimationCommand}" />

                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding Animation.HasClip}">
                  <Button Classes="tool" Content="◀|" Command="{Binding Animation.StepBackCommand}" />
                  <Button Classes="tool" Content="Play / Pause" Command="{Binding Animation.TogglePlayCommand}" />
                  <Button Classes="tool" Content="|▶" Command="{Binding Animation.StepForwardCommand}" />
                  <CheckBox Content="Loop" IsChecked="{Binding Animation.Loop}" VerticalAlignment="Center" FontSize="11" />
                </StackPanel>
                <Slider Minimum="0" Maximum="{Binding Animation.Duration}" Value="{Binding Animation.Time, Mode=TwoWay}"
                        IsVisible="{Binding Animation.HasClip}" />
                <TextBlock Text="{Binding Animation.TimeText}" Foreground="{DynamicResource ReyTextDimBrush}"
                           FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" IsVisible="{Binding Animation.HasClip}" />
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Animation.HasClip}">
                  <TextBlock Text="Speed" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="11" VerticalAlignment="Center" />
                  <Slider Minimum="0.1" Maximum="2" Value="{Binding Animation.Speed, Mode=TwoWay}" Width="130" />
                  <TextBlock Text="{Binding Animation.Speed, StringFormat='{}{0:0.0}x'}" Foreground="{DynamicResource ReyTextBrush}" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
              </Border>

              <!-- champion VFX (M37) — play the loaded skin's effects at the model -->
              <Border Classes="card" IsVisible="{Binding HasChampionVfx}">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="cardTitle" Grid.Column="0" Text="CHAMPION VFX" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="tool" Content="⏹ Stop" Command="{Binding StopChampionVfxCommand}" FontSize="10" Padding="8,1" />
                </Grid>
                <TextBlock Text="Select an effect to play it at the model origin." Foreground="{DynamicResource ReyTextDimBrush}" FontSize="10" TextWrapping="Wrap" />
                <ListBox ItemsSource="{Binding ChampionVfxSystems}" SelectedItem="{Binding SelectedChampionVfx, Mode=TwoWay}"
                         MaxHeight="220" Background="Transparent" FontSize="11">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
              </Border>

              <!-- mapgeo stats -->
              <Border Classes="card" IsVisible="{Binding MapGeoInspector.HasMap}">
              <StackPanel Spacing="7">
                <TextBlock Classes="cardTitle" Text="MAP GEOMETRY" />
                <TextBlock Classes="mono" Text="{Binding MapGeoInspector.Stats}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding MapGeoInspector.Warnings}" Foreground="{DynamicResource ReyAccent2Brush}"
                           FontSize="11" TextWrapping="Wrap" IsVisible="{Binding MapGeoInspector.HasWarnings}" />
              </StackPanel>
              </Border>

                  </StackPanel>
                </TabItem>

                <!-- MATERIALS TAB (M90: no fixed height cap — flows with the window; the whole
                     inspector scrolls, so a hard 680px cap just left dead space on tall windows) -->
                <TabItem FontSize="12" IsVisible="{Binding HasMaterialData}">
                  <TabItem.Header><TextBlock Text="Materials" FontSize="12" /></TabItem.Header>
                  <ScrollViewer>
                    <StackPanel Spacing="8" Margin="0,8,4,0">
                      <TextBlock Text="{Binding MaterialEditor.Summary}" Foreground="{DynamicResource ReyTextBrush}" FontSize="12" FontWeight="SemiBold" />
                      <!-- M101: the list is scoped to the selected mesh's materials -->
                      <Border Background="{DynamicResource ReyPanelAltBrush}" CornerRadius="4" Padding="6,3"
                              IsVisible="{Binding MaterialEditor.HasMeshFilter}">
                        <TextBlock Text="{Binding MaterialEditor.MeshFilterLabel}" FontSize="10"
                                   Foreground="{DynamicResource ReyAccent2Brush}" TextWrapping="Wrap" />
                      </Border>
                      <Border Background="{DynamicResource ReyPanelAltBrush}" CornerRadius="4" Padding="6,4">
                        <StackPanel Spacing="2">
                          <TextBlock Text="SHADER BINDING" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ReyTextDimBrush}" />
                          <!-- M103: which client's shader list the dropdowns offer (Live / PBE differ) -->
                          <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                            <TextBlock Grid.Column="0" Text="Environment" FontSize="10" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ReyTextDimBrush}" Margin="0,0,6,0" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding MaterialEditor.ShaderEnvironments}"
                                      SelectedItem="{Binding MaterialEditor.SelectedShaderEnvironment}"
                                      FontSize="10" HorizontalAlignment="Stretch"
                                      ToolTip.Tip="Which League install the shader list is read from" />
                          </Grid>
                          <TextBlock Text="{Binding MaterialEditor.CatalogStatus}" FontSize="10" TextWrapping="Wrap"
                                     Foreground="{DynamicResource ReyAccentBrush}" />
                          <TextBlock Text="{Binding ShaderDbStatus}" FontSize="11" Foreground="{DynamicResource ReyTextDimBrush}" TextWrapping="Wrap" />
                          <TextBlock Text="The sampler slots below are the material's bound textures (required samplers). Switch the viewport to 'Riot Approx' to preview." FontSize="10" Foreground="{DynamicResource ReyTextDimBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                      <Border Background="{DynamicResource ReyPanelAltBrush}" CornerRadius="4" Padding="8,6">
                        <StackPanel Spacing="5">
                          <TextBlock Text="BULK MATERIAL SETUP" FontSize="10" FontWeight="SemiBold"
                                     Foreground="{DynamicResource ReyTextDimBrush}" />
                          <TextBlock Text="Apply each shader's most-used shipped Riot parameters, switches, macros and render state to every material in the currently loaded file. This ignores the selected-mesh filter and preserves all texture paths."
                                     FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource ReyTextDimBrush}" />
                          <Button Classes="tool" Content="Apply Riot setups to all loaded materials"
                                  Command="{Binding MaterialEditor.ApplyCommonSetupsToAllCommand}"
                                  IsEnabled="{Binding MaterialEditor.CanApplyCommonSetupsToAll}"
                                  HorizontalAlignment="Stretch" />
                          <TextBlock Text="{Binding MaterialEditor.BulkCommonSetupStatus}" FontSize="9"
                                     TextWrapping="Wrap" Foreground="{DynamicResource ReyAccentBrush}"
                                     IsVisible="{Binding MaterialEditor.BulkCommonSetupStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                      </Border>
                      <!-- M335: whole-document shader conversion. This intentionally ignores the selected-
                           mesh filter: every material using the source shader must change together. -->
                      <Border Background="{DynamicResource ReyPanelAltBrush}" CornerRadius="4" Padding="8,6">
                        <StackPanel Spacing="5">
                          <TextBlock Text="BULK SHADER REPLACE" FontSize="10" FontWeight="SemiBold"
                                     Foreground="{DynamicResource ReyTextDimBrush}" />
                          <TextBlock Text="Replace the shader on every matching material in this map. Compatible authored values are kept; missing target samplers use a matching texture or the shader default."
                                     FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource ReyTextDimBrush}" />
                          <Grid ColumnDefinitions="72,*" RowDefinitions="Auto,Auto" RowSpacing="4">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="From" FontSize="10"
                                       VerticalAlignment="Center" Foreground="{DynamicResource ReyTextDimBrush}" />
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding MaterialEditor.UsedShaders}"
                                      SelectedItem="{Binding MaterialEditor.BulkSourceShader, Mode=TwoWay}"
                                      FontSize="10" HorizontalAlignment="Stretch" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="To" FontSize="10"
                                       VerticalAlignment="Center" Foreground="{DynamicResource ReyTextDimBrush}" />
                            <AutoCompleteBox Grid.Row="1" Grid.Column="1"
                                             Text="{Binding MaterialEditor.BulkTargetShader, Mode=TwoWay}"
                                             ItemsSource="{Binding MaterialEditor.KnownShaders}" FilterMode="Contains"
                                             Watermark="Shaders/StaticMesh/..." FontSize="10" />
                          </Grid>
                          <TextBlock Text="{Binding MaterialEditor.BulkShaderSummary}" FontSize="9"
                                     TextWrapping="Wrap" Foreground="{DynamicResource ReyTextBrush}" />
                          <Button Classes="tool" Content="Replace all matching materials"
                                  Command="{Binding MaterialEditor.BulkReplaceShaderCommand}"
                                  IsEnabled="{Binding MaterialEditor.CanBulkReplaceShader}"
                                  HorizontalAlignment="Stretch"
                                  ToolTip.Tip="Changes the live material document as one undoable operation. Review it in the viewport, then use Save To Override." />
                          <TextBlock Text="{Binding MaterialEditor.BulkShaderStatus}" FontSize="9"
                                     TextWrapping="Wrap" Foreground="{DynamicResource ReyAccentBrush}"
                                     IsVisible="{Binding MaterialEditor.BulkShaderStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                      </Border>
                      <Border Background="{DynamicResource ReyPanelAltBrush}" CornerRadius="4" Padding="6" IsVisible="{Binding MaterialEditor.HasUnresolved}">
                        <TextBlock Text="⚠ Some texture paths don't resolve in this WAD — see the ⚠ slots below." Foreground="#FFB454" FontSize="11" TextWrapping="Wrap" />
                      </Border>
                      <!-- M125: the tolerant reader had to repair this bin — red banner, details + fix in the Issues window -->
                      <Border Background="#26FF5555" CornerRadius="4" Padding="6" IsVisible="{Binding MaterialEditor.HasBinIssues}">
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Classes="tool" Content="View Issues"
                                  Command="{Binding MaterialEditor.ShowIssuesCommand}" VerticalAlignment="Center"
                                  ToolTip.Tip="Every repaired problem, where it lives, and a one-click fix" />
                          <TextBlock Text="{Binding MaterialEditor.BinIssuesLabel}" Foreground="#FF7B72" FontSize="11"
                                     TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                      </Border>
                      <TextBox Watermark="Search materials / textures…" Text="{Binding MaterialEditor.Search}" FontSize="11" Padding="4,2" />
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <CheckBox Content="Only unresolved" IsChecked="{Binding MaterialEditor.OnlyUnresolved}" FontSize="11" />
                        <CheckBox Content="Show modified only" IsChecked="{Binding MaterialEditor.ShowModifiedOnly}" FontSize="11"
                                  ToolTip.Tip="Only materials with unsaved edits. Applied when you toggle it — the list is not re-filtered while you type, so a material does not jump out from under you as you edit it." />
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource ReyAccent2Brush}" VerticalAlignment="Center" IsVisible="{Binding MaterialEditor.IsDirty}" ToolTip.Tip="Unsaved edits" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Classes="tool" Content="Apply (preview)" Command="{Binding MaterialEditor.ApplyCommand}" />
                        <CheckBox Content="Live" IsChecked="{Binding MaterialEditor.LivePreview}" FontSize="11" VerticalAlignment="Center"
                                  ToolTip.Tip="Push every edit to the viewport automatically (debounced)" />
                        <Button Classes="tool" Content="Save To Override" Command="{Binding MaterialEditor.SaveCommand}" />
                        <Button Classes="tool" Content="Revert All" Command="{Binding MaterialEditor.RevertAllCommand}" />
                      </StackPanel>

                      <!-- M351b: master-detail. The list used to render EVERY material fully expanded,
                           so reaching one material meant scrolling past all 120. Now the list is a real
                           selection and exactly one material is edited at a time. -->
                      <Grid ColumnDefinitions="240,8,*" MinHeight="360">
                        <!-- MASTER: the filtered material list -->
                        <Border Grid.Column="0" Background="{DynamicResource ReyBgBrush}" CornerRadius="4"
                                BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="1">
                          <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="8,6"
                                    BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="0,0,0,1">
                              <TextBlock Text="{Binding MaterialEditor.ListSummary}" FontSize="10"
                                         Foreground="{DynamicResource ReyTextDimBrush}" />
                            </Border>
                            <ListBox ItemsSource="{Binding MaterialEditor.FilteredMaterials}"
                                     SelectedItem="{Binding MaterialEditor.SelectedMaterial}"
                                     Background="Transparent" BorderThickness="0" Padding="2">
                              <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:MaterialBindingViewModel">
                                  <StackPanel Spacing="1" Margin="2">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                      <TextBlock Text="⚠" Foreground="#FF7B72" FontSize="11" VerticalAlignment="Center"
                                                 IsVisible="{Binding HasIssue}" ToolTip.Tip="{Binding IssueTip}" />
                                      <TextBlock Text="●" Foreground="{DynamicResource ReyAccent2Brush}" FontSize="10"
                                                 VerticalAlignment="Center" IsVisible="{Binding IsDirty}"
                                                 ToolTip.Tip="Modified — not saved to an override yet" />
                                      <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ShaderName}" FontSize="9"
                                               Foreground="{DynamicResource ReyTextDimBrush}"
                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ShaderName}" />
                                  </StackPanel>
                                </DataTemplate>
                              </ListBox.ItemTemplate>
                            </ListBox>
                          </DockPanel>
                        </Border>

                        <!-- DETAIL: the one selected material -->
                        <ContentControl Grid.Column="2" Content="{Binding MaterialEditor.SelectedMaterial}">
                        <ContentControl.ContentTemplate>
                          <DataTemplate x:DataType="vm:MaterialBindingViewModel">
                            <Border Background="{DynamicResource ReyBgBrush}" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                              <StackPanel Spacing="5">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <!-- M125: red name + ⚠ when this material's bin object needed repairs -->
                                  <TextBlock Text="⚠" Foreground="#FF7B72" FontSize="12" VerticalAlignment="Center"
                                             IsVisible="{Binding HasIssue}" ToolTip.Tip="{Binding IssueTip}" />
                                  <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                             Classes.issue="{Binding HasIssue}" ToolTip.Tip="{Binding IssueTip}">
                                    <TextBlock.Styles>
                                      <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ReyTextBrush}" /></Style>
                                      <Style Selector="TextBlock.issue"><Setter Property="Foreground" Value="#FF7B72" /></Style>
                                    </TextBlock.Styles>
                                  </TextBlock>
                                  <Ellipse Width="7" Height="7" Fill="{DynamicResource ReyAccent2Brush}" VerticalAlignment="Center" IsVisible="{Binding IsDirty}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <TextBlock Text="{Binding ShaderName}" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="10" VerticalAlignment="Center" />
                                  <TextBlock Text="{Binding AssignedTo, StringFormat='→ {0}'}" Foreground="{DynamicResource ReyAccentBrush}" FontSize="10" VerticalAlignment="Center" IsVisible="{Binding HasAssignment}" />
                                </StackPanel>

                                <!-- M32: preview profile (features + UV transform) -->
                                <Border Background="{DynamicResource ReyPanelAltBrush}" CornerRadius="3" Padding="6,4">
                                  <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                      <Border Background="{DynamicResource ReyAccentBrush}" CornerRadius="3" Padding="5,1">
                                        <TextBlock Text="{Binding ProfileLabel}" Foreground="#08221E" FontSize="9" FontWeight="SemiBold" />
                                      </Border>
                                      <TextBlock Text="{Binding FeatureSummary}" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="10" VerticalAlignment="Center" />
                                      <Border Background="#4D8A5AF0" CornerRadius="3" Padding="5,1" VerticalAlignment="Center" IsVisible="{Binding UsesSpecular}">
                                        <TextBlock Text="SPECULAR" Foreground="{DynamicResource ReyTextBrush}" FontSize="8" FontWeight="SemiBold" />
                                      </Border>
                                      <TextBlock Text="⚠ profile unresolved" Foreground="#FFB454" FontSize="9" VerticalAlignment="Center" IsVisible="{Binding ProfileUnresolved}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding UvTransformText}" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="10"
                                               ToolTip.Tip="Read from this material's UV parameters — edit them in the parameter list below" />
                                    <TextBlock Text="{Binding UvSourceText}" Foreground="{DynamicResource ReyAccentBrush}" FontSize="9" IsVisible="{Binding HasUvSource}" />
                                    <TextBlock Text="{Binding RenderModeLabel, StringFormat='Blend mode: {0}'}" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="10" />

                                    <!-- M106: the pass's REAL fields — these write straight into the .bin. -->
                                    <StackPanel Spacing="2" Margin="0,4,0,0" IsVisible="{Binding CanEditRenderState}">
                                      <TextBlock Text="RENDER STATE" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource ReyTextDimBrush}" />
                                      <CheckBox Content="Cull back faces (off = two-sided)" IsChecked="{Binding CullEnable}" FontSize="9"
                                                ToolTip.Tip="pass.cullEnable — also what drives Two-Sided Lighting below" />
                                      <CheckBox Content="Alpha blending (blendEnable)" IsChecked="{Binding BlendEnable}" FontSize="9"
                                                ToolTip.Tip="pass.blendEnable — the material's own transparency flag" />
                                      <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,0">
                                        <TextBlock Grid.Column="0" Text="Src blend" FontSize="9" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ReyTextDimBrush}" Margin="0,0,6,0" />
                                        <ComboBox Grid.Column="1" FontSize="9" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding BlendFactorNames}" SelectedIndex="{Binding SrcColorBlendFactor}"
                                                  ToolTip.Tip="Riot blend factor. Map22 shadow receivers use 4 (DstColor); normal alpha materials use 6 (SrcAlpha)." />
                                      </Grid>
                                      <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Grid.Column="0" Text="Dst blend" FontSize="9" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource ReyTextDimBrush}" Margin="0,0,6,0" />
                                        <ComboBox Grid.Column="1" FontSize="9" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding BlendFactorNames}" SelectedIndex="{Binding DstColorBlendFactor}"
                                                  ToolTip.Tip="Sets both the colour and alpha destination factor" />
                                      </Grid>
                                    </StackPanel>

                                    <!-- Derived read-outs: nothing in the .bin stores these, so they can't be
                                         edited directly — they follow the fields above plus the shader name and
                                         the AlphaTestValue / UV parameters. -->
                                    <TextBlock Text="DERIVED (no .bin field — change the inputs named below)" FontSize="8" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ReyTextDimBrush}" Margin="0,5,0,0" />
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                      <TextBlock Grid.Row="0" Grid.Column="0" Text="Culling" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="9" Margin="0,0,10,0" />
                                      <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CullEnabledText}" Foreground="{DynamicResource ReyTextBrush}" FontSize="9" />
                                      <TextBlock Grid.Row="1" Grid.Column="0" Text="Depth Write" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="9" Margin="0,0,10,0" />
                                      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DepthWriteText}" Foreground="{DynamicResource ReyTextBrush}" FontSize="9"
                                                 ToolTip.Tip="Follows the blend mode: transparent and transparent-cutout materials don't write depth" />
                                      <TextBlock Grid.Row="2" Grid.Column="0" Text="Alpha Cutout" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="9" Margin="0,0,10,0" />
                                      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AlphaCutoutText}" Foreground="{DynamicResource ReyTextBrush}" FontSize="9"
                                                 ToolTip.Tip="Threshold comes from the AlphaTestValue parameter — edit it in the parameter list below" />
                                      <TextBlock Grid.Row="3" Grid.Column="0" Text="Two-Sided Lighting" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="9" Margin="0,0,10,0" />
                                      <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TwoSidedText}" Foreground="{DynamicResource ReyTextBrush}" FontSize="9"
                                                 ToolTip.Tip="Active when back-face culling is off — untick 'Cull back faces' above" />
                                    </Grid>
                                  </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Spacing="4">
                                  <Button Classes="tool" Content="Copy name" Command="{Binding CopyNameCommand}" />
                                  <Button Classes="tool" Content="Revert material" Command="{Binding RevertCommand}" />
                                  <Button Classes="tool" Content="+ Add Sampler" Command="{Binding AddSamplerCommand}" IsVisible="{Binding CanEditSamplers}" />
                                </StackPanel>

                                <!-- M52: shader selector — swap the pass shader; missing sampler slots the
                                     target shader uses (learned from this document's materials) are auto-added -->
                                <StackPanel Spacing="2" Margin="0,4,0,0" IsVisible="{Binding CanChangeShader}">
                                  <TextBlock Text="Shader" FontSize="9" Foreground="{DynamicResource ReyTextDimBrush}" />
                                  <Grid ColumnDefinitions="*,Auto">
                                    <AutoCompleteBox Grid.Column="0" Text="{Binding EditedShader}" FontSize="10"
                                                     ItemsSource="{Binding Owner.KnownShaders}" FilterMode="Contains"
                                                     Watermark="Shaders/StaticMesh/…" />
                                    <Button Grid.Column="1" Content="Set" Command="{Binding ApplyShaderCommand}" FontSize="10" Padding="7,1" Margin="3,0,0,0"
                                            ToolTip.Tip="Switch to this shader and auto-add the sampler slots materials of that shader use" />
                                  </Grid>
                                  <Button Classes="tool" Content="Use most-used Riot material setup"
                                          Command="{Binding ApplyCommonShaderSetupCommand}"
                                          IsVisible="{Binding HasShaderDef}" HorizontalAlignment="Stretch"
                                          ToolTip.Tip="Loads real materials from the installed patch, selects the most frequent parameter/switch/macro/render-state setup for this shader, and keeps your texture paths." />
                                  <TextBlock Text="{Binding ShaderChangeStatus}" FontSize="9" Foreground="{DynamicResource ReyAccentBrush}"
                                             TextWrapping="Wrap" IsVisible="{Binding ShaderChangeStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                  <!-- M103: what the SELECTED shader declares. These are the samplers /
                                       parameters the shader supports that this material doesn't bind yet —
                                       one click adds them with the shader's own default values. -->
                                  <TextBlock Text="{Binding ShaderDefSummary}" FontSize="9" TextWrapping="Wrap"
                                             Foreground="{DynamicResource ReyTextDimBrush}"
                                             IsVisible="{Binding ShaderDefSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                  <StackPanel Spacing="2" Margin="0,3,0,0" IsVisible="{Binding HasMissingSamplers}">
                                    <TextBlock Text="SAMPLERS THIS SHADER SUPPORTS" FontSize="8" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ReyTextDimBrush}" />
                                    <ItemsControl ItemsSource="{Binding MissingSamplers}">
                                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                          <Button Classes="tool" FontSize="9" Margin="0,0,3,3"
                                                  Content="{Binding Name, StringFormat='+ {0}'}"
                                                  ToolTip.Tip="{Binding DefaultTexturePath}"
                                                  Command="{Binding $parent[ItemsControl].DataContext.AddShaderSamplerCommand}"
                                                  CommandParameter="{Binding}" />
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </StackPanel>

                                  <StackPanel Spacing="2" IsVisible="{Binding HasMissingParameters}">
                                    <TextBlock Text="PARAMETERS THIS SHADER SUPPORTS" FontSize="8" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ReyTextDimBrush}" />
                                    <ItemsControl ItemsSource="{Binding MissingParameters}">
                                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                          <Button Classes="tool" FontSize="9" Margin="0,0,3,3"
                                                  Content="{Binding Name, StringFormat='+ {0}'}"
                                                  ToolTip.Tip="{Binding DefaultText, StringFormat='default {0}'}"
                                                  Command="{Binding $parent[ItemsControl].DataContext.AddShaderParameterCommand}"
                                                  CommandParameter="{Binding}" />
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </StackPanel>

                                  <!-- M103: the material's own feature switches, editable. An entry with no
                                       explicit 'on' field counts as enabled, so unticking one writes the
                                       field rather than removing the entry. -->
                                  <StackPanel Spacing="2" Margin="0,3,0,0" IsVisible="{Binding HasSwitches}">
                                    <TextBlock Text="FEATURE SWITCHES" FontSize="8" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ReyTextDimBrush}" />
                                    <ItemsControl ItemsSource="{Binding Switches}">
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                          <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,1">
                                            <CheckBox Grid.Column="0" Content="{Binding Name}" IsChecked="{Binding IsOn}" FontSize="9" />
                                            <Ellipse Grid.Column="1" Width="6" Height="6" VerticalAlignment="Center" Margin="3,0"
                                                     Fill="{DynamicResource ReyAccent2Brush}" IsVisible="{Binding IsDirty}" />
                                            <Button Grid.Column="2" Classes="tool" Content="✕" FontSize="8" Padding="4,0"
                                                    Command="{Binding RemoveCommand}" ToolTip.Tip="Remove this switch" />
                                          </Grid>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </StackPanel>

                                  <StackPanel Spacing="2" IsVisible="{Binding HasShaderSwitches}">
                                    <TextBlock Text="FEATURE SWITCHES THIS SHADER SUPPORTS" FontSize="8" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ReyTextDimBrush}" />
                                    <ItemsControl ItemsSource="{Binding ShaderSwitches}">
                                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                          <Button Classes="tool" FontSize="9" Margin="0,0,3,3"
                                                  Content="{Binding StringFormat='+ {0}'}"
                                                  Command="{Binding $parent[ItemsControl].DataContext.AddShaderSwitchCommand}"
                                                  CommandParameter="{Binding}" />
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </StackPanel>

                                  <!-- M150: shaderMacros — the defines that decide how a surface reacts to the
                                       SCENE (lightmap / fog), separate from the feature switches above. -->
                                  <StackPanel Spacing="2" Margin="0,3,0,0" IsVisible="{Binding HasMacros}">
                                    <TextBlock Text="SHADER MACROS" FontSize="8" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ReyTextDimBrush}" />
                                    <ItemsControl ItemsSource="{Binding Macros}">
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                          <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,1">
                                            <CheckBox Grid.Column="0" Content="{Binding Name}" IsChecked="{Binding IsOn}" FontSize="9"
                                                      ToolTip.Tip="{Binding Hint}" />
                                            <Ellipse Grid.Column="1" Width="6" Height="6" VerticalAlignment="Center" Margin="3,0"
                                                     Fill="{DynamicResource ReyAccent2Brush}" IsVisible="{Binding IsDirty}" />
                                            <Button Grid.Column="2" Classes="tool" Content="✕" FontSize="8" Padding="4,0"
                                                    Command="{Binding RemoveCommand}"
                                                    ToolTip.Tip="Remove the define entirely — not the same as unticking it, which writes 0. Absent means the shader's own default applies." />
                                          </Grid>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </StackPanel>

                                  <StackPanel Spacing="2" IsVisible="{Binding HasMissingMacros}">
                                    <TextBlock Text="ADD SHADER MACRO" FontSize="8" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ReyTextDimBrush}" />
                                    <TextBlock Text="Macros select precompiled DX11 permutations. Unsupported combinations can crash in-game."
                                               FontSize="8" TextWrapping="Wrap" Foreground="#FFB454" />
                                    <ItemsControl ItemsSource="{Binding MissingMacros}">
                                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                          <Button Classes="tool" FontSize="9" Margin="0,0,3,3"
                                                  Content="{Binding StringFormat='+ {0}'}"
                                                  Command="{Binding $parent[ItemsControl].DataContext.AddMacroCommand}"
                                                  CommandParameter="{Binding}" />
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </StackPanel>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Slots}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <StackPanel Spacing="2" Margin="0,4,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                          <TextBlock Text="{Binding SamplerName}" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="10" MinWidth="110" VerticalAlignment="Center" />
                                          <Ellipse Width="6" Height="6" Fill="{DynamicResource ReyAccentBrush}" VerticalAlignment="Center" IsVisible="{Binding IsDiffuse}" ToolTip.Tip="Diffuse" />
                                          <TextBlock Text="⚠" Foreground="#FFB454" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding Unresolved}" ToolTip.Tip="Path not found in this WAD" />
                                          <TextBlock Text="?" Foreground="#FFB454" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding NotInShader}"
                                                     ToolTip.Tip="The selected shader declares no sampler by this name — it will be ignored" />
                                          <Ellipse Width="6" Height="6" Fill="{DynamicResource ReyAccent2Brush}" VerticalAlignment="Center" IsVisible="{Binding IsDirty}" />
                                        </StackPanel>
                                        <!-- M96: star-sized so long paths shrink the textbox instead of pushing ✓/↺ off the panel -->
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                          <TextBox Grid.Column="0" Text="{Binding EditedPath}" FontSize="10" Padding="4,1" FontFamily="Cascadia Mono, Consolas, monospace">
                                            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding ApplyCommand}" /></TextBox.KeyBindings>
                                          </TextBox>
                                          <Button Grid.Column="1" Content="✓" Command="{Binding ApplyCommand}" FontSize="10" Padding="5,0" Margin="3,0,0,0" ToolTip.Tip="Apply path" />
                                          <Button Grid.Column="2" Content="↺" Command="{Binding RevertCommand}" FontSize="10" Padding="5,0" Margin="3,0,0,0" ToolTip.Tip="Revert" />
                                        </Grid>
                                        <!-- M96: wraps instead of clipping when the inspector is narrow -->
                                        <WrapPanel>
                                          <Button Classes="tool" Content="Preview" Command="{Binding PreviewCommand}" Margin="0,0,4,2"
                                                  ToolTip.Tip="Show / hide the inline thumbnail" />
                                          <Button Classes="tool" Content="Open" Command="{Binding OpenCommand}" Margin="0,0,4,2" />
                                          <Button Classes="tool" Content="Copy" Command="{Binding CopyPathCommand}" Margin="0,0,4,2" />
                                          <Button Classes="tool" Content="Replace Texture…" Command="{Binding ReplaceCommand}" Margin="0,0,4,2" />
                                          <Button Classes="tool" Content="✕" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}" Margin="0,0,4,2" ToolTip.Tip="Remove this sampler" />
                                        </WrapPanel>
                                        <Border Background="{DynamicResource ReyBgBrush}" CornerRadius="3" Padding="3" HorizontalAlignment="Left" IsVisible="{Binding HasThumbnail}">
                                          <Image Source="{Binding Thumbnail}" Stretch="Uniform" MaxHeight="96" MaxWidth="96" />
                                        </Border>
                                      </StackPanel>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Expander Header="Parameters" IsVisible="{Binding HasParameters}" FontSize="11" Margin="0,4,0,0">
                                  <StackPanel>
                                  <!-- M55: add a parameter (clones an existing one's schema; edit the value after) -->
                                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4" IsVisible="{Binding CanEditParameters}">
                                    <TextBox Grid.Column="0" Text="{Binding NewParamName}" Watermark="new param name (e.g. AlphaTestValue)"
                                             FontSize="10" Padding="4,1">
                                      <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding AddParameterCommand}" /></TextBox.KeyBindings>
                                    </TextBox>
                                    <Button Grid.Column="1" Content="+ Add" Command="{Binding AddParameterCommand}" FontSize="10" Padding="6,1" Margin="3,0,0,0"
                                            ToolTip.Tip="Add a parameter (value type is cloned from this material's first param — edit it after)" />
                                  </Grid>
                                  <ItemsControl ItemsSource="{Binding Parameters}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                          <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="10" MinWidth="110" VerticalAlignment="Center" />
                                          <!-- M50c: live colour swatch for Tint/Color params -->
                                          <Border Width="16" Height="16" CornerRadius="3" BorderThickness="1" VerticalAlignment="Center"
                                                  BorderBrush="{DynamicResource ReyBorderBrush}" IsVisible="{Binding IsColorLike}"
                                                  Background="{Binding EditedText, Converter={x:Static conv:VecColorBrushConverter.Instance}}"
                                                  ToolTip.Tip="Colour preview (r, g, b as 0..1)" />
                                          <TextBox Text="{Binding EditedText}" MinWidth="150" FontSize="10" Padding="4,1" IsEnabled="{Binding IsEditable}" FontFamily="Cascadia Mono, Consolas, monospace">
                                            <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding ApplyCommand}" /></TextBox.KeyBindings>
                                          </TextBox>
                                          <Button Content="✓" Command="{Binding ApplyCommand}" FontSize="10" Padding="5,0" />
                                          <Button Content="↺" Command="{Binding RevertCommand}" FontSize="10" Padding="5,0" />
                                          <Button Content="✕" FontSize="10" Padding="5,0" IsVisible="{Binding IsRemovable}"
                                                  Command="{Binding $parent[ItemsControl].DataContext.RemoveParameterCommand}"
                                                  CommandParameter="{Binding}" ToolTip.Tip="Remove this parameter" />
                                          <Ellipse Width="6" Height="6" Fill="{DynamicResource ReyAccent2Brush}" VerticalAlignment="Center" IsVisible="{Binding IsDirty}" />
                                          <TextBlock Text="{Binding ErrorText}" Foreground="#FF6B6B" FontSize="9" VerticalAlignment="Center" IsVisible="{Binding HasError}" />
                                        </StackPanel>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                  </StackPanel>
                                </Expander>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ContentControl.ContentTemplate>
                        </ContentControl>
                      </Grid>
                    </StackPanel>
                  </ScrollViewer>
                </TabItem>

                <!-- RAW BIN TREE TAB -->
                <TabItem FontSize="12" IsVisible="{Binding BinEditor.HasBin}">
                  <TabItem.Header><TextBlock Text="Raw BIN Tree" FontSize="12" /></TabItem.Header>

              <!-- bin editor (M7) -->
              <StackPanel Spacing="6" Margin="0,8,0,0" IsVisible="{Binding BinEditor.HasBin}">
                <Border Height="1" Background="{DynamicResource ReyBorderBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="BIN EDITOR" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Ellipse Width="7" Height="7" Fill="{DynamicResource ReyAccent2Brush}" VerticalAlignment="Center"
                           IsVisible="{Binding BinEditor.IsDirty}" ToolTip.Tip="Unsaved edits" />
                </StackPanel>
                <TextBlock Text="{Binding BinEditor.Summary}" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="11" />
                <TextBox Watermark="Filter field names…" Text="{Binding BinEditor.Filter}" FontSize="11" Padding="4,2" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button Classes="tool" Content="Revert File" Command="{Binding BinEditor.RevertFileCommand}" />
                  <Button Classes="tool" Content="Save To Override" Command="{Binding SaveBinToOverrideCommand}" />
                  <Button Classes="tool" Content="Export BIN…" Command="{Binding ExportEditedBinCommand}" />
                </StackPanel>
                <TreeView ItemsSource="{Binding BinEditor.Roots}" Background="Transparent" BorderThickness="0" MaxHeight="560">
                  <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}">
                      <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsVisible}">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ReyTextBrush}"
                                   FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TypeName}" Foreground="{DynamicResource ReyTextDimBrush}"
                                   FontSize="10" VerticalAlignment="Center" IsVisible="{Binding IsBranch}" />
                        <!-- editable primitive -->
                        <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{Binding IsEditable}">
                          <TextBox Text="{Binding EditedText}" MinWidth="150" FontSize="11" Padding="4,1"
                                   FontFamily="Cascadia Mono, Consolas, monospace">
                            <TextBox.KeyBindings>
                              <KeyBinding Gesture="Enter" Command="{Binding ApplyCommand}" />
                            </TextBox.KeyBindings>
                          </TextBox>
                          <Button Content="✓" Command="{Binding ApplyCommand}" FontSize="10" Padding="5,0" ToolTip.Tip="Apply edit" />
                          <Button Content="↺" Command="{Binding RevertCommand}" FontSize="10" Padding="5,0" ToolTip.Tip="Revert field" />
                          <Ellipse Width="7" Height="7" Fill="{DynamicResource ReyAccent2Brush}" VerticalAlignment="Center" IsVisible="{Binding IsDirty}" />
                          <TextBlock Text="{Binding ErrorText}" Foreground="#FF6B6B" FontSize="10" VerticalAlignment="Center" IsVisible="{Binding HasError}" />
                        </StackPanel>
                        <!-- read-only leaf value -->
                        <TextBlock Text="{Binding OriginalText}" Foreground="{DynamicResource ReyAccentBrush}"
                                   FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" VerticalAlignment="Center"
                                   IsVisible="{Binding IsReadOnlyValue}" />
                        <StackPanel.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Copy Field Path" Command="{Binding CopyPathCommand}" />
                            <MenuItem Header="Copy Field Hash" Command="{Binding CopyHashCommand}" />
                            <MenuItem Header="Copy Value" Command="{Binding CopyValueCommand}" />
                          </ContextMenu>
                        </StackPanel.ContextMenu>
                      </StackPanel>
                    </TreeDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>
              </StackPanel>
                </TabItem>
              </TabControl>
              </Expander>
</UserControl>
