<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ReyEngine.App.Views.ReyTitleBar"
             Height="34">
  <!-- M82: shared custom title bar for secondary windows — same chrome as the main window.
       M578: the host sets WindowDecorations="BorderOnly" now, so there is no native caption to overlay
       and no 150px reserve to keep clear. These buttons ARE the caption; without them these windows
       would have no way to close. -->
  <Border Background="{DynamicResource ReyHeaderBrush}" BorderBrush="{DynamicResource ReyBorderBrush}"
          BorderThickness="0,0,0,1" PointerPressed="OnDrag">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="12,0,8,0" VerticalAlignment="Center">
        <Image x:Name="Logo" Height="16" VerticalAlignment="Center" />
        <TextBlock Text="REYENGINE" FontSize="10" FontWeight="Bold" LetterSpacing="1.5"
                   Foreground="{DynamicResource ReyTextBrightBrush}" VerticalAlignment="Center" />
        <Border Width="1" Height="10" Background="{DynamicResource ReyBorderAccentBrush}" VerticalAlignment="Center" />
        <TextBlock x:Name="TitleText" FontSize="10" Foreground="{DynamicResource ReyTextDimBrush}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
        <Button Classes="caption" Content="&#x2500;" Height="34" Click="OnMinimise" ToolTip.Tip="Minimise" />
        <Button Classes="caption" x:Name="MaximiseButton" Content="&#x2610;" Height="34"
                Click="OnMaximise" ToolTip.Tip="Maximise" />
        <Button Classes="caption close" Content="&#x2715;" Height="34" Click="OnClose" ToolTip.Tip="Close" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
