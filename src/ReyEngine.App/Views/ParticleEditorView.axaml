<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ReyEngine.App.Views"
             xmlns:vm="clr-namespace:ReyEngine.App.ViewModels"
             x:Class="ReyEngine.App.Views.ParticleEditorView"
             x:DataType="vm:ParticleEditorViewModel">
  <!-- M46 Particle Editor (Particle Town layout): toolbar / tree / emitter cards / inspector / curves+preview -->
  <Border Background="{DynamicResource ReyBgBrush}">
    <DockPanel>

      <!-- toolbar -->
      <Border DockPanel.Dock="Top" Background="{DynamicResource ReyHeaderBrush}"
              BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="{Binding Status}" FontSize="10" Opacity="0.7" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="✨ PARTICLE EDITOR" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource ReyAccentBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding AssetName}" FontSize="11" Opacity="0.85" VerticalAlignment="Center" />
            <Border Classes="badge" IsVisible="{Binding !IsEditable}">
              <TextBlock Text="READ-ONLY" FontSize="9" />
            </Border>
            <Button Classes="tool" Content="💾 Save Override" Command="{Binding SaveOverrideCommand}"
                    IsEnabled="{Binding IsEditable}" ToolTip.Tip="Write the edited particle .bin to the project override" />
            <!-- M125: this bin needed repairs while loading — details + fix in the Issues window -->
            <Button Classes="tool" Content="{Binding BinIssuesLabel}" Foreground="{DynamicResource ReyErrorBrush}"
                    Command="{Binding ShowIssuesCommand}" IsVisible="{Binding HasBinIssues}"
                    ToolTip.Tip="Problems were repaired while reading this bin — affected systems are marked red. Click for details and a one-click fix." />
            <Button Classes="tool" Content="⟲ Restart" Command="{Binding RestartCommand}" ToolTip.Tip="Restart the preview simulation" />
            <ToggleButton Classes="vp" Content="⏯ Pause" IsChecked="{Binding Paused}" />
            <Button Classes="tool" Content="⏹ Stop" Command="{Binding StopEmittingCommand}"
                    ToolTip.Tip="Stop emitting and play the Linger shutdown curves (Restart to run again)" />
            <ToggleButton Classes="vp" Content="↻ Auto-stop" IsChecked="{Binding AutoStop}"
                          ToolTip.Tip="Loop as run → stop → linger → restart, so the shutdown curves play every cycle" />
            <TextBlock Text="Speed" FontSize="10" Opacity="0.7" VerticalAlignment="Center" />
            <Slider Minimum="0.1" Maximum="3" Value="{Binding Speed}" Width="110" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Speed, StringFormat={}{0:0.0}x}" FontSize="10" Width="30" VerticalAlignment="Center" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- M716: two rows. The top one is the list, the emitters and the details; the bottom one is
           the curve editor and the 3D view, both full width. MinWidth and MinHeight on every real
           pane for the reason MainWindow gives at its own splitters: without them a drag collapses
           a pane into a layout that cannot be dragged back. -->
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="200" />
          <RowDefinition Height="4" />
          <RowDefinition Height="300" MinHeight="140" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" MinWidth="150" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" MinWidth="260" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="290" MinWidth="200" />
          </Grid.ColumnDefinitions>

        <!-- left: system / emitter tree -->
        <Border Grid.Column="0" Background="{DynamicResource ReyPanelBrush}">
          <DockPanel>
            <TextBlock Classes="panelHeader" DockPanel.Dock="Top" Text="SYSTEMS" />
            <!-- M197 (4.5): map VFX bins carry thousands of systems; a flat list is unusable without this -->
            <TextBox DockPanel.Dock="Top" Text="{Binding SystemFilter, Mode=TwoWay}" Margin="4,3"
                     FontSize="10" Padding="4,2" PlaceholderText="Filter systems..." />
            <ListBox ItemsSource="{Binding Systems}" SelectedItem="{Binding SelectedSystem}"
                     Background="Transparent" Padding="2">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ParticleSystemNodeViewModel">
                  <StackPanel Margin="2" ToolTip.Tip="{Binding IssueTip}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <!-- M125: red name + ⚠ when this system's bin object needed repairs -->
                      <TextBlock Text="⚠" Foreground="{DynamicResource ReyErrorBrush}" FontSize="10" VerticalAlignment="Center"
                                 IsVisible="{Binding HasIssue}" />
                      <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis"
                                 Classes.issue="{Binding HasIssue}">
                        <TextBlock.Styles>
                          <Style Selector="TextBlock.issue"><Setter Property="Foreground" Value="{DynamicResource ReyErrorBrush}" /></Style>
                        </TextBlock.Styles>
                      </TextBlock>
                    </StackPanel>
                    <TextBlock Text="{Binding Detail}" FontSize="9" Opacity="0.55" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
        <GridSplitter Grid.Column="1" Background="{DynamicResource ReyBorderBrush}" />

        <!-- center: emitter cards (horizontal, Particle Town style) -->
        <Border Grid.Column="2" Background="{DynamicResource ReyBgBrush}">
          <DockPanel>
            <TextBlock Classes="panelHeader" DockPanel.Dock="Top" Text="EMITTERS" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Cards}" Margin="6">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ParticleEmitterCardViewModel">
                  <Border Classes="card" Width="215" Padding="0" VerticalAlignment="Top">
                    <DockPanel>
                      <Border DockPanel.Dock="Top" Background="{DynamicResource ReyHeaderBrush}" Padding="8,5">
                        <DockPanel>
                          <!-- M49: emitter on/off — edits the emitter's 'disabled' flag (persists via Save Override) -->
                          <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsEnabled}" Padding="0" Margin="0,0,6,0"
                                    MinWidth="0" VerticalAlignment="Center" IsVisible="{Binding ShowToggle}"
                                    ToolTip.Tip="Enable/disable this emitter (edits the 'disabled' flag; Save Override to persist)" />
                          <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center" />
                        </DockPanel>
                      </Border>
                      <!-- particle sprite preview (Particle Town texture strip) -->
                      <Border DockPanel.Dock="Top" Background="{DynamicResource ReyBgBrush}" Height="52" IsVisible="{Binding HasThumbnail}">
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="3" />
                      </Border>
                      <ScrollViewer VerticalScrollBarVisibility="Auto">
                       <StackPanel>
                        <ItemsControl ItemsSource="{Binding Modules}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ParticleModuleGroupViewModel">
                              <Expander Header="{Binding Name}" FontSize="10" IsExpanded="False" Padding="0" Margin="0">
                                <ItemsControl ItemsSource="{Binding Rows}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ParticlePropertyRowViewModel">
                                      <!-- M189: rows nested inside a definition struct are indented by depth -->
                                      <Button Background="Transparent" BorderThickness="0" Padding="6,2"
                                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                              Command="{Binding SelectCommand}">
                                        <DockPanel Margin="{Binding Indent}">
                                          <!-- M651: one item of a list. Duplicate clones what Riot wrote, so the
                                               new item is valid before anything is changed in it; remove refuses
                                               the last one, because Riot ships no empty container anywhere and an
                                               empty one crashes the game at map load. -->
                                          <Button DockPanel.Dock="Right" Content="✕" FontSize="8" Padding="3,0"
                                                  Background="Transparent" BorderThickness="0" Margin="2,0,0,0"
                                                  IsVisible="{Binding IsListItem}" IsEnabled="{Binding CanRemoveItem}"
                                                  Command="{Binding RemoveItemCommand}" ToolTip.Tip="{Binding RemoveItemTip}" />
                                          <Button DockPanel.Dock="Right" Content="⧉" FontSize="8" Padding="3,0"
                                                  Background="Transparent" BorderThickness="0"
                                                  IsVisible="{Binding IsListItem}"
                                                  Command="{Binding DuplicateItemCommand}" ToolTip.Tip="{Binding DuplicateItemTip}" />
                                          <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentText}" FontSize="9"
                                                     Opacity="0.6" MaxWidth="80" TextTrimming="CharacterEllipsis" />
                                          <!-- M191: the preview does not show this field's effect -->
                                          <TextBlock DockPanel.Dock="Left" Text="○" FontSize="8" Opacity="0.45"
                                                     Margin="0,0,3,0" VerticalAlignment="Center"
                                                     IsVisible="{Binding IgnoredByPreview}"
                                                     ToolTip.Tip="{Binding PreviewNote}" />
                                          <TextBlock Text="{Binding Name}" FontSize="10" />
                                        </DockPanel>
                                      </Button>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </Expander>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- M368: what this object does NOT set. Collapsed by default and hidden entirely
                             when the meta-class database was never synced, so the card is unchanged for
                             anyone who has not opted in. Read-only: it reports the game's fallback value,
                             it does not add the field. -->
                        <Expander FontSize="10" IsExpanded="False" Padding="0" Margin="0"
                                  IsVisible="{Binding Schema.HasSchema}"
                                  ToolTip.Tip="Declared by the class but absent from this object — the game uses the default shown">
                          <Expander.Header>
                            <TextBlock Text="{Binding Schema.Summary}" FontSize="10" Opacity="0.75" />
                          </Expander.Header>
                          <StackPanel>
                            <TextBlock Text="{Binding Schema.ClassDisplayName}" FontSize="9" Opacity="0.5"
                                       Margin="6,2,6,4" TextTrimming="CharacterEllipsis" />
                            <ItemsControl ItemsSource="{Binding Schema.UnsetRows}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MetaSchemaRowViewModel">
                                  <DockPanel Margin="6,2">
                                    <!-- M370: write the field at the schema's own default. -->
                                    <Button DockPanel.Dock="Right" Classes="tool" Content="+" FontSize="9"
                                            Padding="4,0" Margin="3,0,0,0" MinWidth="0"
                                            Command="{Binding AddCommand}" IsEnabled="{Binding CanAdd}"
                                            IsVisible="{Binding !Added}" ToolTip.Tip="{Binding AddTip}" />
                                    <TextBlock DockPanel.Dock="Right" Text="added" FontSize="8" Opacity="0.6"
                                               Margin="3,0,0,0" VerticalAlignment="Center"
                                               IsVisible="{Binding Added}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding DefaultText}" FontSize="9"
                                               Opacity="0.55" MaxWidth="80" TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding DefaultText}" />
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding TypeName}" FontSize="8"
                                               Opacity="0.4" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontSize="10" Opacity="0.7"
                                               ToolTip.Tip="{Binding Error}" />
                                  </DockPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Expander>
                       </StackPanel>
                      </ScrollViewer>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Column="3" Background="{DynamicResource ReyBorderBrush}" />

        <!-- right: property inspector -->
        <Border Grid.Column="4" Background="{DynamicResource ReyPanelBrush}">
          <DockPanel>
            <TextBlock Classes="panelHeader" DockPanel.Dock="Top" Text="DETAILS" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="10" Spacing="6" IsVisible="{Binding SelectedProperty, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding SelectedProperty.Name, FallbackValue=''}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Border Classes="badge"><TextBlock Text="{Binding SelectedProperty.Module, FallbackValue=''}" FontSize="9" /></Border>
                  <TextBlock Text="{Binding SelectedProperty.TypeName, FallbackValue=''}" FontSize="10" Opacity="0.6" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Value" FontSize="10" Opacity="0.7" Margin="0,6,0,0" />
                <TextBox Text="{Binding SelectedProperty.EditText, Mode=TwoWay}" FontSize="11"
                         IsEnabled="{Binding SelectedProperty.IsReadOnly, Converter={x:Static BoolConverters.Not}, FallbackValue=False}"
                         AcceptsReturn="False" />
                <Button Classes="primary" Content="Apply" HorizontalAlignment="Left"
                        Command="{Binding ApplyEditCommand}" CommandParameter="{Binding SelectedProperty}"
                        IsEnabled="{Binding SelectedProperty.IsReadOnly, Converter={x:Static BoolConverters.Not}, FallbackValue=False}" />
                <TextBlock Text="{Binding SelectedProperty.ErrorText, FallbackValue=''}" FontSize="10"
                           Foreground="{DynamicResource ReyErrorBrush}" TextWrapping="Wrap"
                           IsVisible="{Binding SelectedProperty.ErrorText, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />
                <TextBlock Text="{Binding SelectedProperty.ReadOnlyReason, FallbackValue=''}" FontSize="10" Opacity="0.5" TextWrapping="Wrap"
                           IsVisible="{Binding SelectedProperty.IsReadOnly, FallbackValue=False}" />
                <!-- M191 (3.7): editable, saved, but not visible in the preview -->
                <Border Background="{DynamicResource ReyWarningSoftBrush}" BorderBrush="{DynamicResource ReyWarningBrush}" BorderThickness="1" CornerRadius="3"
                        Padding="6,4" Margin="0,8,0,0"
                        IsVisible="{Binding SelectedProperty.IgnoredByPreview, FallbackValue=False}">
                  <StackPanel Spacing="2">
                    <TextBlock Text="○ NOT SHOWN IN THE PREVIEW" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource ReyWarningBrush}" />
                    <TextBlock Text="{Binding SelectedProperty.PreviewNote, FallbackValue=''}" FontSize="10"
                               Opacity="0.75" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <TextBlock FontSize="10" Opacity="0.5" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="Vectors: comma-separated (x, y, z). Colours: r, g, b, a (0..1). Edits update the preview immediately; Save Override writes to the project." />
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
        </Grid>

        <GridSplitter Grid.Row="1" Background="{DynamicResource ReyBorderBrush}" />

        <!-- M716: the bottom row, full width - the curve editor beside the 3D view, the shape
             Cascade has. Both were squeezed into the centre column before, which left the curve
             plot a third of the window wide and the preview smaller than one emitter card. -->
        <Grid Grid.Row="2" ColumnDefinitions="*,4,620">
          <Border Grid.Column="0" Background="{DynamicResource ReyPanelBrush}">
            <DockPanel>
              <TextBlock Classes="panelHeader" DockPanel.Dock="Top" Text="CURVE EDITOR (over particle lifetime)" />
              <!-- M190 (3.6): the keys are editable, in the list to the right of the plot -->
              <Grid ColumnDefinitions="*,4,210">
                <Grid Grid.Column="0">
                  <views:CurvePreview Times="{Binding SelectedProperty.CurveTimes, FallbackValue={x:Null}}"
                                      Channels="{Binding SelectedProperty.CurveChannels, FallbackValue={x:Null}}"
                                      Margin="6" />
                  <TextBlock Text="Select a property with a curve (name shows '+ curve')" FontSize="10" Opacity="0.4"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsVisible="{Binding SelectedProperty.HasCurve, FallbackValue=True, Converter={x:Static BoolConverters.Not}}" />
                </Grid>
                <GridSplitter Grid.Column="1" Background="{DynamicResource ReyBorderBrush}" />
                <DockPanel Grid.Column="2" IsVisible="{Binding SelectedProperty.HasCurve, FallbackValue=False}">
                  <DockPanel DockPanel.Dock="Top" Margin="4,3">
                    <Button DockPanel.Dock="Right" Classes="tool" Content="+ Key" FontSize="9" Padding="6,1"
                            Command="{Binding SelectedProperty.AddCurveKeyCommand}"
                            IsEnabled="{Binding SelectedProperty.CanEditCurve, FallbackValue=False}"
                            ToolTip.Tip="Add a key halfway through the curve" />
                    <TextBlock Text="KEYS (time / value)" FontSize="9" Opacity="0.6" VerticalAlignment="Center" />
                  </DockPanel>
                  <TextBlock DockPanel.Dock="Bottom" FontSize="9" Opacity="0.5" TextWrapping="Wrap" Margin="4,2"
                             Text="Read-only bin: Copy To Project to edit keys."
                             IsVisible="{Binding SelectedProperty.CanEditCurve, FallbackValue=False, Converter={x:Static BoolConverters.Not}}" />
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SelectedProperty.CurveKeys}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ParticleCurveKeyViewModel">
                          <DockPanel Margin="4,1">
                            <Button DockPanel.Dock="Right" Classes="tool" Content="x" FontSize="9" Padding="4,0"
                                    Command="{Binding DeleteKeyCommand}"
                                    ToolTip.Tip="Delete this key" />
                            <Button DockPanel.Dock="Right" Classes="tool" Content="✓" FontSize="9" Padding="4,0"
                                    Command="{Binding ApplyKeyCommand}"
                                    ToolTip.Tip="Apply this key" />
                            <TextBox DockPanel.Dock="Left" Text="{Binding TimeText, Mode=TwoWay}" Width="42"
                                     FontSize="9" Padding="3,1" Margin="0,0,3,0" />
                            <TextBox Text="{Binding ValueText, Mode=TwoWay}" FontSize="9" Padding="3,1" Margin="0,0,3,0" />
                          </DockPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </Grid>
            </DockPanel>
          </Border>
          <GridSplitter Grid.Column="1" Background="{DynamicResource ReyBorderBrush}" />
          <Border Grid.Column="2" Background="Black">
            <DockPanel>
            <TextBlock Classes="panelHeader" DockPanel.Dock="Top" Text="3D VIEW" />
            <Grid>
              <views:ViewportControl x:Name="PreviewViewport"
                                     ParticlePlayback="{Binding Playback}"
                                     ParticleSpeed="{Binding Speed}"
                                     ParticlePaused="{Binding Paused}"
                                     ParticleStopped="{Binding Stopped}"
                                     ParticleAutoStop="{Binding AutoStop}"
                                     ParticleRig="{Binding Rig}" />
              <Border x:Name="PreviewInput" Background="Transparent" />
              <TextBlock Text="LMB orbit · MMB pan · wheel zoom" FontSize="9" Opacity="0.35"
                         Margin="6,4" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
              <!-- M712: the rig. The file does not say where an effect goes, so the reader says it here.
                   Over the viewport rather than in the toolbar, and AFTER PreviewInput so it takes clicks
                   instead of orbiting the camera underneath it. -->
              <Border Classes="card" Padding="10" CornerRadius="6" Margin="8" MinWidth="240"
                      HorizontalAlignment="Right" VerticalAlignment="Top">
                <StackPanel Spacing="5">
                  <TextBlock Text="RIG" FontSize="10" FontWeight="Bold"
                             Foreground="{DynamicResource ReyTextDimBrush}" />
                  <TextBlock Text="How the preview carries this system" FontSize="9" Opacity="0.55"
                             TextWrapping="Wrap" />
                  <Border Background="{DynamicResource ReyPanelAltBrush}" CornerRadius="4" Padding="2">
                    <UniformGrid Columns="4">
                      <ToggleButton Classes="vp" Content="Still" IsChecked="{Binding IsRigStill}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    ToolTip.Tip="It stays where it is put - a buff, an aura, a ground indicator." />
                      <ToggleButton Classes="vp" Content="Burst" IsChecked="{Binding IsRigBurst}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    ToolTip.Tip="Still, but the whole run starts over as soon as it ends." />
                      <ToggleButton Classes="vp" Content="Missile" IsChecked="{Binding IsRigMissile}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    ToolTip.Tip="It flies in a straight line and stops emitting where it lands." />
                      <ToggleButton Classes="vp" Content="Trail" IsChecked="{Binding IsRigTrail}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    ToolTip.Tip="It circles, so a trail or a ribbon has a path to lay itself along." />
                    </UniformGrid>
                  </Border>
                  <!-- M713: which of the two the reader is looking at. The game's own wiring names about
                       56% of systems; the rest fall back to M712's name guess and say so. -->
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Border Classes="badge" IsVisible="{Binding RoleIsAuthored}">
                      <TextBlock Text="FROM THE SPELL RECORD" FontSize="8" />
                    </Border>
                    <Border Classes="badge"
                            IsVisible="{Binding RoleIsAuthored, Converter={x:Static BoolConverters.Not}}">
                      <TextBlock Text="GUESSED FROM THE NAME" FontSize="8" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding RigNote}" FontSize="9" Opacity="0.5" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding RigSpeed, StringFormat='Speed   {0:0} u/s'}" FontSize="10"
                             Opacity="0.7" Margin="0,4,0,0" IsVisible="{Binding IsRigMissile}" />
                  <Slider Minimum="100" Maximum="6000" Value="{Binding RigSpeed}"
                          IsVisible="{Binding IsRigMissile}"
                          ToolTip.Tip="How fast the missile flies. Riot's own speeds run from about 1,200 to 3,000, with a median of 1,750." />
                  <TextBlock Text="{Binding RigHeight, StringFormat='Height   {0:0} u'}" FontSize="10"
                             Opacity="0.7" Margin="0,4,0,0" />
                  <Slider Minimum="0" Maximum="600" Value="{Binding RigHeight}"
                          ToolTip.Tip="How far off the ground the whole rig sits. A champion is 200 units tall." />
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <ToggleButton Classes="vp" Content="Replay" IsChecked="{Binding RigReplay}"
                                  ToolTip.Tip="Start the run over when it ends." />
                    <ToggleButton Classes="vp" Content="Stop mid-run" IsChecked="{Binding RigStopMidRun}"
                                  ToolTip.Tip="Stop emitting halfway through, so the teardown plays without holding Stop." />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="Seed" FontSize="10" Opacity="0.7" VerticalAlignment="Center" />
                    <TextBox Text="{Binding RigSeed}" Width="72" FontSize="10" />
                    <Button Classes="tool" Content="↻" Command="{Binding RerollSeedCommand}"
                            ToolTip.Tip="A different run of the same effect." />
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>
    </DockPanel>
  </Border>
</UserControl>
