<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ReyEngine.App.Views"
        xmlns:vm="clr-namespace:ReyEngine.App.ViewModels"
        xmlns:mat="clr-namespace:ReyEngine.Formats.Materials;assembly=ReyEngine.Formats"
        x:Class="ReyEngine.App.Views.MaterialBrowserWindow"
        x:DataType="vm:MaterialBrowserViewModel"
        Title="ReyEngine — Materials" Width="1420" Height="760"
        MinWidth="1000" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource ReyBgBrush}">
  <DockPanel>
    <views:ReyTitleBar DockPanel.Dock="Top" />

    <!-- filters -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource ReyHeaderBrush}"
            BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="0,0,0,1" Padding="12,7">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="{Binding MapName}" FontSize="11" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="0,0,12,0"
                   Foreground="{DynamicResource ReyTextBrush}" TextTrimming="CharacterEllipsis" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <ComboBox ItemsSource="{Binding SortModes}" SelectedIndex="{Binding SortMode}"
                    FontSize="11" MinWidth="140" VerticalAlignment="Center" />
          <Button Classes="tool" Content="↻ Reload" Command="{Binding ReloadCommand}"
                  FontSize="11" Padding="10,4" ToolTip.Tip="Re-read the map's materials and re-run the checks." />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBox Text="{Binding Filter}" PlaceholderText="filter by name, shader, texture or problem…"
                   FontSize="11" MinWidth="280" Padding="6,2"
                   ToolTip.Tip="Also searches the findings — type 'tint' or 'cooked' to pull up exactly those rows." />
          <CheckBox Content="Only with findings" IsChecked="{Binding OnlyIssues}" FontSize="11"
                    VerticalAlignment="Center" />
          <CheckBox Content="Only used" IsChecked="{Binding OnlyUsed}" FontSize="11"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Hide materials no mesh in this map references." />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- M507: the one problem that stops the map loading outright, with its own repair. Above everything
         else because a skipped container means the game reads a DIFFERENT material than this window shows,
         which makes every other finding below unreliable. -->
    <Border DockPanel.Dock="Top" IsVisible="{Binding HasDropped}" Margin="12,10,12,0" Padding="10,7"
            CornerRadius="5" Background="{DynamicResource ReyCardBrush}"
            BorderBrush="{DynamicResource ReyErrorBrush}" BorderThickness="1">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="primary" Content="Repair" FontSize="11" Padding="16,4"
                Margin="10,0,0,0" VerticalAlignment="Center"
                Command="{Binding RepairWireFormsCommand}"
                ToolTip.Tip="Rewrite the container tags to the form Riot ships. The values inside are moved untouched." />
        <TextBlock Text="{Binding DroppedSummary}" FontSize="11" TextWrapping="Wrap"
                   VerticalAlignment="Center" Foreground="{DynamicResource ReyErrorBrush}" />
      </DockPanel>
    </Border>

    <!-- actions + summary -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource ReyHeaderBrush}"
            BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <!-- M675: the cleanup. Ticks narrow it; the bin's object graph decides what is really unreachable. -->
          <Button Classes="tool" Content="{Binding RemoveUnusedLabel}" Command="{Binding RemoveUnusedCommand}"
                  IsEnabled="{Binding CanRemoveUnused}" FontSize="11" Padding="10,4" Foreground="{DynamicResource ReyErrorBrush}"
                  ToolTip.Tip="Remove the materials no mesh in this map uses from the materials.bin. Ticked rows narrow it to those rows; nothing ticked means every unused one. Materials another object in the bin still links to (VFX, props) are kept, and a copy of the bin goes to .reyengine/cleanup/ first." />
          <Button Classes="tool" Content="Tick all shown" Command="{Binding SelectAllShownCommand}"
                  FontSize="11" Padding="10,4" />
          <Button Classes="tool" Content="Clear ticks" Command="{Binding ClearSelectionCommand}"
                  FontSize="11" Padding="10,4" />
          <Button Classes="tool" Content="Select meshes" Command="{Binding SelectMeshesCommand}"
                  FontSize="11" Padding="10,4"
                  ToolTip.Tip="Select every mesh that uses the ticked materials, so a bad material becomes a thing you can see in the viewport." />
          <Button Classes="primary" Content="Open in editor" Command="{Binding OpenInEditorCommand}"
                  FontSize="11" Padding="14,4" />
        </StackPanel>
        <TextBlock Text="{Binding Summary}" FontSize="11" VerticalAlignment="Center"
                   Foreground="{DynamicResource ReyTextBrush}" />
      </DockPanel>
    </Border>

    <!-- M504: presets + bulk apply -->
    <Border DockPanel.Dock="Right" Width="360" Margin="0,12,12,12" CornerRadius="5"
            IsVisible="{Binding PresetsAvailable}"
            BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="1" ClipToBounds="True">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource ReyCardBrush}" Padding="8,5"
                BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="0,0,0,1">
          <TextBlock Text="PRESETS" FontSize="9" FontWeight="SemiBold"
                     Foreground="{DynamicResource ReyTextDimBrush}" />
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="10,10,10,6" Spacing="7">
          <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                    HorizontalAlignment="Stretch" FontSize="11"
                    PlaceholderText="choose a preset…">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="mat:MaterialPreset">
                <TextBlock Text="{Binding Name}" FontSize="11" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <TextBlock Text="{Binding PresetDetail}" FontSize="10" TextWrapping="Wrap"
                     Foreground="{DynamicResource ReyTextDimBrush}" />

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <TextBox Grid.Column="0" Text="{Binding NewPresetName}" FontSize="11" Padding="6,2"
                     PlaceholderText="name for a new preset…" />
            <Button Grid.Column="1" Classes="tool" Content="Capture" FontSize="11" Padding="10,4"
                    Command="{Binding CapturePresetCommand}"
                    ToolTip.Tip="Snapshot the HIGHLIGHTED material — shader, samplers, parameters, switches, macros and render state." />
          </Grid>

          <TextBlock Text="COPY" FontSize="9" FontWeight="SemiBold" Margin="0,4,0,0"
                     Foreground="{DynamicResource ReyTextDimBrush}" />
          <WrapPanel Orientation="Horizontal">
            <CheckBox Content="Shader" IsChecked="{Binding PartShader}" IsEnabled="{Binding CanPickShader}"
                      FontSize="11" MinWidth="112"
                      ToolTip.Tip="Off by default: the shader decides which compiled permutation the client looks up, and a wrong one is a map that loads and renders nothing (M482/M486)." />
            <CheckBox Content="Samplers" IsChecked="{Binding PartSamplers}" IsEnabled="{Binding CanPickSamplers}"
                      FontSize="11" MinWidth="112"
                      ToolTip.Tip="Sets or adds the preset's textures. Samplers the target has and the preset does not are kept." />
            <CheckBox Content="Parameters" IsChecked="{Binding PartParameters}" IsEnabled="{Binding CanPickParameters}"
                      FontSize="11" MinWidth="112" />
            <CheckBox Content="Switches" IsChecked="{Binding PartSwitches}" IsEnabled="{Binding CanPickSwitches}"
                      FontSize="11" MinWidth="112" />
            <CheckBox Content="Macros" IsChecked="{Binding PartMacros}" IsEnabled="{Binding CanPickMacros}"
                      FontSize="11" MinWidth="112"
                      ToolTip.Tip="Macros REPLACE, so a macro the preset lacks is removed — that is how a preset can clear a bad one. Each is checked against the shader cache before it is written." />
            <CheckBox Content="Render state" IsChecked="{Binding PartRenderState}" IsEnabled="{Binding CanPickRenderState}"
                      FontSize="11" MinWidth="112"
                      ToolTip.Tip="blendEnable, cullEnable and both colour blend factors." />
          </WrapPanel>

          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
            <Button Classes="tool" Content="Preview" FontSize="11" Padding="14,4"
                    Command="{Binding PreviewPresetCommand}"
                    ToolTip.Tip="Show exactly what would change on the ticked materials. Nothing is written." />
            <Button Classes="primary" Content="Apply" FontSize="11" Padding="18,4"
                    Command="{Binding ApplyPresetCommand}" IsEnabled="{Binding CanApplyPreset}"
                    ToolTip.Tip="Write the previewed changes and save the bin." />
            <Button Classes="tool" Content="Delete" FontSize="11" Padding="10,4"
                    Command="{Binding DeletePresetCommand}" />
          </StackPanel>

          <TextBlock Text="{Binding PresetStatus}" FontSize="10" TextWrapping="Wrap"
                     Foreground="{DynamicResource ReyTextBrush}" />
        </StackPanel>

        <ListBox ItemsSource="{Binding Preview}" Background="Transparent" BorderThickness="0"
                 FontSize="11" Margin="4,0,4,4">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:MaterialPlanRowViewModel">
              <StackPanel Spacing="1">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" FontSize="10"
                             Margin="8,0,0,0" Foreground="{DynamicResource ReyTextDimBrush}" />
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                </DockPanel>
                <TextBlock Text="{Binding Detail}" FontSize="10" TextWrapping="Wrap"
                           FontFamily="Consolas,Menlo,monospace"
                           Foreground="{DynamicResource ReyTextDimBrush}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- the list -->
    <Border Margin="12" CornerRadius="5" BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="1"
            ClipToBounds="True">
      <DockPanel>
        <!-- header row -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource ReyCardBrush}" Padding="8,5"
                BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="28,*,220,60,50,120">
            <TextBlock Grid.Column="1" Text="MATERIAL" FontSize="9" FontWeight="SemiBold"
                       Foreground="{DynamicResource ReyTextDimBrush}" />
            <TextBlock Grid.Column="2" Text="SHADER" FontSize="9" FontWeight="SemiBold"
                       Foreground="{DynamicResource ReyTextDimBrush}" />
            <TextBlock Grid.Column="3" Text="MESHES" FontSize="9" FontWeight="SemiBold"
                       HorizontalAlignment="Right" Foreground="{DynamicResource ReyTextDimBrush}" />
            <TextBlock Grid.Column="4" Text="TEX" FontSize="9" FontWeight="SemiBold"
                       HorizontalAlignment="Right" Foreground="{DynamicResource ReyTextDimBrush}" />
            <TextBlock Grid.Column="5" Text="FINDINGS" FontSize="9" FontWeight="SemiBold"
                       Margin="8,0,0,0" Foreground="{DynamicResource ReyTextDimBrush}" />
          </Grid>
        </Border>

        <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                 Background="Transparent" BorderThickness="0" FontSize="11">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:MaterialRowViewModel">
              <Grid ColumnDefinitions="28,*,220,60,50,120" ToolTip.Tip="{Binding Tooltip}">
                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Padding="0" MinWidth="0" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Shader}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Foreground="{DynamicResource ReyTextDimBrush}" />
                <TextBlock Grid.Column="3" Text="{Binding MeshCount}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Foreground="{DynamicResource ReyTextDimBrush}" />
                <TextBlock Grid.Column="4" Text="{Binding TextureCount}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Foreground="{DynamicResource ReyTextDimBrush}" />
                <Border Grid.Column="5" Margin="8,0,0,0" Padding="6,1" CornerRadius="3"
                        VerticalAlignment="Center" HorizontalAlignment="Left"
                        IsVisible="{Binding HasIssues}"
                        Background="{DynamicResource ReyCardBrush}"
                        BorderBrush="{DynamicResource ReyWarningBrush}" BorderThickness="1">
                  <TextBlock Text="{Binding IssueLabel}" FontSize="9"
                             Foreground="{DynamicResource ReyWarningBrush}" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
