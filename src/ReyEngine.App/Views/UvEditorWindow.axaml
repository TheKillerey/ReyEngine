<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ReyEngine.App.Views"
        xmlns:vm="clr-namespace:ReyEngine.App.ViewModels"
        x:Class="ReyEngine.App.Views.UvEditorWindow"
        x:DataType="vm:UvEditorViewModel"
        Title="ReyEngine — Second UV (Texcoord7)" Width="1040" Height="660"
        MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource ReyBgBrush}">
  <DockPanel>
    <views:ReyTitleBar DockPanel.Dock="Top" />

    <!-- footer: status + the one destructive action -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource ReyHeaderBrush}"
            BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="0,1,0,0" Padding="14,10">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="primary" Content="Apply to listed meshes"
                Command="{Binding ApplyCommand}" IsEnabled="{Binding !IsBusy}"
                Padding="16,5" FontSize="11"
                ToolTip.Tip="Rewrite Texcoord7 on every mesh in the list that has the channel. Only the UV floats change — the vertex declaration, stride and buffer length are untouched." />
        <Button DockPanel.Dock="Right" Classes="tool" Content="↻ Reload" Margin="0,0,8,0"
                Command="{Binding RefreshCommand}" Padding="14,5" FontSize="11"
                ToolTip.Tip="Re-read the open map." />
        <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                   Margin="0,0,12,0" Foreground="{DynamicResource ReyTextBrush}" />
      </DockPanel>
    </Border>

    <!-- left: mesh picker -->
    <Border DockPanel.Dock="Left" Width="300" Margin="14,12,0,12" Padding="10"
            CornerRadius="5" Background="{DynamicResource ReyCardBrush}"
            BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="1">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding MapName}" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource ReyTextBrush}" TextTrimming="CharacterEllipsis" />
        <CheckBox DockPanel.Dock="Top" Content="Only the viewport selection" Margin="0,6,0,4"
                  IsChecked="{Binding OnlySelection}" FontSize="11"
                  ToolTip.Tip="Off lists every mesh in the map. The Apply button always acts on what is listed here." />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding CanvasRectInfo}" FontSize="10" Margin="0,6,0,0"
                   Foreground="{DynamicResource ReyTextDimBrush}" TextWrapping="Wrap" />
        <ListBox ItemsSource="{Binding Meshes}" SelectedItem="{Binding SelectedMesh}"
                 FontSize="11" Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:UvMeshItem">
              <TextBlock Text="{Binding Label}" FontSize="11" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- right: the edit controls -->
    <Border DockPanel.Dock="Right" Width="290" Margin="0,12,14,12" Padding="10"
            CornerRadius="5" Background="{DynamicResource ReyCardBrush}"
            BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="1">
      <StackPanel Spacing="6">
        <TextBlock Text="REWRITE" FontSize="10" Opacity="0.7" Foreground="{DynamicResource ReyTextBrush}" />
        <ComboBox ItemsSource="{Binding Modes}" SelectedIndex="{Binding ModeIndex}"
                  HorizontalAlignment="Stretch" FontSize="11" />
        <TextBlock Text="{Binding ModeHint}" FontSize="10" TextWrapping="Wrap"
                   Foreground="{DynamicResource ReyTextDimBrush}" />

        <TextBlock Text="SCALE" FontSize="10" Opacity="0.7" Margin="0,8,0,0"
                   Foreground="{DynamicResource ReyTextBrush}" />
        <Grid ColumnDefinitions="Auto,*,Auto,*" >
          <TextBlock Grid.Column="0" Text="U" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"
                     Foreground="{DynamicResource ReyTextDimBrush}" />
          <NumericUpDown Grid.Column="1" Value="{Binding ScaleU}" Increment="0.05" FormatString="0.####"
                         FontSize="11" Padding="6,2" />
          <TextBlock Grid.Column="2" Text="V" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0"
                     Foreground="{DynamicResource ReyTextDimBrush}" />
          <NumericUpDown Grid.Column="3" Value="{Binding ScaleV}" Increment="0.05" FormatString="0.####"
                         FontSize="11" Padding="6,2" />
        </Grid>

        <TextBlock Text="OFFSET" FontSize="10" Opacity="0.7" Margin="0,4,0,0"
                   Foreground="{DynamicResource ReyTextBrush}" />
        <Grid ColumnDefinitions="Auto,*,Auto,*">
          <TextBlock Grid.Column="0" Text="U" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"
                     Foreground="{DynamicResource ReyTextDimBrush}" />
          <NumericUpDown Grid.Column="1" Value="{Binding OffsetU}" Increment="0.05" FormatString="0.####"
                         FontSize="11" Padding="6,2" />
          <TextBlock Grid.Column="2" Text="V" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0"
                     Foreground="{DynamicResource ReyTextDimBrush}" />
          <NumericUpDown Grid.Column="3" Value="{Binding OffsetV}" Increment="0.05" FormatString="0.####"
                         FontSize="11" Padding="6,2" />
        </Grid>

        <Border Margin="0,10,0,0" Padding="8,6" CornerRadius="4"
                BorderBrush="{DynamicResource ReyWarningBrush}" BorderThickness="1">
          <TextBlock FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource ReyTextBrush}"
                     Text="Texcoord7 is also the lightmap UV set. On a map with a real baked lightmap these UVs are an atlas unwrap, and rewriting them as a canvas will break the bake. On ported legacy geometry that is exactly what you want." />
        </Border>
      </StackPanel>
    </Border>

    <!-- centre: the layout itself -->
    <DockPanel Margin="12,12,12,12">
      <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
        <CheckBox Content="Show Texcoord0 behind it" IsChecked="{Binding ShowTexcoord0}" FontSize="11"
                  ToolTip.Tip="Draws the diffuse UVs dimmed underneath, so the two channels can be compared." />
        <TextBlock Text="{Binding ChannelInfo}" FontSize="10" FontFamily="Consolas,monospace"
                   Foreground="{DynamicResource ReyTextDimBrush}" TextWrapping="Wrap" />
      </StackPanel>
      <Border CornerRadius="5" BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="1"
              ClipToBounds="True">
        <views:UvCanvas Segments="{Binding Segments}" CompareSegments="{Binding CompareSegments}" />
      </Border>
    </DockPanel>
  </DockPanel>
</Window>
