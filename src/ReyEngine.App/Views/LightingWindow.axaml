<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ReyEngine.App.Views"
        xmlns:vm="clr-namespace:ReyEngine.App.ViewModels"
        x:Class="ReyEngine.App.Views.LightingWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ReyEngine — Lighting" Width="1040" Height="760"
        MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource ReyBgBrush}">
  <DockPanel>
    <views:ReyTitleBar DockPanel.Dock="Top" />

    <!-- footer: the actions that apply to the whole panel -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource ReyHeaderBrush}"
            BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="0,1,0,0" Padding="14,10">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="primary" Content="🔦 Bake Lighting…"
                Command="{Binding OpenLightBakeCommand}" IsEnabled="{Binding HasMapForLayout}"
                Padding="16,5" FontSize="11"
                ToolTip.Tip="Bake this lighting into the map's lightmap atlases. If the map has no lightmap layout yet, that window offers to generate one first." />
        <!-- M450: the missing half of this panel. Until now the sliders edited a copy the viewport
             rendered and nothing could persist - "not saveable" was literally true. -->
        <Button DockPanel.Dock="Right" Classes="tool" Content="💾 Save sun to map" Margin="0,0,8,0"
                Command="{Binding SaveSunToMapCommand}" IsEnabled="{Binding HasMapGeo}" Padding="14,5" FontSize="11"
                ToolTip.Tip="Write the current sun, sky, fog and lightmap scale into the map's materials.bin (the MapContainer's MapSunProperties component). Sun and sky are live in game — no bake needed. Fields this panel does not edit are left untouched, and Reset then returns to these saved values." />
        <Button DockPanel.Dock="Right" Classes="tool" Content="↺ Reset to map" Margin="0,0,8,0"
                Command="{Binding ResetLightingCommand}" Padding="14,5" FontSize="11"
                ToolTip.Tip="Discard these tweaks and go back to the values the map itself authored." />
        <TextBlock VerticalAlignment="Center" FontSize="10" TextWrapping="Wrap"
                   Foreground="{DynamicResource ReyTextDimBrush}"
                   Text="These values drive the preview and the bake — 'Save sun to map' writes them into the map itself." />
      </DockPanel>
    </Border>

    <!-- Colour pickers and populated light tables are taller than compact windows. Keep the footer
         fixed and scroll the complete body so settings in every column remain reachable. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="14" MinWidth="720" ColumnDefinitions="*,*,*" RowDefinitions="Auto,*">

      <!-- ================= column 1 : the map's own light ================= -->
      <StackPanel Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Margin="0,0,7,0" Spacing="10">

        <Border Classes="card" Padding="12" CornerRadius="6">
          <StackPanel Spacing="6">
            <TextBlock Text="MODE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ReyTextDimBrush}" />
            <Border Background="{DynamicResource ReyPanelAltBrush}" CornerRadius="4" Padding="2">
              <UniformGrid Columns="3">
                <ToggleButton Classes="vp" Content="Dynamic" IsChecked="{Binding IsLightingDynamic}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                              ToolTip.Tip="Sun/sky + editable point lights, no baked atlas — the live authoring view you bake from." />
                <ToggleButton Classes="vp" Content="Baked" IsChecked="{Binding IsLightingBaked}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                              ToolTip.Tip="Baked lightmap only, point lights off — how the map looks in game after a bake." />
                <ToggleButton Classes="vp" Content="Combined" IsChecked="{Binding IsLightingCombined}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                              ToolTip.Tip="Baked lightmap AND dynamic lights together — a debug overlay to compare the two." />
              </UniformGrid>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <ToggleButton Classes="vp" Content="☀ Lightmap" IsChecked="{Binding ShowLightmaps}" />
              <ToggleButton Classes="vp" Content="💡 Lights" IsChecked="{Binding ShowDynamicLights}"
                            IsVisible="{Binding HasDynamicLights}" />
              <ToggleButton Classes="vp" Content="🌫 Fog" IsChecked="{Binding ShowFog}"
                            IsVisible="{Binding HasMapFog}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="12" CornerRadius="6">
          <StackPanel Spacing="4">
            <TextBlock Text="LIGHTMAP" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ReyTextDimBrush}" />
            <TextBlock Text="{Binding CurrentLightmapScale, StringFormat='Baked brightness  {0:0.00}'}"
                       FontSize="11" Foreground="{DynamicResource ReyTextBrush}" />
            <Slider Minimum="0" Maximum="4" Value="{Binding CurrentLightmapScale}"
                    ToolTip.Tip="MapSunProperties.lightMapColorScale — the multiplier the game applies to the baked atlas." />
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="12" CornerRadius="6">
          <StackPanel Spacing="4">
            <DockPanel>
              <Border DockPanel.Dock="Right" Width="26" Height="13" CornerRadius="2"
                      Background="{Binding SunSwatch}" BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="1" />
              <TextBlock Text="SUN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ReyTextDimBrush}" />
            </DockPanel>
            <TextBlock Text="{Binding SunIntensity, StringFormat='Intensity  {0:0.00}'}" FontSize="11"
                       Foreground="{DynamicResource ReyTextBrush}" />
            <Slider Minimum="0" Maximum="3" Value="{Binding SunIntensity}"
                    ToolTip.Tip="MapSunProperties.SunIntensityScale. Saved as its own field, separate from the hue — the viewport multiplies the two." />
            <ColorPicker Color="{Binding SunColorPick, Mode=TwoWay}" HorizontalAlignment="Stretch"
                         IsAlphaVisible="False" IsAlphaEnabled="False"
                         ToolTip.Tip="MapSunProperties.sunColor. Drives the viewport: SUN_LIGHT_COLOR for the DefaultEnv_Flat family, and LightRegionInfo.SunLightColor for the PBR/Mantis family, which does not read SUN_LIGHT_COLOR at all. Brightness stays on the Intensity slider above." />

            <!-- M463: sunDirection. NumericUpDown rather than a slider because Riot ships this NON-UNIT
                 (Map22 base_dragon_cloud is <2, 8, -3>, length 8.775) and a -1..1 slider would clamp an
                 authored vector, then save the clamped one. -->
            <TextBlock Text="Direction (points TOWARD the sun)" FontSize="11" Margin="0,6,0,0"
                       Foreground="{DynamicResource ReyTextBrush}" />
            <UniformGrid Columns="3">
              <NumericUpDown Value="{Binding SunDirX}" Minimum="-10" Maximum="10" Increment="0.05"
                             FormatString="0.###" FontSize="11" Margin="0,0,3,0"
                             ToolTip.Tip="MapSunProperties.sunDirection X. Drives the viewport — SUN_LIGHT_DIRECTION, and the character sun direction in LightRegionInfo. Not normalised on save: Riot ships non-unit vectors and this round-trips whatever the map holds." />
              <NumericUpDown Value="{Binding SunDirY}" Minimum="-10" Maximum="10" Increment="0.05"
                             FormatString="0.###" FontSize="11" Margin="3,0"
                             ToolTip.Tip="MapSunProperties.sunDirection Y. Drives the viewport. Positive is up." />
              <NumericUpDown Value="{Binding SunDirZ}" Minimum="-10" Maximum="10" Increment="0.05"
                             FormatString="0.###" FontSize="11" Margin="3,0,0,0"
                             ToolTip.Tip="MapSunProperties.sunDirection Z. Drives the viewport." />
            </UniformGrid>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="12" CornerRadius="6">
          <StackPanel Spacing="4">
            <DockPanel>
              <Border DockPanel.Dock="Right" Width="26" Height="13" CornerRadius="2"
                      Background="{Binding SkySwatch}" BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="1" />
              <TextBlock Text="SKY / AMBIENT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ReyTextDimBrush}" />
            </DockPanel>
            <TextBlock Text="{Binding SkyIntensity, StringFormat='Intensity  {0:0.00}'}" FontSize="11"
                       Foreground="{DynamicResource ReyTextBrush}" />
            <Slider Minimum="0" Maximum="3" Value="{Binding SkyIntensity}"
                    ToolTip.Tip="MapSunProperties.skyLightScale. Drives the PBR/Mantis ambient in the D3D11 viewport (IBL_CUBEMAP_SCALES) and the ambient term in the OpenGL viewport. Always saved to the map." />
            <ColorPicker Color="{Binding SkyColorPick, Mode=TwoWay}" HorizontalAlignment="Stretch"
                         IsAlphaVisible="False" IsAlphaEnabled="False"
                         ToolTip.Tip="MapSunProperties.skyLightColor. Brightness stays on the Intensity slider above." />
            <TextBlock FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{DynamicResource ReyTextDimBrush}"
                       Text="D3D11: ambient reaches PBR/Mantis materials only. Riot's DefaultEnv_Flat — what nearly all shipped map geometry uses — has no ambient input in its shader (it is sun + baked lightmap), so on those surfaces this is saved to the map but cannot change the picture. The OpenGL viewport applies it everywhere." />
          </StackPanel>
        </Border>

        <!-- M463: the sky-gradient pair. SAVE-ONLY and labelled as such: this renderer draws the sky from a
             cubemap/equirect/mesh TEXTURE, and no shader constant in PerFramePixelCB carries a two-colour
             gradient, so there is nowhere honest to send these. Exposed anyway because the map authors them
             and the writer persists them - without a control they could only ever be saved back unchanged. -->
        <Border Classes="card" Padding="12" CornerRadius="6">
          <StackPanel Spacing="4">
            <DockPanel>
              <Border DockPanel.Dock="Right" Width="26" Height="13" CornerRadius="2"
                      Background="{Binding HorizonSwatch}" BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="1" />
              <TextBlock Text="SKY GRADIENT — SAVED, NOT SHOWN" FontSize="10" FontWeight="Bold"
                         Foreground="{DynamicResource ReyTextDimBrush}" />
            </DockPanel>
            <TextBlock Text="Horizon" FontSize="11" Foreground="{DynamicResource ReyTextBrush}" />
            <ColorPicker Color="{Binding HorizonColorPick, Mode=TwoWay}" HorizontalAlignment="Stretch"
                         IsAlphaVisible="False" IsAlphaEnabled="False"
                         ToolTip.Tip="MapSunProperties.horizonColor. Written to the map for the game to read. NOT shown in either viewport — the sky here is a texture, not a gradient, and no shader constant carries one." />
            <DockPanel Margin="0,4,0,0">
              <Border DockPanel.Dock="Right" Width="26" Height="13" CornerRadius="2"
                      Background="{Binding GroundSwatch}" BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="1" />
              <TextBlock Text="Ground" FontSize="11" Foreground="{DynamicResource ReyTextBrush}" />
            </DockPanel>
            <ColorPicker Color="{Binding GroundColorPick, Mode=TwoWay}" HorizontalAlignment="Stretch"
                         IsAlphaVisible="False" IsAlphaEnabled="False"
                         ToolTip.Tip="MapSunProperties.groundColor. Written to the map for the game to read. NOT shown in either viewport, for the same reason as Horizon above." />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- ================= column 2 : point lights ================= -->
      <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Margin="7,0" Spacing="10">
          <Border Classes="card" Padding="12" CornerRadius="6">
            <StackPanel Spacing="4">
              <TextBlock Text="POINT LIGHTS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ReyTextDimBrush}" />
              <TextBlock Text="{Binding DynamicLightIntensity, StringFormat='Strength  {0:0.00}'}" FontSize="11"
                         Foreground="{DynamicResource ReyTextBrush}" />
              <Slider Minimum="0" Maximum="5" Value="{Binding DynamicLightIntensity}"
                      ToolTip.Tip="Global multiplier on every point light. Each light also has its own strength in the Inspector." />
              <TextBlock Text="{Binding DynamicLightRadiusScale, StringFormat='Radius scale  {0:0.00}x'}" FontSize="11"
                         Foreground="{DynamicResource ReyTextBrush}" />
              <Slider Minimum="0.05" Maximum="5" Value="{Binding DynamicLightRadiusScale}" />
              <TextBlock Text="{Binding LightFalloffSoftness, StringFormat='Falloff softness  {0:0.00}'}" FontSize="11"
                         Foreground="{DynamicResource ReyTextBrush}" />
              <Slider Minimum="0" Maximum="1" Value="{Binding LightFalloffSoftness}"
                      ToolTip.Tip="0 = Riot's own falloff, linear from the light to its radius - this is what the game draws, and what the D3D11 renderer's cluster path draws. 1 = the legacy wider pool that fades out more gently. The bake uses the same curve, so Dynamic and Baked agree at every value." />
              <CheckBox Content="Show light position icons" IsChecked="{Binding ShowLightMarkers}" FontSize="11" Margin="0,4,0,0" />
            </StackPanel>
          </Border>

          <Border Classes="card" Padding="12" CornerRadius="6">
            <StackPanel Spacing="4">
              <TextBlock Text="FIT A LIGHT.DAT TO THIS MAP" FontSize="10" FontWeight="Bold"
                         Foreground="{DynamicResource ReyTextDimBrush}" />
              <TextBlock FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource ReyTextDimBrush}"
                         Text="A Light.dat authored for another map lands in the wrong place. These spread and shift the whole table; height is never touched." />
              <TextBlock Text="{Binding DynamicLightPositionScale, StringFormat='Spread  {0:0.00}x'}" FontSize="11"
                         Foreground="{DynamicResource ReyTextBrush}" />
              <Slider Minimum="0.1" Maximum="6" Value="{Binding DynamicLightPositionScale}" />
              <TextBlock Text="{Binding DynamicLightScaleX, StringFormat='Scale X  {0:0.00}x'}" FontSize="11"
                         Foreground="{DynamicResource ReyTextBrush}" />
              <Slider Minimum="0.1" Maximum="6" Value="{Binding DynamicLightScaleX}" />
              <TextBlock Text="{Binding DynamicLightScaleZ, StringFormat='Scale Z  {0:0.00}x'}" FontSize="11"
                         Foreground="{DynamicResource ReyTextBrush}" />
              <Slider Minimum="0.1" Maximum="6" Value="{Binding DynamicLightScaleZ}" />
              <TextBlock Text="{Binding DynamicLightOffsetX, StringFormat='Offset X  {0:0}'}" FontSize="11"
                         Foreground="{DynamicResource ReyTextBrush}" />
              <Slider Minimum="-20000" Maximum="20000" Value="{Binding DynamicLightOffsetX}" />
              <TextBlock Text="{Binding DynamicLightOffsetZ, StringFormat='Offset Z  {0:0}'}" FontSize="11"
                         Foreground="{DynamicResource ReyTextBrush}" />
              <Slider Minimum="-20000" Maximum="20000" Value="{Binding DynamicLightOffsetZ}" />
            </StackPanel>
          </Border>
      </StackPanel>

      <!-- ================= column 3 : the light table ================= -->
      <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Margin="7,0,0,0" Spacing="10">
        <Border Classes="card" Padding="12" CornerRadius="6">
          <StackPanel Spacing="6">
            <TextBlock Text="LIGHT TABLE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ReyTextDimBrush}" />
            <TextBlock Text="{Binding DynamicLightsStatus}" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource ReyAccentBrush}" />
            <TextBlock FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource ReyTextDimBrush}"
                       Text="Click a light to select it — Ctrl or Shift for several. Position, colour, radius and strength are edited in the inspector (Map Content ▸ Lights), or by dragging the light in the viewport." />

            <!-- M289: the table was previously invisible - the only way to reach a light was one at a time
                 through the outliner, which does not scale to an imported Light.dat of several hundred. -->
            <ListBox ItemsSource="{Binding EditableLights}"
                     SelectedItem="{Binding SelectedLight, Mode=TwoWay}"
                     SelectedItems="{Binding SelectedLights}"
                     SelectionMode="Multiple"
                     IsVisible="{Binding HasDynamicLights}"
                     MaxHeight="200" FontSize="11" Margin="0,4,0,0"
                     Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0" Width="10" Height="10" CornerRadius="2" Margin="0,0,6,0"
                            VerticalAlignment="Center" Background="{Binding ColorHex}" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding Radius, StringFormat='r{0:0}'}" FontSize="9"
                               VerticalAlignment="Center" Foreground="{DynamicResource ReyTextDimBrush}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Grid ColumnDefinitions="*,*" Margin="0,4,0,0" IsVisible="{Binding HasDynamicLights}">
              <Button Grid.Column="0" Classes="tool" Content="✕ Delete selected"
                      Command="{Binding DeleteSelectedLightsCommand}"
                      HorizontalAlignment="Stretch" Margin="0,0,3,0" FontSize="11" Padding="8,4"
                      ToolTip.Tip="Remove every light selected above. Falls back to the one picked in the outliner when nothing is selected here." />
              <Button Grid.Column="1" Classes="tool" Content="🗑 Remove all"
                      Command="{Binding ClearAllLightsCommand}"
                      HorizontalAlignment="Stretch" Margin="3,0,0,0" FontSize="11" Padding="8,4"
                      ToolTip.Tip="Empty the whole table - e.g. to discard an imported Light.dat and start again." />
            </Grid>

            <Button Classes="tool" Content="⏻ Load Light.dat…" Command="{Binding LoadLightDatCommand}"
                    HorizontalAlignment="Stretch" FontSize="11" Padding="8,4" Margin="0,4,0,0"
                    ToolTip.Tip="Load a legacy Riot LEVELS/MapN/Light.dat point-light table and preview it as dynamic lights." />
            <Button Classes="tool" Content="+ Add light" Command="{Binding AddLightCommand}"
                    HorizontalAlignment="Stretch" FontSize="11" Padding="8,4"
                    ToolTip.Tip="Add a point light at the gizmo (or the origin) — then drag it into place." />
            <!-- M449: height. The fit panel offsets X/Z only (LightPositionOffset is a Vector2 and the
                 bake's ResolvePosition has no Y term), so this edits each light's own Y instead. -->
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
              <TextBlock Grid.Column="0" Text="Height ±" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0" />
              <NumericUpDown Grid.Column="1" Value="{Binding BulkLightHeightOffset}" Minimum="-100000" Maximum="100000"
                             Increment="50" FormatString="0.###" FontSize="11" Padding="6,2" />
              <Button Grid.Column="2" Classes="tool" Content="Move all" Command="{Binding ApplyBulkLightHeightOffsetCommand}"
                      FontSize="11" Padding="8,4" Margin="6,0,0,0"
                      ToolTip.Tip="Add this to every light's Y. The fit panel can only offset X and Z, so this is the way to raise or lower the whole set — and because it edits the light itself, it survives the port into the map." />
            </Grid>

            <!-- M449: which lighting the materials use. Point lights were observed working on
                 NO_BAKED_LIGHTING materials, so these two are the choice between the baked lightmap and
                 the dynamic path, applied across the whole map. -->
            <TextBlock Text="All materials" FontSize="11" Opacity="0.7" Margin="0,10,0,2" />
            <Grid ColumnDefinitions="*,*">
              <Button Grid.Column="0" Classes="tool" Content="Dynamic (unlit)" Command="{Binding SetAllMaterialsUnlitCommand}"
                      HorizontalAlignment="Stretch" Margin="0,0,3,0" FontSize="11" Padding="8,4"
                      ToolTip.Tip="Set NO_BAKED_LIGHTING on every material, so they stop sampling their baked lightmap — the state dynamic point lights were observed working in." />
              <Button Grid.Column="1" Classes="tool" Content="Baked lightmap" Command="{Binding SetAllMaterialsBakedCommand}"
                      HorizontalAlignment="Stretch" Margin="3,0,0,0" FontSize="11" Padding="8,4"
                      ToolTip.Tip="Clear NO_BAKED_LIGHTING so materials use their baked lightmap again. Materials the game ships no permutation for without the macro keep it and are reported, rather than being broken into 'Unable to find correct hash for shader'." />
            </Grid>

            <!-- M448: back to the pre-bake state. Clears each mesh's BakedLight reference so the map lights
                 dynamically again and a fresh bake does not layer onto stale atlas assignments. -->
            <Button Classes="tool" Content="🧹 Clean up lightmaps" Command="{Binding CleanupLightmapsCommand}"
                    HorizontalAlignment="Stretch" FontSize="11" Padding="8,4" Margin="0,8,0,0"
                    IsEnabled="{Binding HasMapGeo}"
                    ToolTip.Tip="Clear every mesh's baked-lightmap reference (atlas path + UV scale/bias), returning the mapgeo to its pre-bake state. The generated atlas .tex files are left on disk — this only removes the references the client follows. Saves the rewritten mapgeo." />

            <!-- M447: bulk strength. The Intensity slider above is a viewport/bake multiplier that never
                 reaches the bin; this writes each light's OWN intensityScale, which is what the port
                 persists and the game reads. -->
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
              <TextBlock Grid.Column="0" Text="Strength" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0" />
              <NumericUpDown Grid.Column="1" Value="{Binding BulkLightIntensity}" Minimum="0" Maximum="10000"
                             Increment="1" FormatString="0.###" FontSize="11" Padding="6,2" />
              <Button Grid.Column="2" Classes="tool" Content="Set all" Command="{Binding ApplyBulkLightIntensityCommand}"
                      FontSize="11" Padding="8,4" Margin="6,0,0,0"
                      ToolTip.Tip="Write this strength into every light's own intensityScale — the field the map port persists and the game reads. The Intensity slider above only scales the preview and the bake." />
            </Grid>

            <!-- M446 (C): the bridge off the legacy system. Light.dat lights live only in the editor and
                 the project file, so a legacy map's lighting could previously only be BAKED in. Written as
                 MapDynamicPointLight placements they become real dynamic lights the client renders with no
                 bake at all, and the baker reads them too. -->
            <Button Classes="tool" Content="→ Port lights into the map" Command="{Binding PortLightsToMapCommand}"
                    HorizontalAlignment="Stretch" FontSize="11" Padding="8,4" Margin="0,4,0,0"
                    ToolTip.Tip="Write these lights into the map's materials.bin as MapDynamicPointLight placements — the modern dynamic-light system. They then light the map in game with no baking, and the lightmap baker reads them as well. Replaces any placements already there, so running it twice does not double the lights." />
            <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
              <Button Grid.Column="0" Classes="tool" Content="💾 Save" Command="{Binding SaveLightDatCommand}"
                      HorizontalAlignment="Stretch" Margin="0,0,3,0" FontSize="11" Padding="8,4"
                      ToolTip.Tip="Write the table back in Riot's Light.dat format." />
              <Button Grid.Column="1" Classes="tool" Content="Save as…" Command="{Binding SaveLightDatAsCommand}"
                      HorizontalAlignment="Stretch" Margin="3,0,0,0" FontSize="11" Padding="8,4" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- M463: fog is now editable rather than merely announced. No IsVisible gate any more - it was
             bound to HasMapFog, which is derived from the range, so a map that authors no fog could never
             be given one. -->
        <Border Classes="card" Padding="12" CornerRadius="6">
          <StackPanel Spacing="4">
            <DockPanel>
              <Border DockPanel.Dock="Right" Width="26" Height="13" CornerRadius="2"
                      Background="{Binding FogSwatch}" BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="1" />
              <TextBlock Text="FOG" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ReyTextDimBrush}" />
            </DockPanel>
            <ColorPicker Color="{Binding FogColorPick, Mode=TwoWay}" HorizontalAlignment="Stretch"
                         IsAlphaVisible="False" IsAlphaEnabled="False"
                         ToolTip.Tip="MapSunProperties.fogColor. Drives the viewport (ENV_FOG_COLOR and ENV_FOG_ALT_COLOR) whenever the Fog toggle under MODE is on." />
            <TextBlock Text="Range — raw, in Riot's own convention" FontSize="11" Margin="0,6,0,0"
                       Foreground="{DynamicResource ReyTextBrush}" />
            <UniformGrid Columns="2">
              <NumericUpDown Value="{Binding FogStartRaw}" Minimum="-1000000" Maximum="1000000" Increment="500"
                             FormatString="0.###" FontSize="11" Margin="0,0,3,0"
                             ToolTip.Tip="MapSunProperties.fogStartAndEnd X. Drives the viewport when Fog is on. Shown RAW because the shader consumes it raw: Riot stores these negative and reversed (Twisted Treeline ships -10000, -50000, meaning fog from 10000 to 50000)." />
              <NumericUpDown Value="{Binding FogEndRaw}" Minimum="-1000000" Maximum="1000000" Increment="500"
                             FormatString="0.###" FontSize="11" Margin="3,0,0,0"
                             ToolTip.Tip="MapSunProperties.fogStartAndEnd Y. Drives the viewport when Fog is on. Also raw — see the X box." />
            </UniformGrid>
            <TextBlock FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{DynamicResource ReyTextDimBrush}"
                       Text="Toggle fog on under MODE to see it. The toggle appears once the two numbers describe a real range." />
          </StackPanel>
        </Border>

        <!-- M467: the sun's SHADOW half. These are the only map-side shadow controls that exist - the
             meta database puts `castShadows` on SkinMeshDataProperties (characters) and nowhere else, so
             there is no per-material or per-mesh cast flag to offer instead. They are written to the bin
             for the GAME; ReyEngine's own viewport shadow is fitted by SunShadowFit and ignores them. -->
        <Border Classes="card" Margin="0,8,0,0">
          <StackPanel Spacing="4">
            <DockPanel>
              <TextBlock Text="SUN SHADOWS (game only)" FontSize="10" FontWeight="Bold"
                         Foreground="{DynamicResource ReyTextDimBrush}" />
            </DockPanel>
            <TextBlock Text="Coverage radius" FontSize="11" Margin="0,4,0,0"
                       Foreground="{DynamicResource ReyTextBrush}" />
            <NumericUpDown Value="{Binding SunRadiusForShadows}" Minimum="0" Maximum="20000" Increment="5"
                           FormatString="0.###" FontSize="11"
                           ToolTip.Tip="MapSunProperties.SunRadiusForShadows. Schema default 0; 176 of 207 shipped maps author it, 151 of them to 75. TESTED IN GAME AND IT DOES NOT ENABLE MAP-GEOMETRY SHADOWS - that hypothesis is refuted, not pending. Static map geometry never casts a real-time sun shadow in League; its shadows are BAKED into the lightmap alpha (Riot's shader reads shadow = min(realtime PCF, lightmap alpha)). If your terrain casts nothing, re-bake the lightmap - see the warning on map load. This field most likely controls the soft-shadow penumbra radius, which remains unmeasured." />
            <TextBlock Text="Shadow intensity scale" FontSize="11" Margin="0,6,0,0"
                       Foreground="{DynamicResource ReyTextBrush}" />
            <NumericUpDown Value="{Binding ScaleSunShadowIntensity}" Minimum="0" Maximum="4" Increment="0.05"
                           FormatString="0.###" FontSize="11"
                           ToolTip.Tip="MapSunProperties.ScaleSunShadowIntensity. Schema default 1. Authored by 30 of 207 maps (0.05, 0.4, 0, 0.01, 0.1, 0.5) and by 131 of 173 MapLightingVolumes, so Riot uses it heavily as a per-region control. 0 means the sun shadow contributes nothing." />
            <UniformGrid Columns="2" Margin="0,6,0,0">
              <StackPanel Margin="0,0,3,0">
                <TextBlock Text="Depth bias" FontSize="11" Foreground="{DynamicResource ReyTextBrush}" />
                <NumericUpDown Value="{Binding SunShadowBias}" Minimum="0" Maximum="1" Increment="0.0001"
                               FormatString="0.#####" FontSize="11"
                               ToolTip.Tip="MapSunProperties.ShadowBias. Schema default 0.0006. NOT ONE of the 207 shipped maps authors this - every single one takes the default, so any value you set here is unlike anything Riot ships. Too low gives acne, too high detaches shadows from their objects." />
              </StackPanel>
              <StackPanel Margin="3,0,0,0">
                <TextBlock Text="Area / map scale" FontSize="11" Foreground="{DynamicResource ReyTextBrush}" />
                <NumericUpDown Value="{Binding SurfaceAreaToShadowMapScale}" Minimum="0" Maximum="8" Increment="0.005"
                               FormatString="0.####" FontSize="11"
                               ToolTip.Tip="MapSunProperties.surfaceAreaToShadowMapScale. Schema default 0.05 - how much world one shadow texel covers. Authored by 17 of 207 (0.1, 0.02, 0.025, 0.015, 0.03, 1). Lower is sharper and covers less." />
              </StackPanel>
            </UniformGrid>
            <TextBlock FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{DynamicResource ReyTextDimBrush}"
                       Text="These four change the GAME, not this viewport - use Save Sun To Map, then test in client. They do NOT make map geometry cast shadows: that was tested and refuted. Static geometry's shadows are baked into the lightmap, so a map that casts nothing needs a BAKE, not a setting here." />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
