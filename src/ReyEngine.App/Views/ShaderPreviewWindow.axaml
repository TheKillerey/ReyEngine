<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ReyEngine.App.Views"
        xmlns:vm="clr-namespace:ReyEngine.App.ViewModels"
        x:Class="ReyEngine.App.Views.ShaderPreviewWindow"
        x:DataType="vm:ShaderPreviewViewModel"
        Title="ReyEngine — DX11 Shader Preview (experimental)" Width="1180" Height="740"
        MinWidth="760" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource ReyBgBrush}">
  <DockPanel>
    <views:ReyTitleBar DockPanel.Dock="Top" />

    <!-- status strip -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource ReyHeaderBrush}"
            BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="0,1,0,0" Padding="12,7">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding Perf}" FontFamily="Consolas" FontSize="11"
                   VerticalAlignment="Center" Opacity="0.85"
                   Foreground="{DynamicResource ReyTextBrush}" />
        <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                   Margin="0,0,16,0"
                   Foreground="{DynamicResource ReyTextBrush}" />
      </DockPanel>
    </Border>

    <Grid ColumnDefinitions="300,4,*,4,400">

      <!-- ============================ left: pick a shader ============================ -->
      <Border Grid.Column="0" BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel Margin="10">
          <TextBlock DockPanel.Dock="Top" Text="SHADER" FontSize="10" FontWeight="SemiBold"
                     Opacity="0.6" Margin="2,0,0,6" Foreground="{DynamicResource ReyTextBrush}" />
          <TextBox DockPanel.Dock="Top" Text="{Binding Filter}" Watermark="filter by name…"
                   FontSize="11" Margin="0,0,0,6" />

          <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
            <TextBlock Text="VERTEX PERMUTATION" FontSize="10" FontWeight="SemiBold" Opacity="0.6"
                       Foreground="{DynamicResource ReyTextBrush}" />
            <ComboBox ItemsSource="{Binding VertexPermutations}" SelectedItem="{Binding SelectedVertexPerm}"
                      DisplayMemberBinding="{Binding Label}" HorizontalAlignment="Stretch" FontSize="11"
                      MaxDropDownHeight="380" />
            <TextBlock Text="PIXEL PERMUTATION" FontSize="10" FontWeight="SemiBold" Opacity="0.6"
                       Foreground="{DynamicResource ReyTextBrush}" />
            <ComboBox ItemsSource="{Binding PixelPermutations}" SelectedItem="{Binding SelectedPixelPerm}"
                      DisplayMemberBinding="{Binding Label}" HorizontalAlignment="Stretch" FontSize="11"
                      MaxDropDownHeight="380" />

            <TextBlock Text="TEST MESH" FontSize="10" FontWeight="SemiBold" Opacity="0.6" Margin="0,4,0,0"
                       Foreground="{DynamicResource ReyTextBrush}" />
            <ComboBox ItemsSource="{Binding MeshNames}" SelectedItem="{Binding SelectedMesh}"
                      HorizontalAlignment="Stretch" FontSize="11" />

            <Button Classes="primary" Content="▶  Load shader" Command="{Binding LoadCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Margin="0,6,0,0" Padding="0,7" FontSize="12"
                    ToolTip.Tip="Create both stages on the D3D11 device, build the input layout from the vertex shader's own signature, and allocate its constant buffers." />
            <Button Classes="tool" Content="↻  Reload from the WAD" Command="{Binding ReloadCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Padding="0,5" FontSize="11" />
          </StackPanel>

          <ListBox ItemsSource="{Binding ShaderNames}" SelectedItem="{Binding SelectedShader}"
                   FontFamily="Consolas" FontSize="11">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ShaderRow">
                <!-- the common assets/shaders/generated/shaders/ prefix is stripped for readability;
                     the full path is on the tooltip and in the Shader tab -->
                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding Full}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- ============================ centre: the preview ============================ -->
      <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" />

      <DockPanel Grid.Column="2" Margin="10">
        <Border DockPanel.Dock="Top" Background="{DynamicResource ReyHeaderBrush}"
                BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="1" CornerRadius="6"
                Padding="10,8" Margin="0,0,0,8">
          <WrapPanel Orientation="Horizontal">
            <CheckBox Content="Wireframe" IsChecked="{Binding Wireframe}" FontSize="11" Margin="0,0,14,0" />
            <CheckBox Content="Cull back faces" IsChecked="{Binding CullBackFaces}" FontSize="11" Margin="0,0,14,0" />
            <CheckBox Content="Depth test" IsChecked="{Binding DepthTest}" FontSize="11" Margin="0,0,14,0" />
            <CheckBox Content="Alpha blend" IsChecked="{Binding AlphaBlend}" FontSize="11" Margin="0,0,14,0" />
            <CheckBox Content="Animate TIME" IsChecked="{Binding AnimateTime}" FontSize="11" Margin="0,0,14,0" />
            <CheckBox Content="Transpose matrices" IsChecked="{Binding TransposeMatrices}" FontSize="11" Margin="0,0,14,0"
                      ToolTip.Tip="HLSL packs cbuffer matrices column-major, so a row-major matrix is conventionally transposed before upload. Whether Riot's shaders do mul(v,M) or mul(M,v) is not recorded in the bytecode — if the mesh is inside-out, squashed or missing, flip this first." />
            <CheckBox Content="Mirror X" IsChecked="{Binding MirrorX}" FontSize="11" Margin="0,0,14,0"
                      ToolTip.Tip="Mirror world X, which is what the map viewport does — League authors its data in the opposite handedness, so without this a map is laid out mirrored against every other view in the editor. Backface culling follows the flip automatically." />
            <CheckBox Content="Compare: ReyEngine's model" IsChecked="{Binding UseComparisonShader}" FontSize="11"
                      Foreground="{DynamicResource ReyAccentBrush}"
                      ToolTip.Tip="Swap Riot's pixel shader for ReyEngine's own material model (diffuse × lambert + ambient), on the same mesh, camera and textures. The HLSL is generated from Riot's vertex shader output signature so it always links; see the Compare tab." />
          </WrapPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Margin="0,8,0,0">
          <Grid ColumnDefinitions="Auto,*,Auto,*,Auto" RowDefinitions="Auto">
            <TextBlock Grid.Column="0" Text="Sun ∠" FontSize="11" VerticalAlignment="Center"
                       Margin="0,0,6,0" Foreground="{DynamicResource ReyTextBrush}" />
            <Slider Grid.Column="1" Minimum="-3.2" Maximum="3.2" Value="{Binding SunAzimuth}" />
            <TextBlock Grid.Column="2" Text="Sun ↕" FontSize="11" VerticalAlignment="Center"
                       Margin="12,0,6,0" Foreground="{DynamicResource ReyTextBrush}" />
            <Slider Grid.Column="3" Minimum="-1.5" Maximum="1.5" Value="{Binding SunElevation}" />
            <TextBlock Grid.Column="4" FontSize="10" Opacity="0.55" VerticalAlignment="Center" Margin="14,0,0,0"
                       Foreground="{DynamicResource ReyTextBrush}"
                       Text="WASD/QE fly · drag look · alt-drag orbit · middle-drag pan · wheel zoom · F reframe" />
          </Grid>
        </Border>

        <Border Background="#101216" BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="1"
                CornerRadius="6" ClipToBounds="True">
          <Panel x:Name="PreviewSurface" Focusable="True" Background="#01000000"
                 Cursor="Hand">
            <TextBlock Text="Pick a shader on the left and press Load, or load a scene from the Scene tab."
                       FontSize="12" Opacity="0.45" TextWrapping="Wrap" MaxWidth="320"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding !IsLoaded}"
                       Foreground="{DynamicResource ReyTextBrush}" />
            <!-- the bitmap is produced at this panel's own pixel size, so it must NOT be resampled -->
            <Image Source="{Binding Preview}" Stretch="Fill"
                   RenderOptions.BitmapInterpolationMode="None" />
          </Panel>
        </Border>
      </DockPanel>

      <!-- ============================ right: diagnostics ============================ -->
      <GridSplitter Grid.Column="3" Background="Transparent" ResizeDirection="Columns" />

      <Border Grid.Column="4" BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="1,0,0,0">
        <TabControl Margin="6">

          <TabItem Header="Shader">
            <ScrollViewer HorizontalScrollBarVisibility="Auto">
              <SelectableTextBlock Text="{Binding Metadata}" FontFamily="Consolas" FontSize="10.5"
                                   TextWrapping="NoWrap" Margin="8"
                                   Foreground="{DynamicResource ReyTextBrush}" />
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Scene">
            <DockPanel Margin="6">
              <TextBlock DockPanel.Dock="Top" FontSize="10" Opacity="0.6" TextWrapping="Wrap" Margin="2,0,2,6"
                         Foreground="{DynamicResource ReyTextBrush}"
                         Text="Load a whole character (.skn) or map (.mapgeo) and draw every submesh with its own material. Pick the materials .bin on the Material tab first — that is where the definitions come from." />

              <TextBox DockPanel.Dock="Top" Text="{Binding SceneFilter}" Watermark="filter .skn / .mapgeo…"
                       FontSize="11" Margin="0,0,0,4" />

              <Button DockPanel.Dock="Bottom" Classes="primary" Content="▶  Load scene"
                      Command="{Binding LoadSceneCommand}" FontSize="11.5" Margin="0,6,0,0"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,7"
                      IsEnabled="{Binding SelectedSceneAsset, Converter={x:Static ObjectConverters.IsNotNull}}" />

              <Grid RowDefinitions="*,4,*,Auto">
                <ListBox Grid.Row="0" ItemsSource="{Binding SceneAssets}" SelectedItem="{Binding SelectedSceneAsset}"
                         FontFamily="Consolas" FontSize="10.5">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SceneAssetRow">
                      <StackPanel Spacing="0" Margin="0,1">
                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Path}"
                                   Foreground="{DynamicResource ReyTextBrush}" />
                        <TextBlock Text="{Binding Kind}" FontSize="9" Opacity="0.5"
                                   Foreground="{DynamicResource ReyTextBrush}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <GridSplitter Grid.Row="1" Background="Transparent" ResizeDirection="Rows" />

                <ListBox Grid.Row="2" ItemsSource="{Binding SceneSubmeshes}" FontSize="11">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SceneSubmeshRow">
                      <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                        <CheckBox Grid.Column="0" IsChecked="{Binding Visible}" Margin="0,0,6,0"
                                  VerticalAlignment="Center"
                                  ToolTip.Tip="Hide this submesh, to see what is behind it or isolate one material." />
                        <StackPanel Grid.Column="1" Spacing="1">
                          <TextBlock Text="{Binding Label}" FontFamily="Consolas" FontSize="10.5"
                                     TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource ReyTextBrush}" />
                          <TextBlock Text="{Binding Detail}" FontSize="9.5" Opacity="0.55"
                                     TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource ReyTextBrush}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <ScrollViewer Grid.Row="3" MaxHeight="200" HorizontalScrollBarVisibility="Auto" Margin="0,6,0,0">
                  <SelectableTextBlock Text="{Binding SceneReport}" FontFamily="Consolas" FontSize="10"
                                       TextWrapping="NoWrap"
                                       Foreground="{DynamicResource ReyTextBrush}" />
                </ScrollViewer>
              </Grid>
            </DockPanel>
          </TabItem>

          <TabItem Header="Debug">
            <DockPanel Margin="6">
              <TextBlock DockPanel.Dock="Top" FontSize="10" Opacity="0.6" TextWrapping="Wrap" Margin="2,0,2,6"
                         Foreground="{DynamicResource ReyTextBrush}"
                         Text="Override the shader defines the loaded scene was cooked over. Forcing one selects a DIFFERENT COOKED PERMUTATION of the same shader — the one the engine itself would use for that define set — so this is a real switch, not a fake. Change these, then press Load scene again." />

              <Border DockPanel.Dock="Top" Background="{DynamicResource ReyHeaderBrush}"
                      BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="1" CornerRadius="4"
                      Padding="8,6" Margin="0,0,0,6">
                <StackPanel Spacing="4">
                  <TextBlock Text="COMMON" FontSize="9.5" FontWeight="SemiBold" Opacity="0.6"
                             Foreground="{DynamicResource ReyTextBrush}" />
                  <TextBlock FontSize="10" Opacity="0.7" TextWrapping="Wrap"
                             Foreground="{DynamicResource ReyTextBrush}"
                             Text="DISABLE_SHADOWS · DISABLE_FOW · NO_BAKED_LIGHTING (turns lightmaps off) · DISABLE_DEPTH_FOG · LOW_QUALITY_MODE · USE_DYNAMIC_LIGHTING · CLOUD_SHADOWS" />
                </StackPanel>
              </Border>

              <Button DockPanel.Dock="Bottom" Classes="tool" Content="↺  Reset all to as-authored"
                      Command="{Binding ResetSceneDefinesCommand}" FontSize="11" Margin="0,6,0,0"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,5" />

              <ListBox ItemsSource="{Binding SceneDefines}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SceneDefineRow">
                    <Grid ColumnDefinitions="*,116" Margin="0,3">
                      <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}" FontFamily="Consolas" FontSize="10.5"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ReyTextBrush}" />
                        <TextBlock Text="{Binding Detail}" FontSize="9" Opacity="0.5"
                                   Foreground="{DynamicResource ReyTextBrush}" />
                      </StackPanel>
                      <ComboBox Grid.Column="1" SelectedIndex="{Binding Mode}" FontSize="10.5"
                                HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <ComboBoxItem Content="as authored" />
                        <ComboBoxItem Content="force on" />
                        <ComboBoxItem Content="force absent" />
                      </ComboBox>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </TabItem>

          <TabItem Header="Material">
            <DockPanel Margin="6">
              <TextBlock DockPanel.Dock="Top" FontSize="10" Opacity="0.6" TextWrapping="Wrap" Margin="2,0,2,6"
                         Foreground="{DynamicResource ReyTextBrush}"
                         Text="Pick a .bin, then a material inside it. Loading resolves the permutation the engine would actually pick for that material's define set, binds its real .tex textures, and writes its parameters into the constants the shader declares." />

              <TextBox DockPanel.Dock="Top" Text="{Binding BinFilter}" Watermark="filter .bin files…"
                       FontSize="11" Margin="0,0,0,4" />

              <Button DockPanel.Dock="Bottom" Classes="primary" Content="▶  Load this material"
                      Command="{Binding ApplyMaterialCommand}" FontSize="11.5" Margin="0,6,0,0"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,7"
                      IsEnabled="{Binding SelectedMaterial, Converter={x:Static ObjectConverters.IsNotNull}}" />

              <Grid RowDefinitions="*,4,*,Auto">
                <ListBox Grid.Row="0" ItemsSource="{Binding MaterialBins}" SelectedItem="{Binding SelectedBin}"
                         FontFamily="Consolas" FontSize="10.5">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:MaterialBinRow">
                      <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding Path}" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <GridSplitter Grid.Row="1" Background="Transparent" ResizeDirection="Rows" />

                <ListBox Grid.Row="2" ItemsSource="{Binding Materials}" SelectedItem="{Binding SelectedMaterial}"
                         FontSize="11">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:MaterialRow">
                      <StackPanel Spacing="1" Margin="0,2">
                        <TextBlock Text="{Binding Label}" FontFamily="Consolas" FontSize="11"
                                   Foreground="{DynamicResource ReyTextBrush}" />
                        <TextBlock Text="{Binding Detail}" FontSize="9.5" Opacity="0.55"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource ReyTextBrush}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <ScrollViewer Grid.Row="3" MaxHeight="240" HorizontalScrollBarVisibility="Auto" Margin="0,6,0,0">
                  <SelectableTextBlock Text="{Binding MaterialReport}" FontFamily="Consolas" FontSize="10"
                                       TextWrapping="NoWrap"
                                       Foreground="{DynamicResource ReyTextBrush}" />
                </ScrollViewer>
              </Grid>
            </DockPanel>
          </TabItem>

          <TabItem Header="Bindings">
            <ScrollViewer HorizontalScrollBarVisibility="Auto">
              <SelectableTextBlock Text="{Binding Bindings}" FontFamily="Consolas" FontSize="10.5"
                                   TextWrapping="NoWrap" Margin="8"
                                   Foreground="{DynamicResource ReyTextBrush}" />
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Textures">
            <DockPanel Margin="6">
              <Button DockPanel.Dock="Top" Classes="tool" Content="Bind a checker to every slot"
                      Command="{Binding BindCheckerToAllCommand}" FontSize="11" Margin="0,0,0,6"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,5" />
              <TextBlock DockPanel.Dock="Bottom" FontSize="10" Opacity="0.6" TextWrapping="Wrap" Margin="2,6,2,0"
                         Foreground="{DynamicResource ReyTextBrush}"
                         Text="Double-click a slot to bind an image file. Slots ending in _SharedTexture are engine-supplied, not material-supplied. Anything unbound samples as opaque white." />
              <ListBox ItemsSource="{Binding TextureSlots}" x:Name="TextureList">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:TextureSlotRow">
                    <StackPanel Spacing="1" Margin="0,2">
                      <TextBlock Text="{Binding Label}" FontFamily="Consolas" FontSize="11"
                                 Foreground="{DynamicResource ReyTextBrush}" />
                      <TextBlock FontSize="10" Opacity="0.6" Foreground="{DynamicResource ReyTextBrush}">
                        <TextBlock.Text>
                          <MultiBinding StringFormat="{}{0}  ·  {1}">
                            <Binding Path="Dimension" />
                            <Binding Path="Source" />
                          </MultiBinding>
                        </TextBlock.Text>
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </TabItem>

          <TabItem Header="Constants">
            <DockPanel Margin="6">
              <TextBlock DockPanel.Dock="Top" FontSize="10" Opacity="0.6" TextWrapping="Wrap" Margin="2,0,2,6"
                         Foreground="{DynamicResource ReyTextBrush}"
                         Text="Type space-separated floats to override a constant. Empty means the preview supplies it (camera, sun, time) or leaves the shader's own default. Values are written at the byte offset the shader declares." />
              <ListBox ItemsSource="{Binding Constants}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ConstantRow">
                    <Grid ColumnDefinitions="*,120" Margin="0,2">
                      <StackPanel Grid.Column="0" Spacing="1">
                        <TextBlock Text="{Binding Label}" FontFamily="Consolas" FontSize="10.5"
                                   Foreground="{DynamicResource ReyTextBrush}" />
                        <TextBlock Text="{Binding Detail}" FontSize="9.5" Opacity="0.55"
                                   Foreground="{DynamicResource ReyTextBrush}" />
                      </StackPanel>
                      <TextBox Grid.Column="1" Text="{Binding Value}" FontSize="10.5" FontFamily="Consolas"
                               Watermark="auto" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </TabItem>

          <TabItem Header="Compare">
            <ScrollViewer>
              <StackPanel Margin="8" Spacing="6">
                <TextBlock FontSize="10.5" TextWrapping="Wrap" Opacity="0.75"
                           Foreground="{DynamicResource ReyTextBrush}"
                           Text="ReyEngine's material model, generated as HLSL from Riot's vertex shader output signature so it links against whatever is loaded. Tick 'Compare' above to draw with this instead of Riot's pixel shader — same mesh, camera and textures." />
                <SelectableTextBlock Text="{Binding ComparisonSource}" FontFamily="Consolas" FontSize="10"
                                     TextWrapping="NoWrap"
                                     Foreground="{DynamicResource ReyTextBrush}" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Log">
            <ScrollViewer HorizontalScrollBarVisibility="Auto">
              <SelectableTextBlock Text="{Binding Log}" FontFamily="Consolas" FontSize="10.5"
                                   TextWrapping="Wrap" Margin="8"
                                   Foreground="{DynamicResource ReyTextBrush}" />
            </ScrollViewer>
          </TabItem>

        </TabControl>
      </Border>
    </Grid>
  </DockPanel>
</Window>
