<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ReyEngine.App.Views"
        x:Class="ReyEngine.App.Views.UpdateWindow"
        Title="Update available"
        Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource ReyBgBrush}"
        Foreground="{DynamicResource ReyTextBrush}"
        FontFamily="Inter, Segoe UI, sans-serif">

  <!-- M681: a newer release - what changed, and the way to take it: now (downloaded and installed here),
       from the download page (the pre-M681 way), or later. -->
  <DockPanel>
  <local:ReyTitleBar DockPanel.Dock="Top" />
  <StackPanel Margin="22,18" Spacing="12">
    <StackPanel Spacing="2">
      <TextBlock x:Name="HeadlineText" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ReyTextBrightBrush}" />
      <TextBlock x:Name="VersionsText" FontSize="11.5" Foreground="{DynamicResource ReyTextDimBrush}" />
    </StackPanel>

    <Border Classes="settingsCard">
      <StackPanel Spacing="6">
        <TextBlock Classes="settingsTitle" Text="WHAT CHANGED" />
        <ScrollViewer MaxHeight="340" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <SelectableTextBlock x:Name="ChangelogText" FontSize="12" LineHeight="18" TextWrapping="Wrap" />
        </ScrollViewer>
      </StackPanel>
    </Border>

    <StackPanel x:Name="ProgressPanel" Spacing="6" IsVisible="False">
      <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Height="8" />
      <TextBlock x:Name="StatusText" FontSize="11" Foreground="{DynamicResource ReyTextDimBrush}" TextWrapping="Wrap" />
    </StackPanel>
    <TextBlock x:Name="ErrorText" FontSize="11" Foreground="{DynamicResource ReyErrorBrush}" TextWrapping="Wrap" IsVisible="False" />

    <CheckBox x:Name="AutoBox" Content="Install updates automatically from now on" FontSize="12"
              ToolTip.Tip="From the next release on, the download starts as soon as a newer version is found and installs when it is ready. Change it any time in Settings ▸ General ▸ Updates." />

    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,4,0,0">
      <Button x:Name="PageButton" Grid.Column="0" Classes="tool" Content="🌐 Download page" Click="OnOpenPage" Padding="14,6" />
      <Button x:Name="LaterButton" Grid.Column="2" Classes="tool" Content="Later" Click="OnLater" Padding="16,6" Margin="0,0,8,0" />
      <Button x:Name="UpdateButton" Grid.Column="3" Classes="primary" Content="Update now" Click="OnUpdate" Padding="20,6" />
    </Grid>
  </StackPanel>
  </DockPanel>
</Window>
