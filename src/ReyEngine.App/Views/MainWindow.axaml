<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ReyEngine.App.Views"
        xmlns:vm="clr-namespace:ReyEngine.App.ViewModels"
        xmlns:conv="clr-namespace:ReyEngine.App.Converters"
        x:Class="ReyEngine.App.Views.MainWindow"
        Title="{Binding Title}"
        Width="1500" Height="900"
        MinWidth="1000" MinHeight="640"
        Background="{DynamicResource ReyBgBrush}"
        Foreground="{DynamicResource ReyTextBrush}"
        FontFamily="Inter, Segoe UI, sans-serif"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

  <Window.Resources>
    <conv:LogLevelToBrushConverter x:Key="LevelToBrush" />
    <conv:BoolToBrushConverter x:Key="SelectionHighlight" TrueBrush="#3336E2C2" FalseBrush="Transparent" />
    <conv:BoolToBrushConverter x:Key="ActiveTabUnderline" TrueBrush="#36E2C2" FalseBrush="Transparent" />
    <conv:BoolToBrushConverter x:Key="ActiveTabBg" TrueBrush="#1A36E2C2" FalseBrush="Transparent" />
  </Window.Resources>

  <DockPanel>

    <!-- ============ TOP APP BAR (M39: custom title bar — brand + menu + project) ============ -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource ReyHeaderBrush}"
          MinHeight="32" PointerPressed="OnTitleBarPointerPressed">
      <Image x:Name="LogoImage" Grid.Column="0" Height="24" Margin="10,3,6,3"
             VerticalAlignment="Center" ToolTip.Tip="ReyEngine" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="0,0,14,0">
        <TextBlock Text="REYENGINE" FontSize="13" FontWeight="Bold" LetterSpacing="1.5"
                   Foreground="{DynamicResource ReyTextBrightBrush}" VerticalAlignment="Center" />
        <Border Width="1" Height="12" Background="{DynamicResource ReyBorderAccentBrush}" VerticalAlignment="Center" />
        <TextBlock Text="MAP &amp; ASSET EDITOR" FontSize="9" FontWeight="SemiBold" LetterSpacing="2"
                   Foreground="{DynamicResource ReyAccentBrush}" VerticalAlignment="Center" />
        <TextBlock x:Name="TitleVersionText" FontSize="9" FontWeight="SemiBold"
                   Foreground="{DynamicResource ReyTextDimBrush}" VerticalAlignment="Center" />
      </StackPanel>
      <!-- right margin clears the native caption buttons overlaid on the extended client area -->
      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" Margin="10,0,150,0" VerticalAlignment="Center">
        <TextBlock Text="{Binding Title}" FontSize="11"
                   Foreground="{DynamicResource ReyTextDimBrush}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" MaxWidth="380" ToolTip.Tip="Active project (* = unsaved changes)" />
        <Button Classes="icon" Content="⚙" FontSize="14" Command="{Binding OpenSettingsCommand}"
                ToolTip.Tip="Preferences — keybinds &amp; camera (Ctrl+,)" />
      </StackPanel>
    <Menu Grid.Column="2" Background="Transparent">
      <MenuItem Header="_File">
        <MenuItem Header="Open Project Folder…" Command="{Binding OpenProjectFolderCommand}" />
        <!-- M80 fix: BasedOn is REQUIRED — a bare ControlTheme replaces the default MenuItem theme
             (no template at all), which rendered every recent-project entry as an invisible item. -->
        <MenuItem Header="Open Recent" ItemsSource="{Binding RecentProjectList}"
                  IsEnabled="{Binding HasRecentProjects}">
          <MenuItem.ItemContainerTheme>
            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
              <Setter Property="Header" Value="{Binding Name}" />
              <Setter Property="Command" Value="{Binding OpenCommand}" />
              <Setter Property="ToolTip.Tip" Value="{Binding Path}" />
            </ControlTheme>
          </MenuItem.ItemContainerTheme>
        </MenuItem>
        <MenuItem Header="New Project…" Command="{Binding NewProjectCommand}" />
        <MenuItem Header="Import .fantome…" Command="{Binding ImportFantomeCommand}"
                  ToolTip.Tip="Convert a .fantome mod package into an editable project" />
        <MenuItem Header="Open Project…" Command="{Binding OpenProjectCommand}" />
        <MenuItem Header="Save Project" Command="{Binding SaveProjectCommand}" />
        <MenuItem Header="Save Project As…" Command="{Binding SaveProjectAsCommand}" />
        <Separator />
        <MenuItem Header="Open WAD (inspect)…" Command="{Binding OpenWadCommand}" />
        <MenuItem Header="Open Legacy Map (NVR)…" Command="{Binding OpenLegacyMapCommand}"
                  ToolTip.Tip="View an old-format League map (a LEVELS/MapN folder with Scene/room.nvr) — e.g. Twisted Treeline / Crystal Scar — rendered in the Model Preview window" />
        <MenuItem Header="Export Selected…" Command="{Binding ExportSelectedCommand}" />
        <Separator />
        <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="{Binding UndoLabel}" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" InputGesture="Ctrl+Z" />
        <MenuItem Header="{Binding RedoLabel}" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" InputGesture="Ctrl+Y" />
        <Separator />
        <MenuItem Header="Clear Console" Command="{Binding ClearConsoleCommand}" />
        <Separator />
        <MenuItem Header="Preferences…" Command="{Binding OpenSettingsCommand}" InputGesture="Ctrl+," />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Reload WAD" Command="{Binding ReloadWadCommand}" />
      </MenuItem>
      <!-- M143: grouped by purpose — open-an-editor and per-asset actions up top (used constantly),
           the occasional utilities tucked into submenus. Build Package lives in Project + the toolbar. -->
      <MenuItem Header="_Tools">
        <MenuItem Header="Workshop..." Command="{Binding OpenWorkshopCommand}"
                  ToolTip.Tip="Browse one real game material per shader and every unique installed particle, then add a complete template directly to the open map" />
        <MenuItem Header="Port Legacy NVR / WGEO into Open Map..." Command="{Binding PortLegacyMapCommand}"
                  ToolTip.Tip="Replace the open mapgeo's ordinary geometry from an old room.nvr or room.wgeo, port unique textures and shared editable materials, and retain the destination render regions" />
        <Separator />
        <MenuItem Header="Open in Particle Editor" Command="{Binding OpenActiveInParticleEditorCommand}"
                  ToolTip.Tip="Open the active document's .bin in the Particle Editor (works for skin bins and map materials.bin that contain VFX systems)" />
        <MenuItem Header="Open in HUD Editor" Command="{Binding OpenInHudEditorCommand}"
                  ToolTip.Tip="Open a HUD layout bin (ClientStates/…/UIBase) in the visual HUD editor — see every element rendered at its position with its texture" />
        <MenuItem Header="Open in Audio Editor" Command="{Binding OpenInAudioEditorCommand}"
                  ToolTip.Tip="Edit the selected .bnk/.wpk directly: play, replace, add, rename, delete and copy/paste its embedded sounds" />
        <Separator />
        <MenuItem Header="Light">
          <MenuItem Header="Lighting…" Command="{Binding OpenLightingCommand}"
                    ToolTip.Tip="Sun, sky, lightmap brightness, point-light placement and the light table — everything that drives how the map is lit in the viewport, and what a bake reproduces" />
          <MenuItem Header="Bake Lighting…" Command="{Binding OpenLightBakeCommand}"
                    ToolTip.Tip="Bake the current lighting into the map's lightmap atlases; offers to generate a lightmap layout first for maps that have none" />
          <Separator />
          <MenuItem Header="Load Light.dat…" Command="{Binding LoadLightDatCommand}"
                    ToolTip.Tip="Load a legacy Riot LEVELS/MapN/Light.dat point-light table and preview it as dynamic lights" />
          <MenuItem Header="Save Light.dat" Command="{Binding SaveLightDatCommand}"
                    ToolTip.Tip="Write the point-light table back in Riot's Light.dat format" />
          <MenuItem Header="Save Light.dat As…" Command="{Binding SaveLightDatAsCommand}" />
        </MenuItem>
        <Separator />
        <MenuItem Header="Recolor Textures…" Command="{Binding OpenTextureRecolorCommand}"
                  ToolTip.Tip="Recolour map surfaces, placed mobs / animated props and baked lightmaps — hue, saturation, levels and tint across as many as you like. Every texture is re-derived from Riot's original, so re-tuning never stacks compression loss, and each one keeps its own pixel format and mip chain" />
        <MenuItem Header="Map Skin Switcher…" Command="{Binding OpenMapSkinSwitcherCommand}"
                  ToolTip.Tip="Force every registered normal-map slot through one shipped environment while preserving each slot's runtime data. TFT / Map22 is intentionally unavailable." />
        <Separator />
        <MenuItem Header="Assign Skeleton…" Command="{Binding AssignSkeletonCommand}" />
        <MenuItem Header="Assign Animation…" Command="{Binding AssignAnimationCommand}" />
        <Separator />
        <MenuItem Header="Mod Health">
          <MenuItem Header="Validate Project Bins" Command="{Binding ValidateProjectBinsCommand}"
                    ToolTip.Tip="Emulate mod injection (project overrides over Riot originals) and check every project .bin for broken object links and missing assets — what would break in-game" />
          <MenuItem Header="Overlay Footprint" Command="{Binding OverlayFootprintCommand}"
                    ToolTip.Tip="How many game WADs will mod loaders have to patch for this mod? Shows the fan-out per WAD and which project folders cause it. A wide overlay means slow installs and messy merges — it is NOT a crash cause (see Check Cubemap Probes for the crash that was long blamed on it)" />
          <MenuItem Header="Asset Usage Report" Command="{Binding AssetUsageCommand}"
                    ToolTip.Tip="Which project files can nothing ever load (dead — deletable in one click) and which recolor OTHER content (champions/items — the wad fan-out drivers)" />
          <MenuItem Header="Check Cubemap Probes" Command="{Binding CheckCubemapProbesCommand}"
                    ToolTip.Tip="Every MapCubemapProbe must point at a real DDS CUBEMAP. A plain 2D DXT1/DXT3 texture bound where the engine expects 6 faces crashes the game — this is the fault that used to be misattributed to wide WAD overlays" />
          <MenuItem Header="Map Material Diagnostics" Command="{Binding MapMaterialDiagnosticsCommand}"
                    ToolTip.Tip="Scan the loaded map's bins + mapgeo and write an honest diagnostics report (classes, unknown fields, lighting/lightmap/visibility) to .reyengine/reports/" />
          <Separator />
          <MenuItem Header="Cleanup Project…" Command="{Binding CleanupProjectCommand}"
                    ToolTip.Tip="Find files nothing can load and project copies that are identical to the Riot original. Scan first, review a full preview, then move the selection into a project-local backup you can undo — nothing is deleted outright" />
          <MenuItem Header="Patch Update Wizard…" Command="{Binding OpenPatchUpdateWizardCommand}"
                    ToolTip.Tip="Update this mod to the current patch: old originals from CommunityDragon + three-way merge carries only the mod's edits onto the new base — with backups, a per-bin report and validation" />
        </MenuItem>
        <MenuItem Header="Hashes &amp; Names">
          <MenuItem Header="Sync Hashes (CommunityDragon)" Command="{Binding SyncHashesCommand}" />
          <MenuItem Header="Reload Local Hashes" Command="{Binding ReloadLocalHashesCommand}" />
          <MenuItem Header="Hash Lookup" Command="{Binding HashLookupCommand}" />
          <Separator />
          <MenuItem Header="Rebuild Wwise Name Index" Command="{Binding RebuildWwiseNamesCommand}"
                    ToolTip.Tip="Recover Wwise event names by hashing name strings found in the game's .bin files — makes the Audio Editor show real event names instead of hex ids" />
        </MenuItem>
        <MenuItem Header="Shaders">
          <MenuItem Header="Scan Riot Shaders" Command="{Binding ScanRiotShadersCommand}" />
          <MenuItem Header="Export Shader Dump…" Command="{Binding ExportShaderDumpCommand}" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Project">
        <MenuItem Header="Build Package" Command="{Binding BuildPackageCommand}" />
        <MenuItem Header="Open Build Folder" Command="{Binding OpenBuildFolderCommand}" />
        <Separator />
        <MenuItem Header="Export .fantome…" Command="{Binding ExportFantomeCommand}" />
        <Separator />
        <MenuItem Header="Project Settings…" Command="{Binding OpenProjectSettingsCommand}" />
        <MenuItem Header="Manage Riot References…" Command="{Binding ManageRiotReferencesCommand}" />
        <MenuItem Header="Set Game Folder…" Command="{Binding SetGameFolderCommand}" />
        <MenuItem Header="Sync Hashes" Command="{Binding SyncHashesCommand}" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="Preferences…" Command="{Binding OpenSettingsCommand}" InputGesture="Ctrl+," />
        <Separator />
        <MenuItem Header="Setup Wizard…" Click="OnShowSetupWizard" />
        <MenuItem Header="Check for Updates…" Click="OnCheckUpdates" />
        <MenuItem Header="About ReyEngine…" Click="OnShowAbout" />
      </MenuItem>
    </Menu>
    </Grid>

    <!-- ============ MAIN TOOLBAR (M39: icon + text, grouped) ============ -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource ReyHeaderBrush}"
            BorderBrush="{DynamicResource ReyBorderBrush}"
            BorderThickness="0,1,0,1" Padding="8,5">
      <StackPanel Orientation="Horizontal">
        <!-- assets -->
        <Button Classes="tool" Command="{Binding OpenWadCommand}" ToolTip.Tip="Open a WAD archive for inspection">
          <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="📥" FontSize="11"/><TextBlock Text="Import"/></StackPanel>
        </Button>
        <Button Classes="tool" Command="{Binding ExportSelectedCommand}" ToolTip.Tip="Export the selected asset to disk">
          <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="📤" FontSize="11"/><TextBlock Text="Export"/></StackPanel>
        </Button>
        <Button Classes="tool" Command="{Binding ReloadWadCommand}" ToolTip.Tip="Reload the current WAD/project content">
          <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="⟳" FontSize="12"/><TextBlock Text="Reload"/></StackPanel>
        </Button>
        <Border Width="1" Height="18" Background="{DynamicResource ReyBorderBrush}" Margin="5,0" VerticalAlignment="Center" />
        <!-- data -->
        <Button Classes="tool" Command="{Binding SyncHashesCommand}" ToolTip.Tip="Sync hash tables from CommunityDragon">
          <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="⇅" FontSize="11"/><TextBlock Text="Sync Hashes"/></StackPanel>
        </Button>
        <Button Classes="tool" Command="{Binding ShaderPreviewCommand}" ToolTip.Tip="Riot shader inspection / preview">
          <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="✦" FontSize="11"/><TextBlock Text="Shaders"/></StackPanel>
        </Button>
        <Border Width="1" Height="18" Background="{DynamicResource ReyBorderBrush}" Margin="5,0" VerticalAlignment="Center" />
        <!-- build / ship -->
        <Button Classes="primary" Command="{Binding BuildPackageCommand}" ToolTip.Tip="Build the mod package (repack + validate)">
          <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="📦" FontSize="11"/><TextBlock Text="Build Package"/></StackPanel>
        </Button>
        <Button Classes="tool" Command="{Binding ExportFantomeCommand}" ToolTip.Tip="Export the mod as a .fantome package">
          <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="👻" FontSize="11"/><TextBlock Text=".fantome"/></StackPanel>
        </Button>
        <Border Width="1" Height="18" Background="{DynamicResource ReyBorderBrush}" Margin="5,0" VerticalAlignment="Center" />
        <!-- hash lookup -->
        <TextBox Width="230" VerticalAlignment="Center" Margin="0,0,4,0"
                 Watermark="path or string to hash…"
                 Text="{Binding HashInput, Mode=TwoWay}" />
        <Button Classes="tool" Command="{Binding HashLookupCommand}" ToolTip.Tip="Resolve a path or hash">
          <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Text="🔎" FontSize="11"/><TextBlock Text="Hash Lookup"/></StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <!-- ============ INSPECTION-MODE BANNER (M11) ============ -->
    <Border DockPanel.Dock="Top" Background="#2A2113" BorderBrush="#FFB454" BorderThickness="0,0,0,1"
            Padding="10,4" IsVisible="{Binding InspectionMode}">
      <TextBlock Text="🔍 Single-WAD inspection mode — open a project folder (File ▸ Open Project Folder) to edit and build mods."
                 Foreground="#FFD9A0" FontSize="11" />
    </Border>

    <!-- ============ STATUS BAR (M39) ============ -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource ReyHeaderBrush}"
            BorderBrush="{DynamicResource ReyBorderBrush}"
            BorderThickness="0,1,0,0" Padding="10,3">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding SelectionStatus}" Foreground="{DynamicResource ReyAccentBrush}" FontSize="11" VerticalAlignment="Center"
                     IsVisible="{Binding SelectionStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <Border Width="1" Height="11" Background="{DynamicResource ReyBorderBrush}" VerticalAlignment="Center" />
          <TextBlock Text="REYENGINE" FontSize="9" LetterSpacing="1.2" FontWeight="SemiBold"
                     Foreground="{DynamicResource ReyTextDimBrush}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <!-- M131: determinate build/export progress with stage info -->
          <ProgressBar Width="170" Height="10" Minimum="0" Maximum="100" Value="{Binding BuildProgress}"
                       VerticalAlignment="Center" IsVisible="{Binding BuildProgressActive}" />
          <TextBlock Text="{Binding Status}" Foreground="{DynamicResource ReyTextDimBrush}" FontSize="11" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ============ MAIN AREA ============ -->
    <!-- M90: MinWidths stop the splitters from collapsing panels into broken layouts -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="290" MinWidth="180" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="360" MinWidth="280" />
      </Grid.ColumnDefinitions>

      <!-- LEFT: MAP CONTENT (scene outliner — visibility, layer tree, transform, mesh details;
           the redundant .mapgeo list was retired, maps open from the Content Browser + tabs) -->
      <Border Grid.Column="0" Background="{DynamicResource ReyPanelBrush}">
        <DockPanel>
          <TextBlock Classes="panelHeader" DockPanel.Dock="Top" Text="MAP CONTENT" />
          <views:MapOutlinerView />
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Background="{DynamicResource ReyBorderBrush}" />

      <!-- CENTER: Viewport + Content Browser (top block) · Console (bottom).
           Nesting the viewport + browser means the console splitter trades height with the VIEWPORT,
           not the content browser (M43 fix). -->
      <Grid Grid.Column="2" RowDefinitions="*,4,170">
      <!-- M100: browser sits between viewport and console; 200px keeps the viewport large. -->
      <Grid Grid.Row="0" RowDefinitions="*,4,200">
        <Border Grid.Row="0" Background="{DynamicResource ReyBgBrush}">
          <DockPanel>
            <!-- Document / viewport tabs (M33): the loaded map stays alive while other assets are inspected -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource ReyHeaderBrush}"
                    BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="0,0,0,1"
                    IsVisible="{Binding ActiveDocument, Converter={x:Static ObjectConverters.IsNotNull}}">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Documents}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <!-- M39: document tab — translucent cyan when active + accent underline -->
                      <Border Margin="2,3,0,0" CornerRadius="4,4,0,0" ClipToBounds="True"
                              Background="{Binding IsActive, Converter={StaticResource ActiveTabBg}}">
                        <DockPanel>
                          <Border DockPanel.Dock="Bottom" Height="2" CornerRadius="1"
                                  Background="{Binding IsActive, Converter={StaticResource ActiveTabUnderline}}" />
                          <StackPanel Orientation="Horizontal" Margin="8,4,4,3" Spacing="4">
                            <Button Background="Transparent" BorderThickness="0" Padding="0"
                                    Command="{Binding $parent[ItemsControl].DataContext.ActivateDocumentCommand}" CommandParameter="{Binding}"
                                    ToolTip.Tip="{Binding Title}">
                              <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="{Binding Glyph}" FontSize="11" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" FontSize="11" VerticalAlignment="Center"
                                           MaxWidth="150" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource ReyTextBrush}" />
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource ReyAccent2Brush}" VerticalAlignment="Center" IsVisible="{Binding IsDirty}"
                                         ToolTip.Tip="Unsaved changes" />
                              </StackPanel>
                            </Button>
                            <Button Classes="icon" Content="✕" FontSize="10"
                                    Command="{Binding $parent[ItemsControl].DataContext.CloseDocumentCommand}" CommandParameter="{Binding}"
                                    ToolTip.Tip="Close tab" />
                          </StackPanel>
                        </DockPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>
          <Grid>
            <!-- M248 (phase 6, step 1): the D3D11 surface sits behind the same input overlay as the GL one
                 and the two swap by visibility. ViewportControl derives from OpenGlControlBase, so it IS
                 the GL surface and cannot render D3D itself - hence two siblings rather than one control
                 with a mode. Nothing GL is removed; this is reversible by unticking the box. -->
            <Image x:Name="Dx11Surface" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"
                   IsVisible="{Binding UseDx11Viewport}" />
            <views:ViewportControl x:Name="Viewport"
                IsVisible="{Binding !UseDx11Viewport}"
                Skybox="{Binding CurrentSkybox}"
                Mesh="{Binding CurrentMesh}"
                ModelTextures="{Binding CurrentModelTextures}"
                ModelMaskTextures="{Binding CurrentModelMaskTextures}"
                ModelGradientTextures="{Binding CurrentModelGradientTextures}"
                ModelEmissiveTextures="{Binding CurrentModelEmissiveTextures}"
                ModelMatCapTextures="{Binding CurrentModelMatCapTextures}"
                ModelMatCapMaskTextures="{Binding CurrentModelMatCapMaskTextures}"
                ModelLightmapTextures="{Binding CurrentModelLightmapTextures}"
                ModelSubmeshVisible="{Binding CurrentModelSubmeshVisible}"
                ModelSubmeshMaterials="{Binding CurrentModelSubmeshMaterials}"
                MeshVerticesRevision="{Binding MeshVerticesRevision}"
                SelectionBoxes="{Binding SelectionBoxes}"
                HighlightSubmeshes="{Binding SelectedSubmeshIndices}"
                GroupBoundsMin="{Binding GroupBoundsMin}"
                GroupBoundsMax="{Binding GroupBoundsMax}"
                GizmoPivot="{Binding GizmoPivot}"
                GizmoMode="{Binding TransformMode}"
                GizmoAxes="{Binding GizmoAxes}"
                Skeleton="{Binding CurrentSkeleton}"
                AnimationClip="{Binding CurrentAnimation}"
                AnimationTime="{Binding AnimationTime}"
                Wireframe="{Binding ShowWireframe}"
                ShowBones="{Binding ShowBones}"
                ShowBounds="{Binding ShowBounds}"
                CullBackfaces="{Binding CullBackfaces}"
                LightmapsEnabled="{Binding ShowLightmaps}"
                DynamicLights="{Binding DynamicLights}"
                DynamicLightsEnabled="{Binding ShowDynamicLights}"
                DynamicLightIntensity="{Binding DynamicLightIntensity}"
                DynamicLightRadiusScale="{Binding DynamicLightRadiusScale}"
                LightFalloffSoftness="{Binding LightFalloffSoftness}"
                DynamicLightPositionScale="{Binding DynamicLightPositionScale}"
                DynamicLightScaleX="{Binding DynamicLightScaleX}"
                DynamicLightScaleZ="{Binding DynamicLightScaleZ}"
                DynamicLightOffsetX="{Binding DynamicLightOffsetX}"
                DynamicLightOffsetZ="{Binding DynamicLightOffsetZ}"
                ShowLightMarkers="{Binding ShowLightMarkers}"
                GrassTintTexture="{Binding CurrentGrassTint}"
                GrassTintRect="{Binding CurrentGrassTintRect}"
                ParticleMarkers="{Binding ParticleMarkers}"
                SelectedParticlePosition="{Binding SelectedParticleMarker}"
                PropMarkers="{Binding PropMarkers}"
                ProbeMarkers="{Binding ProbeMarkers}"
                SoundMarkers="{Binding SoundMarkers}"
                BucketGridLines="{Binding BucketGridLines}"
                PropMeshes="{Binding CurrentPropMeshes}"
                ParticlePlayback="{Binding CurrentParticlePlayback}"
                PlayPropAnimations="{Binding PlayPropAnimations}"
                AnimateWater="{Binding HasFlowmapWater}"
                LightmapScale="{Binding CurrentLightmapScale}"
                SunProperties="{Binding CurrentSunProperties}"
                FogEnabled="{Binding ShowFog}"
                FocusPoint="{Binding ParticleFocusPoint}"
                PreviewMode="{Binding PreviewMode}" />

            <!-- transparent surface that forwards pointer input to the viewport camera -->
            <Border x:Name="ViewportInput" Background="Transparent"
                    Focusable="True"
                    PointerPressed="OnViewportPointerPressed"
                    PointerMoved="OnViewportPointerMoved"
                    PointerReleased="OnViewportPointerReleased"
                    PointerWheelChanged="OnViewportPointerWheel"
                    KeyDown="OnViewportKeyDown"
                    KeyUp="OnViewportKeyUp" />

            <!-- M172c: brush palette. Floats over the viewport bottom-left, out of the way of the
                 toolbars top-right, and only while paint mode is on. -->
            <Border IsVisible="{Binding IsPaintMode}" Classes="card" Margin="10" Padding="12"
                    CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="252">
              <StackPanel Spacing="6">
                <TextBlock Text="BRUSH" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ReyTextDimBrush}" />

                <ColorPicker Color="{Binding PaintColor}" HorizontalAlignment="Stretch"
                             IsAlphaVisible="False" IsColorPaletteVisible="True"
                             ToolTip.Tip="The colour laid down. Alpha is never painted — it carries cutout data for foliage." />

                <TextBlock Text="{Binding PaintRadius, StringFormat='Size  {0:0} world units'}" FontSize="11"
                           Foreground="{DynamicResource ReyTextBrush}" />
                <Slider Minimum="10" Maximum="1200" Value="{Binding PaintRadius}"
                        ToolTip.Tip="Radius in world units, not texels — so the brush stays the same physical size whatever the surface's texture density." />

                <TextBlock Text="{Binding PaintOpacity, StringFormat='Strength  {0:0.00}'}" FontSize="11"
                           Foreground="{DynamicResource ReyTextBrush}" />
                <Slider Minimum="0.02" Maximum="1" Value="{Binding PaintOpacity}" />

                <TextBlock Text="{Binding PaintHardness, StringFormat='Hardness  {0:0.00}'}" FontSize="11"
                           Foreground="{DynamicResource ReyTextBrush}" />
                <Slider Minimum="0" Maximum="1" Value="{Binding PaintHardness}"
                        ToolTip.Tip="How much of the radius is full strength before the edge falls off. 1 = hard edge." />

                <TextBlock Text="{Binding PaintSeamBleed, StringFormat='Seam bleed  {0:0} texels'}" FontSize="11"
                           Foreground="{DynamicResource ReyTextBrush}" />
                <Slider Minimum="0" Maximum="12" Value="{Binding PaintSeamBleed}"
                        ToolTip.Tip="How far paint carries past a UV island's edge. Without it a stroke crossing a seam leaves a hairline crack, which filtering and mipmaps widen." />

                <!-- M173: blend mode -->
                <TextBlock Text="Blend" FontSize="11" Foreground="{DynamicResource ReyTextBrush}" Margin="0,4,0,0" />
                <ComboBox ItemsSource="{Binding PaintBlendModes}" SelectedItem="{Binding PaintBlendMode}"
                          HorizontalAlignment="Stretch" FontSize="11"
                          ToolTip.Tip="How the colour combines with what is already on the texture. Multiply darkens, Screen lightens, Overlay adds contrast while keeping detail, and Color recolours a surface without flattening the detail painted into it." />

                <!-- M173: brush mask / stencil -->
                <TextBlock Text="Brush tip" FontSize="11" Foreground="{DynamicResource ReyTextBrush}" Margin="0,4,0,0" />
                <ListBox ItemsSource="{Binding BrushMasks}" SelectedItem="{Binding PaintMask}"
                         MaxHeight="132" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ToolTip.Tip="A stencil shapes the dab. With one loaded the tip is a SQUARE of the brush size and the mask defines coverage, so Hardness applies only to the plain round tip — the same model paint programs use.">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:BrushMaskOption">
                      <Border Width="52" Height="60" Margin="1" CornerRadius="4" Padding="2"
                              Background="{DynamicResource ReyPanelAltBrush}" ToolTip.Tip="{Binding Name}">
                        <StackPanel>
                          <Border Height="40" CornerRadius="3" Background="#20000000">
                            <Panel>
                              <Ellipse Width="30" Height="30" Stroke="{DynamicResource ReyTextDimBrush}"
                                       StrokeThickness="1" StrokeDashArray="2,2"
                                       IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}" />
                              <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2" />
                            </Panel>
                          </Border>
                          <TextBlock Text="{Binding Name}" FontSize="8" HorizontalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                     Foreground="{DynamicResource ReyTextDimBrush}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Button Classes="tool" Content="📁 Add mask image…" Command="{Binding LoadBrushMaskCommand}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="10" Padding="6,3"
                        ToolTip.Tip="Import any PNG, TGA, DDS or .tex as a stencil. Colour folds to luminance and multiplies by alpha, so both a black-on-white stamp and an RGBA sprite work." />
                <TextBlock Text="{Binding PaintMaskAngle, StringFormat='Tip angle  {0:0}°'}" FontSize="11"
                           Foreground="{DynamicResource ReyTextBrush}" />
                <Slider Minimum="0" Maximum="360" Value="{Binding PaintMaskAngle}"
                        ToolTip.Tip="Rotates the stencil in the surface plane." />

                <Border Background="{DynamicResource ReyPanelAltBrush}" CornerRadius="4" Padding="8,6"
                        IsVisible="{Binding PaintHover, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="{Binding PaintHover}" FontSize="10" TextWrapping="Wrap"
                             Foreground="{DynamicResource ReyTextDimBrush}" />
                </Border>

                <Button Classes="primary" Content="💾 Save painted textures"
                        Command="{Binding SavePaintedTexturesCommand}" IsEnabled="{Binding HasUnsavedPaint}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        FontSize="11" Padding="8,5"
                        ToolTip.Tip="Encode every painted texture back into its original .tex format and write it into the project." />
                <TextBlock Text="{Binding PaintStatus}" FontSize="10" TextWrapping="Wrap"
                           Foreground="{DynamicResource ReyTextDimBrush}" />
              </StackPanel>
            </Border>

            <!-- M104: view toggles in TWO rows (one row overflowed the viewport width).
                 Row 1 = history + shading/display · Row 2 = map lighting + tools. -->
            <StackPanel Spacing="4" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
              <Button Classes="tool" Content="↶" FontSize="13" Padding="7,2" Command="{Binding UndoCommand}"
                      IsEnabled="{Binding CanUndo}" ToolTip.Tip="{Binding UndoLabel}" />
              <Button Classes="tool" Content="↷" FontSize="13" Padding="7,2" Command="{Binding RedoCommand}"
                      IsEnabled="{Binding CanRedo}" ToolTip.Tip="{Binding RedoLabel}" />
              <ComboBox SelectedIndex="{Binding PreviewMode}" FontSize="11" MinWidth="120" VerticalAlignment="Center"
                        ToolTip.Tip="Preview shading mode">
                <ComboBoxItem>Basic</ComboBoxItem>
                <ComboBoxItem>Riot Approx</ComboBoxItem>
                <ComboBoxItem>Debug · Base</ComboBoxItem>
                <ComboBoxItem>Debug · Alpha</ComboBoxItem>
                <ComboBoxItem>Debug · Normals</ComboBoxItem>
                <ComboBoxItem>Debug · Mask</ComboBoxItem>
                <ComboBoxItem>Debug · Emissive</ComboBoxItem>
                <ComboBoxItem>Debug · MatCap</ComboBoxItem>
                <ComboBoxItem>Debug · UV Checker</ComboBoxItem>
                <ComboBoxItem>Debug · Specular</ComboBoxItem>
                <ComboBoxItem>Debug · Vertex Color</ComboBoxItem>
                <ComboBoxItem>Debug · Lightmap</ComboBoxItem>
                <ComboBoxItem>Debug · Face Orientation</ComboBoxItem>
                <ComboBoxItem>Debug · Two-Sided</ComboBoxItem>
                <ComboBoxItem>Debug · Mirrored</ComboBoxItem>
              </ComboBox>
              <ToggleButton Classes="vp" Content="◫ Wire" IsChecked="{Binding ShowWireframe}" ToolTip.Tip="Wireframe overlay" />
              <!-- M248 (phase 6, step 1): OpenGL <-> Direct3D 11. Swaps which of two sibling surfaces is
                   visible. M263 removed the A/B compare button - it had served its purpose, and the
                   FrameDiff machinery behind it stays for the harness. -->
              <ToggleButton Classes="vp" Content="DX11" IsChecked="{Binding UseDx11Viewport}"
                            ToolTip.Tip="Render this viewport with Direct3D 11 instead of OpenGL." />
              <!-- M263: pause freezes the animation clock where it is rather than resetting it.
                   M266: the same clock now drives the particles, so pausing freezes them too. That is a
                   stated difference from the OpenGL viewport, which never pauses its map particles - the
                   tooltip says so rather than leaving it to be discovered. -->
              <ToggleButton Classes="vp" Content="▶" IsChecked="{Binding AnimationsPlaying}"
                            IsVisible="{Binding UseDx11Viewport}"
                            ToolTip.Tip="Play or pause shader animation (scrolling UVs, flipbooks, flow) and particle simulation. Pausing holds the current moment; the camera still orbits it. OpenGL has no equivalent button, so its particles keep running." />
              <TextBlock Text="{Binding Dx11ViewportStatus}" VerticalAlignment="Center" Margin="8,0,0,0"
                         FontFamily="Consolas" FontSize="10" Opacity="0.7"
                         Foreground="{DynamicResource ReyTextBrush}"
                         IsVisible="{Binding UseDx11Viewport}"
                         ToolTip.Tip="{Binding Dx11ViewportDetail}" />
              <ToggleButton Classes="vp" Content="◪ Cull" IsChecked="{Binding CullBackfaces}"
                            ToolTip.Tip="Respect each material's cullEnable (single-sided materials cull backfaces; cullEnable=false renders two-sided with flipped-normal lighting). Off = force everything two-sided." />
              <ToggleButton Classes="vp" Content="🦴 Bones" IsChecked="{Binding ShowBones}" ToolTip.Tip="Show skeleton bones" />
              <ToggleButton Classes="vp" Content="▣ Bounds" IsChecked="{Binding ShowBounds}" ToolTip.Tip="Show bounding boxes" />
              <ToggleButton Classes="vp" Content="⬓ Regions" IsChecked="{Binding RenderRegionsEnabled}"
                            IsVisible="{Binding HasRenderRegions}"
                            ToolTip.Tip="Render meshes that belong to a render region (mapgeo v18 renderRegionHash). Off = hide every region-assigned mesh, leaving only the region-independent base geometry." />
              <ToggleButton Classes="vp" Content="🔊" IsChecked="{Binding ShowSoundIcons}"
                            ToolTip.Tip="Show audio placement icons" />
              <ToggleButton Classes="vp" Content="🧍" IsChecked="{Binding ShowPropIcons}"
                            ToolTip.Tip="Show mob / animated-prop icons" />
              <!-- M122: skybox picker (cubemaps, authored domes, sky textures, custom image) -->
              <ComboBox ItemsSource="{Binding SkyboxOptions}" SelectedIndex="{Binding SelectedSkyboxIndex}"
                        FontSize="10" MaxWidth="170" MaxDropDownHeight="420" VerticalAlignment="Center"
                        ToolTip.Tip="Skybox - League ships hundreds; pick one or use a custom image" />
            </StackPanel>

            <!-- row 2: map lighting + tools -->
            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
              <!-- M169: the lighting-mode segment stays in the viewport — it is the control you click
                   constantly while comparing a bake, and the rest of the lighting panel moved to
                   Tools ▸ Light ▸ Lighting…, which is what shortened this row. -->
              <Border IsVisible="{Binding HasMapGeo}"
                      Background="{DynamicResource ReyPanelAltBrush}" CornerRadius="4" Padding="2">
                <StackPanel Orientation="Horizontal" Spacing="1">
                  <ToggleButton Classes="vp" Content="Dynamic" IsChecked="{Binding IsLightingDynamic}"
                                ToolTip.Tip="Sun/sky fallback + editable point lights, no baked atlas — the live authoring view you bake from." />
                  <ToggleButton Classes="vp" Content="Baked" IsChecked="{Binding IsLightingBaked}"
                                ToolTip.Tip="Baked lightmap only, point lights off — how the map looks in game after a bake." />
                  <ToggleButton Classes="vp" Content="Combined" IsChecked="{Binding IsLightingCombined}"
                                ToolTip.Tip="Baked lightmap AND dynamic lights together — a debug overlay to compare the two." />
                </StackPanel>
              </Border>
              <ToggleButton Classes="vp" Content="✧ Particles" IsChecked="{Binding ShowParticles}"
                            IsVisible="{Binding HasParticles}"
                            ToolTip.Tip="Show placed particle-system markers (MapParticle)" />
              <ToggleButton Classes="vp" Content="🖌 Paint" IsChecked="{Binding IsPaintMode}"
                            IsVisible="{Binding HasMapGeo}"
                            ToolTip.Tip="Paint colour straight onto the map with a brush. Left-drag paints; the camera keeps Alt-drag and right-drag." />
              <ToggleButton Classes="vp" Content="⊞ Buckets" IsChecked="{Binding ShowBucketGrid}"
                            IsVisible="{Binding HasBucketGrids}"
                            ToolTip.Tip="Show the map's culling bucket grid: the baked scene mesh as 3D wireframe + the flat cell boundaries." />
              <Button Classes="tool" Content="⟳ Reload Map" Command="{Binding ReloadMapCommand}"
                      ToolTip.Tip="Re-decode the open map from its current bytes — after Save Map Edits or a materials change. Confirms if unsaved edits would be lost." />
              <Button Classes="tool" Content="⟳ Rebuild Grids" Command="{Binding RebuildBucketGridsCommand}"
                      IsVisible="{Binding HasBucketGrids}" FontSize="11" Padding="8,3" Margin="0"
                      ToolTip.Tip="Regenerate every bucket grid from the map's CURRENT geometry (after moving/scaling meshes). Preview updates immediately; saving the map writes the new grids into the mapgeo." />
              <Button Classes="tool" Content="➕ Add Mesh" Command="{Binding AddMeshToMapCommand}"
                      IsVisible="{Binding HasMapGeo}" FontSize="11" Padding="8,3" Margin="0"
                      ToolTip.Tip="Import a mesh (.obj / .scb / .sco) and append it to this map. Place it with the gizmo, pick its material in the inspector, then Save to Mod." />
              <Button Classes="tool" Content="Workshop" Command="{Binding OpenWorkshopCommand}"
                      IsVisible="{Binding HasMapGeo}" FontSize="11" Padding="8,3" Margin="0"
                      ToolTip.Tip="Add a complete Riot material or particle template directly to this map" />
              <Button Classes="tool" Content="⛶ Frame" Click="OnFrameClick" FontSize="11" Padding="8,3" Margin="0"
                      ToolTip.Tip="Frame the camera on the loaded content" />
            </StackPanel>
            </StackPanel>

            <Border Classes="glass" Padding="9,4"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" IsHitTestVisible="False">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock Text="VIEWPORT" FontSize="9" FontWeight="SemiBold" LetterSpacing="1.5"
                           Foreground="{DynamicResource ReyAccentBrush}" VerticalAlignment="Center" />
                <Border Width="1" Height="10" Background="{DynamicResource ReyBorderAccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="LMB orbit · Shift+LMB pan · wheel zoom"
                           FontSize="10" Foreground="{DynamicResource ReyTextDimBrush}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>

            <!-- M42: transform gizmo tools (Move/Rotate/Scale · Local/World · Snap) -->
            <Border Classes="glass" Padding="4,3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,46,0,0"
                    IsVisible="{Binding MapGeoInspector.HasMap}">
              <StackPanel Orientation="Horizontal" Spacing="3">
                <ToggleButton Classes="vp" Content="✥ Move" IsChecked="{Binding IsMoveMode, Mode=OneWay}"
                              Command="{Binding SetTransformModeCommand}" CommandParameter="0" ToolTip.Tip="Move gizmo (translate along an axis)" />
                <ToggleButton Classes="vp" Content="⟳ Rotate" IsChecked="{Binding IsRotateMode, Mode=OneWay}"
                              Command="{Binding SetTransformModeCommand}" CommandParameter="1" ToolTip.Tip="Rotate gizmo (drag a ring — horizontal drag = degrees)" />
                <ToggleButton Classes="vp" Content="⇲ Scale" IsChecked="{Binding IsScaleMode, Mode=OneWay}"
                              Command="{Binding SetTransformModeCommand}" CommandParameter="2" ToolTip.Tip="Scale gizmo (drag an axis handle out/in)" />
                <Border Width="1" Height="14" Background="{DynamicResource ReyBorderAccentBrush}" Margin="3,0" VerticalAlignment="Center" />
                <ToggleButton Classes="vp" Content="{Binding GizmoSpaceLabel}" IsChecked="{Binding GizmoLocalSpace}"
                              MinWidth="52" ToolTip.Tip="Gizmo axes: World or the mesh's Local space" />
                <ToggleButton Classes="vp" Content="⊞ Snap" IsChecked="{Binding SnapEnabled}"
                              ToolTip.Tip="Snap to increments — 100u move · 15° rotate · 0.25× scale" />
              </StackPanel>
            </Border>
          </Grid>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Row="1" Background="{DynamicResource ReyBorderBrush}" />

        <!-- CONTENT BROWSER (Unreal/Windows-style: folder tree + tiles) -->
        <Border Grid.Row="2" Background="{DynamicResource ReyPanelBrush}">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
              <TextBlock Classes="panelHeader" Text="CONTENT BROWSER" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="tool" Content="↑ Up" Margin="6,4"
                      Command="{Binding ContentBrowser.GoUpCommand}" IsEnabled="{Binding ContentBrowser.CanGoUp}" />
              <!-- M43: clickable breadcrumb path -->
              <Border Grid.Column="2" Background="{DynamicResource ReyPanelAltBrush}" CornerRadius="4"
                      Padding="4,1" Margin="2,4" VerticalAlignment="Center">
                <!-- M83 fix: Hidden, not Auto — the overlay scrollbar covered the whole ~20px path bar.
                     Explorer behaviour instead: auto-scroll to the END (current folder always visible)
                     + mouse wheel scrolls horizontally. Wired in code-behind. -->
                <ScrollViewer x:Name="BreadcrumbScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                  <StackPanel Orientation="Horizontal" Spacing="0">
                    <Button Classes="icon" Content="⌂" FontSize="12" Command="{Binding ContentBrowser.NavigateCrumbCommand}"
                            CommandParameter="{x:Null}" ToolTip.Tip="Project root" />
                    <ItemsControl ItemsSource="{Binding ContentBrowser.Breadcrumbs}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="0" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="0">
                            <TextBlock Text="›" Foreground="{DynamicResource ReyTextDimBrush}" VerticalAlignment="Center" FontSize="11" Margin="1,0" />
                            <Button Classes="icon" Content="{Binding Name}" FontSize="11"
                                    Command="{Binding $parent[ItemsControl].DataContext.ContentBrowser.NavigateCrumbCommand}"
                                    CommandParameter="{Binding}" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
              </Border>
              <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" Margin="6,0,2,0">
                <TextBlock Text="{Binding ContentBrowser.ItemCount, StringFormat='{}{0} items'}"
                           VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource ReyTextDimBrush}" />
                <TextBlock Text="(capped)" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource ReyWarningBrush}"
                           IsVisible="{Binding ContentBrowser.SearchTruncated}" ToolTip.Tip="Too many matches — showing the first 4000. Narrow the search or filter." />
                <!-- M100: what the bulk operations will act on -->
                <TextBlock Text="{Binding ContentBrowser.SelectionText}" VerticalAlignment="Center" FontSize="10"
                           Foreground="{DynamicResource ReyAccentBrush}" MaxWidth="130" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding ContentBrowser.HasSelection}" Margin="4,0,0,0" />
                <Button Classes="tool" Content="📁+ New Folder" FontSize="10" Padding="6,2"
                        Command="{Binding NewFolderCommand}"
                        ToolTip.Tip="Create a subfolder in the project. Uses the folder you're viewing when it's writable, otherwise your project folder. The name becomes part of the asset's WAD path." />
                <Button Classes="tool" Content="⬇ Import" FontSize="10" Padding="6,2"
                        Command="{Binding ImportFilesCommand}"
                        IsEnabled="{Binding ContentBrowser.CanImportHere}"
                        ToolTip.Tip="Copy files from your PC into the project. Uses the folder you're viewing when it's writable, otherwise your project folder." />
              </StackPanel>
              <ComboBox Grid.Column="4" ItemsSource="{Binding ContentBrowser.TypeFilters}" SelectedItem="{Binding ContentBrowser.TypeFilter}"
                        FontSize="11" MinWidth="98" Margin="2,4" ToolTip.Tip="Filter by asset type" />
              <ToggleButton Grid.Column="5" Classes="vp" Content="☰" FontSize="12" Padding="8,3" Margin="2,4"
                            IsChecked="{Binding ContentBrowser.ListView}" ToolTip.Tip="Toggle grid / list view" />
              <TextBox Grid.Column="6" Width="150" Watermark="🔎 Search…" Text="{Binding ContentBrowser.Filter}"
                       FontSize="11" Margin="4,4,8,4" Padding="6,2" />
            </Grid>
            <!-- folder tree + tiles -->
            <Grid ColumnDefinitions="200,4,*">
              <TreeView Grid.Column="0" x:Name="BrowserFolderTree" ItemsSource="{Binding ContentBrowser.FolderRoots}"
                        SelectedItem="{Binding ContentBrowser.SelectedFolder, Mode=TwoWay}"
                        Background="Transparent" BorderThickness="0" DragDrop.AllowDrop="True">
                <TreeView.ItemTemplate>
                  <TreeDataTemplate ItemsSource="{Binding Folders}">
                    <StackPanel Orientation="Horizontal" Spacing="5" Background="Transparent">
                      <StackPanel.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="New Folder…" Command="{Binding $parent[Window].DataContext.NewFolderCommand}" CommandParameter="{Binding}" />
                          <MenuItem Header="Import Files…" Command="{Binding $parent[Window].DataContext.ImportFilesCommand}" CommandParameter="{Binding}" />
                          <Separator />
                          <MenuItem Header="Rename Folder…" Command="{Binding $parent[Window].DataContext.RenameAssetCommand}" CommandParameter="{Binding}" />
                          <MenuItem Header="Delete Folder" Command="{Binding $parent[Window].DataContext.DeleteAssetCommand}" CommandParameter="{Binding}" />
                          <Separator />
                          <MenuItem Header="Show in Explorer" Command="{Binding $parent[Window].DataContext.ShowInExplorerCommand}" CommandParameter="{Binding}" />
                          <MenuItem Header="Refresh" Command="{Binding $parent[Window].DataContext.RefreshBrowserCommand}" />
                        </ContextMenu>
                      </StackPanel.ContextMenu>
                      <TextBlock Text="{Binding Icon}" FontSize="12" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource ReyTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                  </TreeDataTemplate>
                </TreeView.ItemTemplate>
              </TreeView>
              <GridSplitter Grid.Column="1" Background="{DynamicResource ReyBorderBrush}" />
              <DockPanel Grid.Column="2">
                <!-- M50: the materials quick-list was removed from the Content Browser — selecting a
                     .materials.bin/skin .bin now opens the INSPECTOR's Materials tab (right panel). -->
                <Grid x:Name="BrowserItemsPanel" DragDrop.AllowDrop="True" Background="Transparent">
                <ScrollViewer Padding="6,4" IsVisible="{Binding !ContentBrowser.ListView}">
                <ItemsControl x:Name="BrowserGrid" ItemsSource="{Binding ContentBrowser.Items}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <!-- M100: single click selects (Ctrl/Shift extend), double click opens — wired in
                           code-behind, so the tile carries no Click command of its own. -->
                      <Button Width="94" Height="86" Margin="4" Padding="2" Background="Transparent" CornerRadius="5"
                              ToolTip.Tip="{Binding Name}">
                        <Button.ContextMenu>
                          <ContextMenu>
                            <MenuItem Header="Open" Command="{Binding $parent[Window].DataContext.ContentBrowser.OpenCommand}" CommandParameter="{Binding}" />
                            <Separator />
                            <MenuItem Header="Copy Asset To Project" Command="{Binding $parent[Window].DataContext.CopyAssetToProjectCommand}" />
                            <MenuItem Header="Replace Selected Asset…" Command="{Binding $parent[Window].DataContext.ReplaceSelectedCommand}" />
                            <MenuItem Header="Revert Asset" Command="{Binding $parent[Window].DataContext.RevertSelectedCommand}" />
                            <Separator />
                            <!-- M100: these act on the whole browser selection -->
                            <MenuItem Header="New Folder…" Command="{Binding $parent[Window].DataContext.NewFolderCommand}" />
  <MenuItem Header="Import Files…" Command="{Binding $parent[Window].DataContext.ImportFilesCommand}" />
                            <MenuItem Header="Copy To…" Command="{Binding $parent[Window].DataContext.CopySelectionToCommand}" />
                            <MenuItem Header="Move To…" Command="{Binding $parent[Window].DataContext.MoveSelectionToCommand}" />
                            <MenuItem Header="Delete" Command="{Binding $parent[Window].DataContext.DeleteSelectionCommand}" />
                            <MenuItem Header="Rename…" Command="{Binding $parent[Window].DataContext.RenameAssetCommand}" CommandParameter="{Binding}" />
                            <MenuItem Header="Select All" Command="{Binding $parent[Window].DataContext.ContentBrowser.SelectAllCommand}" />
                            <Separator />
                            <MenuItem Header="Open in Text Editor" Command="{Binding $parent[Window].DataContext.OpenInTextEditorCommand}" CommandParameter="{Binding}" />
                            <MenuItem Header="Open in Map Bin Editor" Command="{Binding $parent[Window].DataContext.OpenInMapBinEditorCommand}" CommandParameter="{Binding}" />
                            <MenuItem Header="Open in Particle Editor" Command="{Binding $parent[Window].DataContext.OpenInParticleEditorCommand}" CommandParameter="{Binding}" />
                            <MenuItem Header="Open in Audio Editor" Command="{Binding $parent[Window].DataContext.OpenInAudioEditorCommand}" CommandParameter="{Binding}" />
                            <MenuItem Header="Open in HUD Editor" Command="{Binding $parent[Window].DataContext.OpenInHudEditorCommand}" CommandParameter="{Binding}" />
                            <MenuItem Header="Show in Explorer" Command="{Binding $parent[Window].DataContext.ShowInExplorerCommand}" CommandParameter="{Binding}" />
                            <Separator />
                            <MenuItem Header="Export…" Command="{Binding $parent[Window].DataContext.ExportSelectedCommand}" />
                            <MenuItem Header="Copy Resolved Path" Command="{Binding $parent[Window].DataContext.CopyResolvedPathCommand}" />
                            <MenuItem Header="Copy Hash" Command="{Binding $parent[Window].DataContext.CopyHashCommand}" />
                            <MenuItem Header="Refresh" Command="{Binding $parent[Window].DataContext.RefreshBrowserCommand}" />
                          </ContextMenu>
                        </Button.ContextMenu>
                        <!-- M39: Unreal-style asset tile — thumb card + type badge + status icons -->
                        <Grid>
                        <!-- M100: multi-selection highlight -->
                        <Border Background="{DynamicResource ReyAccentBrush}" Opacity="0.30" CornerRadius="4"
                                Margin="-2" IsVisible="{Binding IsSelected}" />
                        <StackPanel>
                          <Border Background="{DynamicResource ReyPanelAltBrush}" BorderBrush="{DynamicResource ReyBorderSoftBrush}"
                                  BorderThickness="1" CornerRadius="5" Width="66" Height="46" HorizontalAlignment="Center" ClipToBounds="True">
                            <Grid>
                              <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                              <TextBlock Text="{Binding Icon}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                         IsVisible="{Binding !HasThumbnail}" />
                              <Border Classes="badge accent" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"
                                      Padding="3,0" IsVisible="{Binding Kind, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding Kind}" FontSize="7" />
                              </Border>
                              <TextBlock Text="🔒" FontSize="9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,2,0,0"
                                         IsVisible="{Binding IsReadOnly}" ToolTip.Tip="Read-only Riot reference" />
                            </Grid>
                          </Border>
                          <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" Margin="0,3,0,0">
                            <TextBlock Text="⚠" FontSize="8" Foreground="{DynamicResource ReyWarningBrush}" VerticalAlignment="Center"
                                       IsVisible="{Binding HasConflict}" ToolTip.Tip="Conflicts with another mount" />
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{DynamicResource ReyAccent2Brush}"
                                     IsVisible="{Binding IsModified}" ToolTip.Tip="Modified in this project" />
                            <TextBlock Text="{Binding Name}" FontSize="9" Foreground="{DynamicResource ReyTextBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="78" VerticalAlignment="Center" />
                          </StackPanel>
                        </StackPanel>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>

                <!-- M43: compact list view (alternative to the tile grid) -->
                <ScrollViewer Padding="4,2" IsVisible="{Binding ContentBrowser.ListView}">
                  <ItemsControl x:Name="BrowserList" ItemsSource="{Binding ContentBrowser.Items}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent"
                                BorderThickness="0" CornerRadius="3" Padding="6,3"
                                ToolTip.Tip="{Binding Name}">
                          <Button.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="Open" Command="{Binding $parent[Window].DataContext.ContentBrowser.OpenCommand}" CommandParameter="{Binding}" />
                              <Separator />
                              <MenuItem Header="Copy Asset To Project" Command="{Binding $parent[Window].DataContext.CopyAssetToProjectCommand}" />
                              <MenuItem Header="Replace Selected Asset…" Command="{Binding $parent[Window].DataContext.ReplaceSelectedCommand}" />
                              <MenuItem Header="Revert Asset" Command="{Binding $parent[Window].DataContext.RevertSelectedCommand}" />
                              <Separator />
                              <!-- M100: these act on the whole browser selection -->
                              <MenuItem Header="New Folder…" Command="{Binding $parent[Window].DataContext.NewFolderCommand}" />
  <MenuItem Header="Import Files…" Command="{Binding $parent[Window].DataContext.ImportFilesCommand}" />
                              <MenuItem Header="Copy To…" Command="{Binding $parent[Window].DataContext.CopySelectionToCommand}" />
                              <MenuItem Header="Move To…" Command="{Binding $parent[Window].DataContext.MoveSelectionToCommand}" />
                              <MenuItem Header="Delete" Command="{Binding $parent[Window].DataContext.DeleteSelectionCommand}" />
                              <MenuItem Header="Rename…" Command="{Binding $parent[Window].DataContext.RenameAssetCommand}" CommandParameter="{Binding}" />
                              <MenuItem Header="Select All" Command="{Binding $parent[Window].DataContext.ContentBrowser.SelectAllCommand}" />
                              <Separator />
                              <MenuItem Header="Open in Text Editor" Command="{Binding $parent[Window].DataContext.OpenInTextEditorCommand}" CommandParameter="{Binding}" />
                              <MenuItem Header="Open in Map Bin Editor" Command="{Binding $parent[Window].DataContext.OpenInMapBinEditorCommand}" CommandParameter="{Binding}" />
                            <MenuItem Header="Open in Particle Editor" Command="{Binding $parent[Window].DataContext.OpenInParticleEditorCommand}" CommandParameter="{Binding}" />
                            <MenuItem Header="Open in Audio Editor" Command="{Binding $parent[Window].DataContext.OpenInAudioEditorCommand}" CommandParameter="{Binding}" />
                            <MenuItem Header="Open in HUD Editor" Command="{Binding $parent[Window].DataContext.OpenInHudEditorCommand}" CommandParameter="{Binding}" />
                              <MenuItem Header="Show in Explorer" Command="{Binding $parent[Window].DataContext.ShowInExplorerCommand}" CommandParameter="{Binding}" />
                              <Separator />
                              <MenuItem Header="Export…" Command="{Binding $parent[Window].DataContext.ExportSelectedCommand}" />
                              <MenuItem Header="Copy Resolved Path" Command="{Binding $parent[Window].DataContext.CopyResolvedPathCommand}" />
                              <MenuItem Header="Copy Hash" Command="{Binding $parent[Window].DataContext.CopyHashCommand}" />
                              <MenuItem Header="Refresh" Command="{Binding $parent[Window].DataContext.RefreshBrowserCommand}" />
                            </ContextMenu>
                          </Button.ContextMenu>
                          <Grid>
                          <!-- M100: multi-selection highlight -->
                          <Border Background="{DynamicResource ReyAccentBrush}" Opacity="0.30" CornerRadius="3"
                                  Margin="-6,-3" IsVisible="{Binding IsSelected}" />
                          <Grid ColumnDefinitions="Auto,32,*,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Border Grid.Column="1" Classes="badge accent" VerticalAlignment="Center" Padding="3,0"
                                    IsVisible="{Binding Kind, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                              <TextBlock Text="{Binding Kind}" FontSize="7" />
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource ReyTextBrush}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0" />
                            <TextBlock Grid.Column="3" Text="🔒" FontSize="9" VerticalAlignment="Center" Margin="2,0"
                                       IsVisible="{Binding IsReadOnly}" ToolTip.Tip="Read-only Riot reference" />
                            <Ellipse Grid.Column="4" Width="6" Height="6" VerticalAlignment="Center" Margin="4,0" Fill="{DynamicResource ReyAccent2Brush}"
                                     IsVisible="{Binding IsModified}" ToolTip.Tip="Modified in this project" />
                          </Grid>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                </Grid>
              </DockPanel>
            </Grid>
          </DockPanel>
        </Border>
      </Grid>

        <GridSplitter Grid.Row="1" Background="{DynamicResource ReyBorderBrush}" />

        <Border Grid.Row="2" Background="{DynamicResource ReyPanelBrush}">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto">
              <TextBlock Classes="panelHeader" Text="CONSOLE · IMPORT LOG" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="8,0">
                <StackPanel Orientation="Horizontal" Spacing="3"><Ellipse Width="6" Height="6" Fill="{DynamicResource ReyTextDimBrush}" VerticalAlignment="Center"/><TextBlock Text="info" FontSize="9" Foreground="{DynamicResource ReyTextDimBrush}"/></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="3"><Ellipse Width="6" Height="6" Fill="{DynamicResource ReySuccessBrush}" VerticalAlignment="Center"/><TextBlock Text="success" FontSize="9" Foreground="{DynamicResource ReyTextDimBrush}"/></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="3"><Ellipse Width="6" Height="6" Fill="{DynamicResource ReyWarningBrush}" VerticalAlignment="Center"/><TextBlock Text="warning" FontSize="9" Foreground="{DynamicResource ReyTextDimBrush}"/></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="3"><Ellipse Width="6" Height="6" Fill="{DynamicResource ReyErrorBrush}" VerticalAlignment="Center"/><TextBlock Text="error" FontSize="9" Foreground="{DynamicResource ReyTextDimBrush}"/></StackPanel>
              </StackPanel>
              <Button Grid.Column="2" Classes="tool" Content="🗑 Clear"
                      Command="{Binding ClearConsoleCommand}" Margin="0,4,8,0" FontSize="11" />
            </Grid>
            <ListBox Classes="console" ItemsSource="{Binding Console.Entries}"
                     Background="Transparent" BorderThickness="0" Padding="6,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}"
                             FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"
                             TextWrapping="Wrap" Margin="0,1" HorizontalAlignment="Stretch"
                             Foreground="{Binding Level, Converter={StaticResource LevelToBrush}}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
      </Grid>

      <GridSplitter Grid.Column="3" Background="{DynamicResource ReyBorderBrush}" />

      <!-- RIGHT: Inspector -->
      <Border Grid.Column="4" Background="{DynamicResource ReyPanelBrush}">
        <DockPanel>
          <TextBlock Classes="panelHeader" DockPanel.Dock="Top" Text="INSPECTOR" />
          <ScrollViewer>
            <StackPanel Margin="10" Spacing="8">
              <!-- M50: Unity-style scene-object sections (Transform / Mesh Details / Particle / Placeable)
                   for the outliner/viewport selection — moved here from the left outliner -->
              <views:SceneObjectInspectorView />

              <!-- M351c: the asset identity card moved into InspectorView, so the whole inspector -
                   header, tabs and all - lives in one file. -->
              <views:InspectorHeaderView />

              <!-- texture preview (M90: closable — there was no way back out of it) -->
              <Border Background="{DynamicResource ReyBgBrush}" CornerRadius="4" Padding="8"
                      IsVisible="{Binding Inspector.HasPreview}">
                <StackPanel Spacing="6">
                  <Button Classes="tool" Content="✕ Close preview" HorizontalAlignment="Right" FontSize="10" Padding="6,2"
                          Command="{Binding Inspector.ClearPreviewCommand}" />
                  <Image Source="{Binding Inspector.PreviewImage}" Stretch="Uniform" MaxHeight="340" />
                </StackPanel>
              </Border>

              <TextBlock Text="{Binding Inspector.Details}" Foreground="{DynamicResource ReyTextDimBrush}"
                         FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" TextWrapping="Wrap" />

              <!-- note (e.g. bin placeholder) -->
              <Border Background="{DynamicResource ReyPanelAltBrush}" CornerRadius="4" Padding="8"
                      IsVisible="{Binding Inspector.HasNote}">
                <TextBlock Text="{Binding Inspector.Note}" Foreground="{DynamicResource ReyAccent2Brush}"
                           FontSize="11" TextWrapping="Wrap" />
              </Border>

              <views:InspectorView />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

    </Grid>
  </DockPanel>
</Window>
