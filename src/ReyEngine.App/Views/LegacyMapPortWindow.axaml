<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ReyEngine.App.Views"
        xmlns:vm="clr-namespace:ReyEngine.App.ViewModels"
        x:Class="ReyEngine.App.Views.LegacyMapPortWindow"
        x:DataType="vm:LegacyMapPortWindowViewModel"
        Title="ReyEngine - Port Legacy Map" Width="820" Height="660" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterOwner" ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource ReyBgBrush}">
  <DockPanel>
    <views:ReyTitleBar DockPanel.Dock="Top" />
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource ReyHeaderBrush}"
            BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="0,1,0,0" Padding="14,10">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="16,5" />
          <Button Classes="primary" Content="Port Map" Command="{Binding ConfirmCommand}" Padding="16,5" />
        </StackPanel>
        <TextBlock Text="{Binding Status}" FontSize="11" VerticalAlignment="Center"
                   Foreground="{DynamicResource ReyTextDimBrush}" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <ScrollViewer>
      <StackPanel Margin="18" Spacing="12">
        <TextBlock Text="Legacy material mapping" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource ReyTextDimBrush}" />
        <Border Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Classes="cardTitle" Text="SHADER ASSIGNMENT" />
            <TextBlock Text="ReyEngine classifies the old surfaces, but you choose the modern shader used for each role. These selections are applied to every generated material and replace earlier guessed legacy materials when the map is ported again."
                       FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource ReyTextDimBrush}" />
          </StackPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding ShaderRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LegacyPortShaderRowViewModel">
              <Border Classes="card" Margin="0,0,0,8">
                <StackPanel Spacing="6">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="10"
                               Foreground="{DynamicResource ReyAccentBrush}" />
                    <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" />
                  </DockPanel>
                  <TextBlock Text="{Binding Hint}" FontSize="10" TextWrapping="Wrap"
                             Foreground="{DynamicResource ReyTextDimBrush}" />
                  <ComboBox ItemsSource="{Binding ShaderChoices}" SelectedItem="{Binding SelectedShader, Mode=TwoWay}"
                            MaxDropDownHeight="360" HorizontalAlignment="Stretch" FontSize="10" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Classes="card">
          <StackPanel Spacing="7">
            <TextBlock Classes="cardTitle" Text="INDIVIDUAL MATERIAL OVERRIDES" />
            <TextBlock Text="The role choices above update every matching material. You can override any generated material below when the automatic classification needs a different shader."
                       FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource ReyTextDimBrush}" />
            <ListBox ItemsSource="{Binding Materials}" Height="280">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LegacyPortMaterialRowViewModel">
                  <Grid ColumnDefinitions="210,100,*" Margin="2,3">
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="{Binding Name}" FontSize="10" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding Name}" />
                      <TextBlock Text="{Binding TextureName}" FontSize="9" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding RoleText}" FontSize="9" VerticalAlignment="Center"
                               Foreground="{DynamicResource ReyAccentBrush}" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding ShaderChoices}"
                              SelectedItem="{Binding SelectedShader, Mode=TwoWay}" MaxDropDownHeight="320" FontSize="9" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>
        <Border Classes="card">
          <TextBlock Text="Decal blending is render state, not a different shader: source alpha is blended over the destination and does not write opaque depth. Texture bindings and four-layer terrain values remain attached to each generated material."
                     FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource ReyTextDimBrush}" />
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
