<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ReyEngine.App.Views"
        xmlns:vm="clr-namespace:ReyEngine.App.ViewModels"
        x:Class="ReyEngine.App.Views.LegacyMapPortWindow"
        x:DataType="vm:LegacyMapPortWindowViewModel"
        Title="ReyEngine - Port Legacy Map" Width="860" Height="760" MinWidth="680" MinHeight="520"
        WindowStartupLocation="CenterOwner" ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource ReyBgBrush}">
  <DockPanel>
    <views:ReyTitleBar DockPanel.Dock="Top" />
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource ReyHeaderBrush}"
            BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="0,1,0,0" Padding="14,10">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="16,5" />
          <Button Classes="primary" Content="Port Map" Command="{Binding ConfirmCommand}" Padding="16,5" />
        </StackPanel>
        <TextBlock Text="{Binding Status}" FontSize="11" VerticalAlignment="Center"
                   Foreground="{DynamicResource ReyTextDimBrush}" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <ScrollViewer>
      <StackPanel Margin="18" Spacing="12">
        <TextBlock Text="Legacy material mapping" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource ReyTextDimBrush}" />
        <Border Classes="card" BorderBrush="#EAB640" BorderThickness="1">
          <StackPanel Spacing="7">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                <Button Content="Full replacement" Command="{Binding FullReplacementCommand}" FontSize="9" Padding="9,4" />
                <Button Content="Keep support content" Command="{Binding KeepDestinationSupportCommand}" FontSize="9" Padding="9,4" />
                <Button Content="Keep everything" Command="{Binding KeepEverythingCommand}" FontSize="9" Padding="9,4" />
              </StackPanel>
              <TextBlock Classes="cardTitle" Text="DESTINATION CLEANUP" Foreground="#EAB640" />
            </DockPanel>
            <TextBlock Text="Choose what ReyEngine removes from the modern map used as the destination container. Render-region meshes are always protected. Full replacement is the safest starting point when retained map-specific objects crash the game; disable bush deletion when the old map has no bushes of its own."
                       FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource ReyTextDimBrush}" />
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="3">
              <CheckBox Grid.Row="0" Grid.Column="0" Content="{Binding MeshCleanupText}" IsChecked="{Binding RemoveOriginalMeshes}" FontSize="10" />
              <CheckBox Grid.Row="0" Grid.Column="1" Content="{Binding BushCleanupText}" IsChecked="{Binding RemoveOriginalBushes}" FontSize="10" />
              <CheckBox Grid.Row="1" Grid.Column="0" Content="{Binding MaterialCleanupText}" IsChecked="{Binding RemoveUnusedOriginalMaterials}" FontSize="10" />
              <CheckBox Grid.Row="1" Grid.Column="1" Content="{Binding ParticleCleanupText}" IsChecked="{Binding RemoveOriginalParticles}" FontSize="10" />
              <CheckBox Grid.Row="2" Grid.Column="0" Content="{Binding PropCleanupText}" IsChecked="{Binding RemoveOriginalProps}" FontSize="10" />
              <CheckBox Grid.Row="2" Grid.Column="1" Content="{Binding SoundCleanupText}" IsChecked="{Binding RemoveOriginalSounds}" FontSize="10" />
              <CheckBox Grid.Row="3" Grid.Column="0" Content="{Binding ProbeCleanupText}" IsChecked="{Binding RemoveOriginalProbes}" FontSize="10" />
              <!-- M531: the only IMPORT switch in a grid of removals, so it says so. -->
              <CheckBox Grid.Row="3" Grid.Column="1" Content="Import source particles" IsChecked="{Binding ImportLegacyParticles}" FontSize="10"
                        ToolTip.Tip="Bring the source map's own particles across: its Particles.dat placement list and each .troybin it names. Placed with the same position correction the geometry gets." />
              <CheckBox Grid.Row="4" Grid.Column="0" Content="Import source sounds" IsChecked="{Binding ImportLegacySounds}" FontSize="10"
                        ToolTip.Tip="Re-host the source client's map audio in a bank this map already loads. The legacy banks are too old for the current client to read, so the original audio is repacked at the current bank version; media the game still ships is skipped. The legacy client stores no sound positions, so only the ambience bed is placed - the rest arrive as named events you can place yourself." />
            </Grid>
            <Border Background="#261F12" BorderBrush="#80601D" BorderThickness="1" CornerRadius="4" Padding="8,6">
              <TextBlock Text="{Binding CleanupOutcome}" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap"
                         Foreground="#F2C45E" />
            </Border>
            <TextBlock Text="Material cleanup is dependency-aware: it removes only StaticMaterialDefs no longer referenced by the final mapgeo or any retained bin object."
                       FontSize="9" TextWrapping="Wrap" Foreground="{DynamicResource ReyTextDimBrush}" />
          </StackPanel>
        </Border>
        <Border Classes="card" BorderBrush="#4B79C9" BorderThickness="1">
          <StackPanel Spacing="6">
            <TextBlock Classes="cardTitle" Text="IMPORTED MAP ALIGNMENT" Foreground="#73A7FF" />
            <CheckBox Content="Fix legacy map position automatically" IsChecked="{Binding FixImportedMapPosition}"
                      FontSize="11" FontWeight="SemiBold" />
            <!-- M473: editable. This was a hardcoded constant, so an alignment that turned out to be some
                 hundreds of units off could not be corrected without a rebuild. -->
            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" IsEnabled="{Binding FixImportedMapPosition}">
              <TextBlock Grid.Column="0" Text="X" FontSize="10" VerticalAlignment="Center" Margin="0,0,3,0" Foreground="#E5645B" />
              <TextBox Grid.Column="1" Text="{Binding CorrectionX}" FontSize="10" Padding="3,1" />
              <TextBlock Grid.Column="2" Text="Y" FontSize="10" VerticalAlignment="Center" Margin="5,0,3,0" Foreground="#53C67A" />
              <TextBox Grid.Column="3" Text="{Binding CorrectionY}" FontSize="10" Padding="3,1" />
              <TextBlock Grid.Column="4" Text="Z" FontSize="10" VerticalAlignment="Center" Margin="5,0,3,0" Foreground="#4C9FE8" />
              <TextBox Grid.Column="5" Text="{Binding CorrectionZ}" FontSize="10" Padding="3,1" />
            </Grid>
            <TextBlock Text="Moves ONLY the imported NVR/WGEO geometry. The default (X +1000.834, Y -51.318, Z +499.388) is the measured correction; it replaced an earlier +600.406 / -66.972 / +293.744, so a map ported by an older build sits about 400 units off on X and can be reconciled with Nudge Imported Geometry on the inspector's Map tab. Destination render regions, retained bushes, mobs, particles and sounds are never moved."
                       FontSize="9" TextWrapping="Wrap" Foreground="{DynamicResource ReyTextDimBrush}" />
          </StackPanel>
        </Border>
        <Border Classes="card" BorderBrush="#C98A4B" BorderThickness="1">
          <StackPanel Spacing="6">
            <TextBlock Classes="cardTitle" Text="DECAL GEOMETRY" Foreground="#FFB973" />
            <CheckBox Content="Rebuild decals as flat planes" IsChecked="{Binding GenerateDecalQuads}"
                      FontSize="11" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="Auto,80,*" IsEnabled="{Binding GenerateDecalQuads}">
              <TextBlock Grid.Column="0" Text="Lift" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0" />
              <TextBox Grid.Column="1" Text="{Binding DecalLift}" FontSize="10" Padding="3,1" />
              <TextBlock Grid.Column="2" Text="world units above the ground" FontSize="9" VerticalAlignment="Center"
                         Margin="6,0,0,0" Foreground="{DynamicResource ReyTextDimBrush}" />
            </Grid>
            <CheckBox Content="One image per plane (authored scale)" IsChecked="{Binding DecalSingleImage}"
                      IsEnabled="{Binding GenerateDecalQuads}" FontSize="10" />
            <TextBlock Text="Off (recommended): the plane keeps the patch&apos;s own UV range, so the texture stays exactly the size it was and repeats across the plane as it did on the terrain. On: the plane gets a clean 0..1 so its image appears once at authored scale - but a legacy patch spans a median 1.92 x 1.78 texture tiles, so the decal then covers only about 30% of the ground it used to."
                       FontSize="9" TextWrapping="Wrap" Foreground="{DynamicResource ReyTextDimBrush}" />
            <TextBlock Text="A legacy decal is not a stamp: it is an irregular patch of TERRAIN carrying a UV field that repeats, and every decal of one texture is welded into a single sheet. Rebuilding replaces those patches with one flat plane per texture tile, each carrying the whole image and each selectable and movable on its own. Measured on Map2 that is 241 planes in place of 1,036 patches. The trade is real: a plane no longer follows the ground, so over uneven terrain it will clip. Leave this off to keep the original terrain-conforming patches."
                       FontSize="9" TextWrapping="Wrap" Foreground="{DynamicResource ReyTextDimBrush}" />
          </StackPanel>
        </Border>
        <Border Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Classes="cardTitle" Text="SHADER ASSIGNMENT" />
            <TextBlock Text="ReyEngine classifies the old surfaces, but you choose the modern shader used for each role. These selections are applied to every generated material and replace earlier guessed legacy materials when the map is ported again."
                       FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource ReyTextDimBrush}" />
          </StackPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding ShaderRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LegacyPortShaderRowViewModel">
              <Border Classes="card" Margin="0,0,0,8">
                <StackPanel Spacing="6">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontSize="10"
                               Foreground="{DynamicResource ReyAccentBrush}" />
                    <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" />
                  </DockPanel>
                  <TextBlock Text="{Binding Hint}" FontSize="10" TextWrapping="Wrap"
                             Foreground="{DynamicResource ReyTextDimBrush}" />
                  <ComboBox ItemsSource="{Binding ShaderChoices}" SelectedItem="{Binding SelectedShader, Mode=TwoWay}"
                            MaxDropDownHeight="360" HorizontalAlignment="Stretch" FontSize="10" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Classes="card">
          <StackPanel Spacing="7">
            <TextBlock Classes="cardTitle" Text="INDIVIDUAL MATERIAL OVERRIDES" />
            <TextBlock Text="The role choices above update every matching material. You can override any generated material below when the automatic classification needs a different shader."
                       FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource ReyTextDimBrush}" />
            <ListBox ItemsSource="{Binding Materials}" Height="280">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LegacyPortMaterialRowViewModel">
                  <Grid ColumnDefinitions="210,100,*" Margin="2,3">
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="{Binding Name}" FontSize="10" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding Name}" />
                      <TextBlock Text="{Binding TextureName}" FontSize="9" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding RoleText}" FontSize="9" VerticalAlignment="Center"
                               Foreground="{DynamicResource ReyAccentBrush}" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding ShaderChoices}"
                              SelectedItem="{Binding SelectedShader, Mode=TwoWay}" MaxDropDownHeight="320" FontSize="9" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>
        <Border Classes="card">
          <TextBlock Text="Decal blending is render state, not a different shader: source alpha is blended over the destination and does not write opaque depth. Texture bindings and four-layer terrain values remain attached to each generated material."
                     FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource ReyTextDimBrush}" />
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
