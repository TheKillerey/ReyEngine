<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ReyEngine.App.Views"
        xmlns:vm="clr-namespace:ReyEngine.App.ViewModels"
        x:Class="ReyEngine.App.Views.CleanupWindow"
        x:DataType="vm:CleanupWindowViewModel"
        Title="ReyEngine — Cleanup Project" Width="1000" Height="740"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource ReyBgBrush}">
  <DockPanel>
    <views:ReyTitleBar DockPanel.Dock="Top" />

    <!-- Footer: totals + the two terminal actions -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource ReyHeaderBrush}"
            BorderBrush="{DynamicResource ReyBorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding SelectionSummary}" FontSize="12" FontWeight="Bold"
                     Foreground="{DynamicResource ReyTextBrush}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Status}" FontSize="10"
                     Foreground="{DynamicResource ReyTextDimBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Classes="tool" Content="↩ Undo Last Cleanup"
                Command="{Binding RestoreCommand}" IsEnabled="{Binding NotBusy}"
                IsVisible="{Binding CanRestore}" Margin="8,0,0,0"
                ToolTip.Tip="Move the files from the most recent cleanup back where they came from." />
        <Button Grid.Column="2" Classes="tool" Content="🧹 Clean Selected Files"
                Command="{Binding CleanSelectedCommand}" Margin="8,0,0,0"
                ToolTip.Tip="Moves the selected files into the project's cleanup backup folder. Nothing is permanently deleted — Undo puts them back." />
        <Button Grid.Column="3" Classes="tool" Content="Cancel" Margin="8,0,0,0"
                Click="OnCancel" ToolTip.Tip="Close without changing anything." />
      </Grid>
    </Border>

    <!-- Header: project, riot status, modes, scan -->
    <Border DockPanel.Dock="Top" Classes="card" Margin="14,14,14,6">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Grid.Column="0" Text="Project" FontSize="11" FontWeight="Bold"
                     Foreground="{DynamicResource ReyTextDimBrush}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding ProjectPath}" FontSize="11" Margin="10,0,0,0"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ProjectPath}"
                     VerticalAlignment="Center" Foreground="{DynamicResource ReyTextBrush}" />
          <Button Grid.Column="2" Classes="tool" Content="⟳ Scan Project"
                  Command="{Binding ScanCommand}" IsEnabled="{Binding NotBusy}"
                  ToolTip.Tip="Builds the preview. This step never modifies or deletes anything." />
        </Grid>

        <TextBlock Text="{Binding RiotStatus}" FontSize="10" TextWrapping="Wrap"
                   Foreground="{DynamicResource ReyTextDimBrush}" />

        <WrapPanel>
          <CheckBox Content="Remove unused files" IsChecked="{Binding RemoveUnused}" Margin="0,0,16,0"
                    ToolTip.Tip="Find files no game WAD ships and nothing in the project references." />
          <CheckBox Content="Remove original Riot files" IsChecked="{Binding RemoveRiotIdentical}"
                    IsEnabled="{Binding RiotModeEnabled}" Margin="0,0,16,0"
                    ToolTip.Tip="Find project copies that are identical to the Riot original, so the game can simply fall back to Riot's file. Needs a configured Riot installation." />
          <CheckBox Content="Include empty folders" IsChecked="{Binding IncludeEmptyFolders}"
                    ToolTip.Tip="Also list directories that contain no files at any depth." />
        </WrapPanel>

        <ProgressBar Value="{Binding Progress}" Maximum="1" Height="3" IsVisible="{Binding Busy}" />
        <TextBlock Text="{Binding Notes}" FontSize="10" TextWrapping="Wrap"
                   Foreground="{DynamicResource ReyAccent2Brush}"
                   IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </Border>

    <!-- Toolbar: search, type filter, bulk selection -->
    <Border DockPanel.Dock="Top" Margin="14,0,14,6" IsVisible="{Binding HasScanned}">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <TextBox Grid.Column="0" Text="{Binding SearchText}" Watermark="Search path or reason…"
                 FontSize="11" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding TypeFilters}"
                  SelectedItem="{Binding SelectedTypeFilter}" MinWidth="120" Margin="8,0,0,0"
                  FontSize="11" />
        <Button Grid.Column="2" Classes="tool" Content="Select all" Margin="8,0,0,0"
                Command="{Binding SelectAllCommand}"
                ToolTip.Tip="Ticks every visible row except the protected/uncertain group." />
        <Button Grid.Column="3" Classes="tool" Content="Deselect all" Margin="6,0,0,0"
                Command="{Binding DeselectAllCommand}" />
      </Grid>
    </Border>

    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Groups}" Margin="14,0,14,14">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CleanupGroupViewModel">
            <Border Classes="card" Margin="0,0,0,10">
              <StackPanel Spacing="4">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="tool" Content="None" Margin="6,0,0,0"
                          Command="{Binding ClearGroupCommand}" FontSize="10"
                          ToolTip.Tip="Untick every row in this group." />
                  <Button DockPanel.Dock="Right" Classes="tool" Content="All" Margin="6,0,0,0"
                          Command="{Binding SelectGroupCommand}" FontSize="10"
                          ToolTip.Tip="Tick every row in this group." />
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" FontSize="10"
                             Foreground="{DynamicResource ReyTextDimBrush}" VerticalAlignment="Center" />
                  <TextBlock Classes="cardTitle" Text="{Binding Title}" />
                </DockPanel>
                <TextBlock Text="{Binding Explanation}" FontSize="10" TextWrapping="Wrap"
                           Foreground="{DynamicResource ReyTextDimBrush}" />

                <Grid ColumnDefinitions="Auto,*,70,70,2*" Margin="0,4,0,2">
                  <TextBlock Grid.Column="1" Text="FILE" FontSize="9" FontWeight="Bold"
                             Foreground="{DynamicResource ReyTextDimBrush}" />
                  <TextBlock Grid.Column="2" Text="TYPE" FontSize="9" FontWeight="Bold"
                             Foreground="{DynamicResource ReyTextDimBrush}" />
                  <TextBlock Grid.Column="3" Text="SIZE" FontSize="9" FontWeight="Bold"
                             Foreground="{DynamicResource ReyTextDimBrush}" />
                  <TextBlock Grid.Column="4" Text="REASON" FontSize="9" FontWeight="Bold"
                             Foreground="{DynamicResource ReyTextDimBrush}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CleanupRowViewModel">
                      <Grid ColumnDefinitions="Auto,*,70,70,2*" Margin="0,1">
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,0,6,0"
                                  MinWidth="0" Padding="0" />
                        <TextBlock Grid.Column="1" Text="{Binding RelPath}" FontSize="10"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding RelPath}" />
                        <TextBlock Grid.Column="2" Text="{Binding TypeName}" FontSize="10"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ReyTextDimBrush}" />
                        <TextBlock Grid.Column="3" Text="{Binding Size}" FontSize="10"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ReyTextDimBrush}" />
                        <TextBlock Grid.Column="4" Text="{Binding Reason}" FontSize="10"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding Reason}"
                                   Foreground="{DynamicResource ReyTextDimBrush}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
