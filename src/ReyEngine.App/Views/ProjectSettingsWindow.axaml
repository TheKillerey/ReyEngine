<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ReyEngine.App.Views"
        xmlns:vm="clr-namespace:ReyEngine.App.ViewModels"
        x:Class="ReyEngine.App.Views.ProjectSettingsWindow"
        Title="Project Settings"
        Width="540" Height="740"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="BorderOnly"
        Background="{DynamicResource ReyBgBrush}"
        Foreground="{DynamicResource ReyTextBrush}"
        FontFamily="Inter, Segoe UI, sans-serif">
  <DockPanel>
  <local:ReyTitleBar DockPanel.Dock="Top" />
  <ScrollViewer>
    <StackPanel Margin="18" Spacing="8">
      <TextBlock Text="MOD METADATA (.fantome)" FontSize="11" FontWeight="SemiBold"
                 Foreground="{DynamicResource ReyTextDimBrush}" />

      <TextBlock Text="Name" FontSize="11" Foreground="{DynamicResource ReyTextDimBrush}" />
      <TextBox Text="{Binding ModName}" PlaceholderText="My Mod Name" />

      <TextBlock Text="Author" FontSize="11" Foreground="{DynamicResource ReyTextDimBrush}" />
      <TextBox Text="{Binding Author}" PlaceholderText="Your name" />

      <TextBlock Text="Version" FontSize="11" Foreground="{DynamicResource ReyTextDimBrush}" />
      <TextBox Text="{Binding Version}" PlaceholderText="1.0.0" Width="160" HorizontalAlignment="Left" />

      <TextBlock Text="Description" FontSize="11" Foreground="{DynamicResource ReyTextDimBrush}" />
      <TextBox Text="{Binding Description}" AcceptsReturn="True" Height="64" TextWrapping="Wrap" />

      <TextBlock Text="Heart URL (optional)" FontSize="11" Foreground="{DynamicResource ReyTextDimBrush}" />
      <TextBox Text="{Binding Heart}" PlaceholderText="https://…" />

      <TextBlock Text="Home URL (optional)" FontSize="11" Foreground="{DynamicResource ReyTextDimBrush}" />
      <TextBox Text="{Binding Home}" PlaceholderText="https://…" />

      <!-- M470: a workshop slug is not derivable from the mod name - "Old Summoner's Rift - Day" lives in
           a folder called oldriftday - so adopting an existing mod needs an explicit field. -->
      <TextBlock Text="LTK Manager workshop mod (optional)" FontSize="11" Foreground="{DynamicResource ReyTextDimBrush}" />
      <TextBox Text="{Binding LtkWorkshopSlug}" PlaceholderText="oldriftday"
               ToolTip.Tip="Which mod in LTK Manager's workshop folder 'Send to LTK Manager' updates, by its mod.config.json name. Leave empty to derive it from the mod name and record it on the first send. Set it to an existing slug (the folder name under your workshop path) to adopt a mod you already ship, instead of creating a duplicate." />

      <TextBlock Text="Thumbnail (PNG/JPG)" FontSize="11" Foreground="{DynamicResource ReyTextDimBrush}" />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBox Text="{Binding ThumbnailPath}" Width="380" />
        <Button Content="Browse…" Command="{Binding BrowseThumbnailCommand}" />
      </StackPanel>

      <Border Height="1" Background="{DynamicResource ReyBorderBrush}" Margin="0,8" />
      <TextBlock Text="PATHS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ReyTextDimBrush}" />

      <TextBlock Text="Game folder (powers reference fallback)" FontSize="11" Foreground="{DynamicResource ReyTextDimBrush}" />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBox Text="{Binding GameDirectory}" Width="380" />
        <Button Content="Browse…" Command="{Binding BrowseGameCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding GameDirectoryMessage}" FontSize="10" TextWrapping="Wrap"
                 Foreground="{DynamicResource ReyErrorBrush}" IsVisible="{Binding HasGameDirectoryError}" />
      <TextBlock Text="{Binding GameDirectoryMessage}" FontSize="10" TextWrapping="Wrap"
                 Foreground="{DynamicResource ReyAccentBrush}"
                 IsVisible="{Binding HasGameDirectoryError, Converter={x:Static BoolConverters.Not}}" />

      <TextBlock Text="Build output folder" FontSize="11" Foreground="{DynamicResource ReyTextDimBrush}" />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBox Text="{Binding OutputDirectory}" Width="380" />
        <Button Content="Browse…" Command="{Binding BrowseOutputCommand}" />
      </StackPanel>

      <!-- M132 -->
      <CheckBox Content="Clean unknown files when packing (only known game formats go into the WAD)"
                IsChecked="{Binding PackKnownTypesOnly}" FontSize="11"
                ToolTip.Tip="Skips editor leftovers — notes, PSDs, temp files — anything that isn't a game format (.tex/.dds/.bin/.skn/.anm/…). Every skipped file is listed in the console." />

      <Border Height="1" Background="{DynamicResource ReyBorderBrush}" Margin="0,8" />
      <TextBlock Text="RIOT PATCH UPDATES" FontSize="11" FontWeight="SemiBold"
                 Foreground="{DynamicResource ReyTextDimBrush}" />
      <TextBlock Text="Project base patch" FontSize="11" Foreground="{DynamicResource ReyTextDimBrush}" />
      <TextBox Text="{Binding RiotPatchVersion}" Width="160" HorizontalAlignment="Left" PlaceholderText="16.15"
               ToolTip.Tip="The Riot patch whose originals this project currently targets. Legacy projects may need this set once." />
      <CheckBox Content="Automatically rebase when the installed Riot patch changes"
                IsChecked="{Binding AutoUpdateOnRiotPatch}" FontSize="11" />
      <CheckBox Content="Automatically rebuild WADs and .fantome after a successful update"
                IsChecked="{Binding AutoBuildAfterPatchUpdate}" FontSize="11" />
      <TextBlock Text="Bin edits use a transactional three-way merge. Full texture, mesh, mapgeo and audio replacements are retained and repacked unchanged. Backups and a report are stored under .reyengine."
                 FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource ReyTextDimBrush}" />

      <Border Height="1" Background="{DynamicResource ReyBorderBrush}" Margin="0,8" />
      <TextBlock Text="CONTENT LAYERS (LTK Manager)" FontSize="11" FontWeight="SemiBold"
                 Foreground="{DynamicResource ReyTextDimBrush}" />
      <TextBlock FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource ReyTextDimBrush}"
                 Text="Send to LTK Manager ships each layer separately, and the user can switch any of them off without losing the rest of the mod - so an optional half, like a particle fix, does not have to live inside the map it is seen on. Layers are applied lowest priority first, and a higher one wins where two touch the same file. A folder no layer claims ships in base. This does not affect a .fantome build, which has no layers." />

      <ItemsControl ItemsSource="{Binding Layers}" Margin="0,4,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ProjectLayerRow">
            <Border Background="{DynamicResource ReyPanelBrush}" CornerRadius="3" Padding="8,6" Margin="0,0,0,4">
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto,64,Auto,Auto">
                  <TextBox Grid.Column="0" Text="{Binding Name}" FontSize="11" Padding="4,2"
                           IsEnabled="{Binding IsEditable}" PlaceholderText="layer name" />
                  <TextBlock Grid.Column="1" Text="priority" FontSize="10" VerticalAlignment="Center"
                             Margin="8,0,4,0" Foreground="{DynamicResource ReyTextDimBrush}" />
                  <NumericUpDown Grid.Column="2" Value="{Binding Priority}" Minimum="0" Maximum="9999"
                                 Increment="10" FormatString="0" FontSize="11" ShowButtonSpinner="False"
                                 IsEnabled="{Binding IsEditable}" />
                  <Button Grid.Column="4" Classes="tool" Content="Remove" FontSize="10" Margin="8,0,0,0"
                          IsVisible="{Binding IsEditable}"
                          Command="{Binding $parent[ItemsControl].((vm:ProjectSettingsViewModel)DataContext).RemoveLayerCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="Delete this layer. Folders that ship in it fall back to base - nothing is dropped from the mod." />
                </Grid>
                <TextBox Text="{Binding Description}" FontSize="10" Padding="4,2"
                         IsEnabled="{Binding IsEditable}"
                         PlaceholderText="what this layer does, shown beside the switch in LTK Manager" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Content="Add Layer" Command="{Binding AddLayerCommand}" FontSize="11"
              HorizontalAlignment="Left" Padding="10,3" />
      <TextBlock Text="{Binding LayerError}" FontSize="10" TextWrapping="Wrap"
                 Foreground="{DynamicResource ReyErrorBrush}" IsVisible="{Binding HasLayerError}" />

      <TextBlock Text="Which layer each folder ships in" FontSize="11" Margin="0,8,0,0"
                 Foreground="{DynamicResource ReyTextDimBrush}" IsVisible="{Binding HasFolders}" />
      <TextBlock Text="This project has no WAD folders yet, so there is nothing to assign."
                 FontSize="10" Foreground="{DynamicResource ReyTextDimBrush}"
                 IsVisible="{Binding !HasFolders}" />
      <ItemsControl ItemsSource="{Binding FolderLayers}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FolderLayerRow">
            <Grid ColumnDefinitions="*,180" Margin="0,0,0,3">
              <TextBlock Grid.Column="0" Text="{Binding Folder}" FontSize="11" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding Layer}"
                        FontSize="11" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProjectLayerRow">
                    <TextBlock Text="{Binding Label}" FontSize="11" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="14,5" />
        <Button Content="Save" Command="{Binding SaveCommand}" Padding="18,5"
                Background="{DynamicResource ReyAccentBrush}" Foreground="{DynamicResource ReyOnAccentBrush}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
  </DockPanel>
</Window>
