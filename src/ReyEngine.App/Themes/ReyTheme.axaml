<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================================================================
       ReyEngine · PROJECT KALISTA control styles (M39)
       Premium Unreal/Unity-style editor chrome: consistent density, subtle borders,
       cyan hover/active states, no chunky default controls.
       ============================================================================ -->

  <!-- ── typography ─────────────────────────────────────────────────────────── -->

  <!-- Panel section header: small caps label with a cyan tick -->
  <Style Selector="TextBlock.panelHeader">
    <Setter Property="Foreground" Value="{DynamicResource ReyTextDimBrush}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.2" />
    <Setter Property="Padding" Value="10,7" />
  </Style>

  <!-- Card section title inside inspector cards -->
  <Style Selector="TextBlock.cardTitle">
    <Setter Property="Foreground" Value="{DynamicResource ReyTextDimBrush}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.1" />
  </Style>

  <!-- monospace data readouts -->
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource ReyTextDimBrush}" />
  </Style>

  <!-- ── panels / cards ─────────────────────────────────────────────────────── -->

  <!-- Inspector/section card: rounded, bordered, subtle depth -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource ReyCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ReyBorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10" />
  </Style>

  <!-- M72: settings-dialog section card (bigger radius + breathing room, like the reference) -->
  <Style Selector="Border.settingsCard">
    <Setter Property="Background" Value="{DynamicResource ReyCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ReyBorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="20,16" />
  </Style>
  <Style Selector="TextBlock.settingsTitle">
    <Setter Property="Foreground" Value="{DynamicResource ReyTextBrightBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.2" />
  </Style>
  <Style Selector="TextBlock.settingsDesc">
    <Setter Property="Foreground" Value="{DynamicResource ReyTextDimBrush}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="17" />
  </Style>

  <!-- Translucent HUD overlay (viewport hints) -->
  <Style Selector="Border.glass">
    <Setter Property="Background" Value="{DynamicResource ReyGlassBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ReyBorderAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>

  <!-- ── badges / status pills ──────────────────────────────────────────────── -->

  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource ReyPanelAltBrush}" />
  </Style>
  <Style Selector="Border.badge > TextBlock">
    <Setter Property="FontSize" Value="9" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource ReyTextDimBrush}" />
  </Style>
  <Style Selector="Border.badge.accent">
    <Setter Property="Background" Value="{DynamicResource ReyAccentBrush}" />
  </Style>
  <Style Selector="Border.badge.accent > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ReyOnAccentBrush}" />
  </Style>
  <Style Selector="Border.badge.violet">
    <Setter Property="Background" Value="{DynamicResource ReyAccent2SoftBrush}" />
  </Style>
  <Style Selector="Border.badge.violet > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ReyTextBrightBrush}" />
  </Style>
  <Style Selector="Border.badge.warn">
    <Setter Property="Background" Value="{DynamicResource ReyWarningSoftBrush}" />
  </Style>
  <Style Selector="Border.badge.warn > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ReyWarningBrush}" />
  </Style>
  <Style Selector="Border.badge.outline">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource ReyBorderAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.badge.outline > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ReyAccentBrush}" />
  </Style>

  <!-- ── buttons ────────────────────────────────────────────────────────────── -->

  <!-- Toolbar / utility button: dark, thin border, cyan hover edge -->
  <Style Selector="Button.tool">
    <Setter Property="Background" Value="{DynamicResource ReyPanelAltBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ReyTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ReyBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ReyBorderBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ReyAccentBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ReyTextBrightBrush}" />
  </Style>
  <Style Selector="Button.tool:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ReyAccentDeepBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ReyAccentBrush}" />
  </Style>
  <Style Selector="Button.tool:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- Primary call-to-action (Build / Save to Mod): cyan fill -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource ReyAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ReyOnAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="11,5" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ReyAccentHoverBrush}" />
  </Style>
  <Style Selector="Button.primary:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- M72: success/confirm action (Save Settings) — dark-green fill, bright green edge, like the reference -->
  <Style Selector="Button.success">
    <Setter Property="Background" Value="{DynamicResource ReySuccessSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ReySuccessBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ReySuccessBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="16,7" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.success:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ReySuccessSoftHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ReySuccessBrush}" />
  </Style>
  <Style Selector="Button.success:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- M72: settings sidebar navigation (icon + label rows, accent-tinted selection like the reference) -->
  <Style Selector="ListBox.settingsNav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.settingsNav ListBoxItem">
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="ListBox.settingsNav ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ReyHoverBrush}" />
  </Style>
  <Style Selector="ListBox.settingsNav ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ReySelectionBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ReyAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ReyTextBrightBrush}" />
  </Style>

  <!-- M73: wizard step indicator (New Project sidebar) -->
  <Style Selector="Border.stepItem">
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.stepItem.active">
    <Setter Property="Background" Value="{DynamicResource ReySelectionBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ReyAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.stepItem TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ReyTextDimBrush}" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="Border.stepItem.active TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ReyTextBrightBrush}" />
  </Style>
  <Style Selector="TextBlock.stepNum">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Width" Value="16" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.stepItem.active TextBlock.stepNum">
    <Setter Property="Foreground" Value="{DynamicResource ReyAccentBrush}" />
  </Style>

  <!-- M72: theme picker card (settings ▸ theme) — swatch tile, accent ring when selected -->
  <Style Selector="Button.themeCard">
    <Setter Property="Background" Value="{DynamicResource ReyCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ReyBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.themeCard:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ReyPanelAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ReyBorderAccentBrush}" />
  </Style>
  <Style Selector="Button.themeCard.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource ReyAccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Background" Value="{DynamicResource ReyPanelAltBrush}" />
  </Style>

  <!-- Small icon-only button (tab close, ✓/↺ micro actions) -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="5,2" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource ReyTextDimBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ReyHoverBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ReyAccentBrush}" />
  </Style>

  <!-- M578: window caption buttons.
       The app draws its own now. Avalonia 12 paints a title bar of its own into the extended client
       area, which put the window title on top of the brand and its buttons underneath the settings
       gear; there is no "buttons but no title" setting, so the whole thing is ours. Sized 44x32 to
       match what Windows uses, so the muscle memory for the corner still works. -->
  <Style Selector="Button.caption">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource ReyTextDimBrush}" />
  </Style>
  <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ReyHoverBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ReyTextBrightBrush}" />
  </Style>
  <!-- Close goes red on hover, as it does everywhere else in Windows. -->
  <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#C42B1C" />
    <Setter Property="TextElement.Foreground" Value="White" />
  </Style>

  <!-- ── toggle buttons (viewport pills, Show/Play toggles) ─────────────────── -->

  <Style Selector="ToggleButton">
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="ToggleButton.vp">
    <Setter Property="Background" Value="{DynamicResource ReyGlassBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ReyTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ReyBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="ToggleButton.vp:pointerover /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource ReyBorderAccentBrush}" />
  </Style>
  <Style Selector="ToggleButton.vp:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ReyAccentDeepBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ReyAccentBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ReyAccentHoverBrush}" />
  </Style>

  <!-- M685: the viewport's split button (NavGrid) in the same row as Button.tool at 11px / 8,3. Fluent's
       SplitButton is 32px tall with its own translucent greys; its two inner buttons take Background,
       BorderBrush, Padding and CornerRadius from the SplitButton by TemplateBinding, so the outer style
       sets the look and the /template/ styles trim what the template hard-codes (a 32px secondary,
       a full border on both halves - the seam keeps the separator line only). -->
  <Style Selector="SplitButton.vp">
    <Setter Property="Background" Value="{DynamicResource ReyPanelAltBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ReyTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ReyBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="SplitButton.vp /template/ Button#PART_PrimaryButton">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="BorderThickness" Value="1,1,0,1" />
  </Style>
  <Style Selector="SplitButton.vp /template/ Button#PART_SecondaryButton">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="BorderThickness" Value="0,1,1,1" />
  </Style>
  <Style Selector="SplitButton.vp /template/ Border#SeparatorBorder">
    <Setter Property="Background" Value="{DynamicResource ReyBorderBrush}" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="SplitButton.vp /template/ Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ReyBorderBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ReyAccentBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ReyTextBrightBrush}" />
  </Style>
  <Style Selector="SplitButton.vp /template/ Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ReyAccentDeepBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ReyAccentBrush}" />
  </Style>

  <!-- ── menu bar ───────────────────────────────────────────────────────────── -->

  <Style Selector="Menu > MenuItem">
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Menu > MenuItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource ReyHoverBrush}" />
  </Style>

  <!-- ── trees / lists (rows: compact, hover + selected translucent cyan) ───── -->

  <Style Selector="TreeViewItem">
    <Setter Property="Padding" Value="2,1" />
    <Setter Property="MinHeight" Value="22" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>

  <!-- Console rows: tighter still -->
  <Style Selector="ListBox.console ListBoxItem">
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="MinHeight" Value="17" />
  </Style>

  <!-- ── inputs ─────────────────────────────────────────────────────────────── -->

  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- ── tabs (inspector) ───────────────────────────────────────────────────── -->

  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,4" />
  </Style>

  <!-- ── expanders ──────────────────────────────────────────────────────────── -->

  <Style Selector="Expander">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="{DynamicResource ReyPanelAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ReyBorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <!-- M50c: theme the expander header/body — Fluent's near-black defaults clashed with the Kalista navy -->
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="Background" Value="{DynamicResource ReyPanelAltBrush}" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Expander /template/ Border#ExpanderContent">
    <Setter Property="Background" Value="{DynamicResource ReyPanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ReyBorderSoftBrush}" />
    <Setter Property="Padding" Value="6" />
  </Style>

  <!-- ── splitters ──────────────────────────────────────────────────────────── -->

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="{DynamicResource ReyBorderSoftBrush}" />
  </Style>
  <Style Selector="GridSplitter:pointerover">
    <Setter Property="Background" Value="{DynamicResource ReyAccentDeepBrush}" />
  </Style>

  <!-- ── scrollbars: slim, unobtrusive ──────────────────────────────────────── -->

  <Style Selector="ScrollBar:vertical">
    <Setter Property="Width" Value="10" />
  </Style>
  <Style Selector="ScrollBar:horizontal">
    <Setter Property="Height" Value="10" />
  </Style>

  <!-- ── sliders: compact ───────────────────────────────────────────────────── -->

  <Style Selector="Slider">
    <Setter Property="MinHeight" Value="24" />
  </Style>

  <!-- ── M156/M157: colour picker ───────────────────────────────────────
       ColorPicker/ColorView ship their own Fluent control themes inside
       Avalonia.Controls.ColorPicker.dll and paint the flyout in Fluent's defaults.

       Two things to know before editing this block (both verified against a live
       flyout, not assumed):
       1. A bare type selector in Avalonia is an EXACT-type match. The app only ever
          instantiates <ColorPicker>, and ColorPicker : ColorView, so a "ColorView ..."
          selector matches NOTHING. ":is(ColorView) ..." hits both and cannot reach any
          other control in the app.
       2. "/template/" does NOT reach the flyout's tabs — Popup assigns their
          TemplatedParent after styling is evaluated, so the selector caches a permanent
          no-match. The plain descendant combinator works (template children are logical
          children). Piercing the TabItem's OWN template is fine and is required for the
          hover/pressed states, which the ControlTheme paints onto PART_LayoutRoot.
       Style setters outrank ControlTheme setters, so these win without retemplating. -->

  <Styles.Resources>
    <SolidColorBrush x:Key="ColorViewContentBackgroundBrush" Color="{DynamicResource ReyPanel}" />
    <SolidColorBrush x:Key="ColorViewContentBorderBrush" Color="{DynamicResource ReyBorder}" />
    <!-- Inert today: the template never gives TabBackgroundBorder a BorderThickness.
         Kept so the strip picks up the palette if upstream ever sets one. -->
    <SolidColorBrush x:Key="ColorViewTabBorderBrush" Color="{DynamicResource ReyBorder}" />
    <!-- The 48px tab strip. ColorViewTabBackgroundBrush is a DEAD key — commented out in
         the ColorPicker's own Fluent.xaml AND at every usage — so overriding it did
         nothing. The strip's Background is hard-wired to SystemControlBackgroundBaseLowBrush
         (Fluent dark #33FFFFFF: the washed-out white bar) as a LOCAL value in the template,
         which no Style can reach. The resource key is the only lever. -->
    <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush" Color="{DynamicResource ReyHeader}" />
    <!-- M686: the X/Y/Z labels beside transform fields. Red/green/blue is the gizmo's convention in every
         3D tool and does not belong to a palette, so it lives here once instead of in 27 TextBlocks. -->
    <SolidColorBrush x:Key="ReyAxisXBrush" Color="#E5645B" />
    <SolidColorBrush x:Key="ReyAxisYBrush" Color="#53C67A" />
    <SolidColorBrush x:Key="ReyAxisZBrush" Color="#4C9FE8" />
  </Styles.Resources>

  <!-- SystemControlBackgroundBaseLowBrush is shared with exactly one other control we use:
       ProgressBar's track. Restate it so the status bar keeps a visible track instead of
       inheriting the strip colour. -->
  <Style Selector="ProgressBar">
    <Setter Property="Background" Value="{DynamicResource ReyBorderBrush}" />
  </Style>

  <!-- the inline trigger: a swatch button sized like our other compact inputs -->
  <Style Selector="ColorPicker">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource ReyPanelAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ReyBorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- ── picker tabs ─────────────────────────────────────────────────────
       The generic "TabItem" style above (MinHeight 30 / Padding 10,4) also lands on these
       and outranks their ControlTheme — that mismatch WAS the bug. The strip is hard-coded
       to 48px in three places (TabBackgroundBorder Height, ContentBackgroundBorder Margin,
       and the header Borders bound to ColorViewTabStripHeight), so the tabs must be
       restored to 48 here, NOT shrunk to editor density. -->
  <Style Selector=":is(ColorView) TabItem">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource ReyTextDimBrush}" />
  </Style>

  <!-- the outer two tabs follow the flyout's rounded top so an opaque selected tab never
       squares off the popup corner. (nth-child counts hidden tabs — fine here, the app
       leaves all three tabs visible.) -->
  <Style Selector=":is(ColorView) TabItem:nth-child(1)">
    <Setter Property="CornerRadius" Value="5,0,0,0" />
  </Style>
  <Style Selector=":is(ColorView) TabItem:nth-last-child(1)">
    <Setter Property="CornerRadius" Value="0,5,0,0" />
  </Style>

  <!-- selected: merges into the content panel below, accent icon. The underline
       (PART_SelectedPipe) is already crimson via the palettes' own
       TabItemHeaderSelectedPipeFill — don't touch that key, the inspector tabs share it. -->
  <Style Selector=":is(ColorView) TabItem:selected">
    <Setter Property="Background" Value="{DynamicResource ReyPanelBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ReyAccentBrush}" />
  </Style>

  <!-- hover / pressed: the ControlTheme paints these straight onto Border#PART_LayoutRoot,
       so a TabItem.Background setter would lose to it — pierce to the same element.
       TextElement.Foreground is what tints the PathIcon. -->
  <Style Selector=":is(ColorView) TabItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource ReyHoverBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ReyTextBrightBrush}" />
  </Style>
  <Style Selector=":is(ColorView) TabItem:selected:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource ReyPanelAltBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ReyAccentHoverBrush}" />
  </Style>
  <Style Selector=":is(ColorView) TabItem:pressed /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource ReySelectionBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ReyAccentBrush}" />
  </Style>
  <Style Selector=":is(ColorView) TabItem:selected:pressed /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource ReySelectionBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource ReyAccentBrush}" />
  </Style>

  <!-- the channel sliders read cleaner with our corner radius than Fluent's pill -->
  <Style Selector="ColorSlider">
    <Setter Property="MinHeight" Value="18" />
  </Style>

  <!--
    M593: NEW FEATURE HIGHLIGHT.

    Marks a control that arrived in a release the user has not acknowledged yet:
        Classes.newFeature="{Binding NewFeature[some-feature-id]}"

    Design decisions, all deliberate:

    * OUTER GLOW ONLY. The control's own background, foreground and content are untouched, so text and
      icons keep their contrast and every hover/pressed/selected style still wins - those setters live on
      the same template part and come later in the file, so they override this one's brush.
    * NO LAYOUT EFFECT. BoxShadow renders outside the layout box and BorderThickness is not changed, so a
      highlighted control does not move its neighbours by a pixel. That is why this is a shadow rather
      than the extra border a "new" badge would otherwise want.
    * ReyAccent2 (violet) rather than ReyAccent. Accent is the app's PRIMARY-ACTION colour - it is already
      on Build Package and every selected tab - so glowing with it would read as "this is selected". Accent2
      is the existing attention/unsaved colour and is distinct in all three palettes.
    * NO ANIMATION. This codebase has zero declarative animations, and an infinite pulse on editor chrome
      is a real distraction in a tool people keep open for hours. A static glow is noticeable on arrival
      and stops competing for attention immediately afterwards.
  -->
  <Style Selector="Button.newFeature /template/ ContentPresenter">
    <Setter Property="BoxShadow" Value="0 0 7 0 #8B7CF7" />
    <Setter Property="BorderBrush" Value="{DynamicResource ReyAccent2Brush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ToggleButton.newFeature /template/ ContentPresenter">
    <Setter Property="BoxShadow" Value="0 0 7 0 #8B7CF7" />
    <Setter Property="BorderBrush" Value="{DynamicResource ReyAccent2Brush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="SplitButton.newFeature /template/ ContentPresenter">
    <Setter Property="BoxShadow" Value="0 0 7 0 #8B7CF7" />
  </Style>
  <!-- MenuItem paints through its own layout root rather than a ContentPresenter (see MenuItem above). -->
  <Style Selector="MenuItem.newFeature /template/ Border#PART_LayoutRoot">
    <Setter Property="BoxShadow" Value="0 0 7 0 #8B7CF7" />
    <Setter Property="BorderBrush" Value="{DynamicResource ReyAccent2Brush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <!-- M689: CheckBox paints through Border#PART_Border, which spans the box and its label (measured with
       UiProbe dump CheckBox), so the glow frames the whole row like a menu entry. -->
  <Style Selector="CheckBox.newFeature /template/ Border#PART_Border">
    <Setter Property="BoxShadow" Value="0 0 7 0 #8B7CF7" />
    <Setter Property="BorderBrush" Value="{DynamicResource ReyAccent2Brush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <!-- TabItem is a HeaderedContentControl, not a Border - it has no BoxShadow of its own, so the glow
       goes on its template root the same way the ColorView tab styles below pierce theirs. -->
  <Style Selector="TabItem.newFeature /template/ Border#PART_LayoutRoot">
    <Setter Property="BoxShadow" Value="0 0 7 0 #8B7CF7" />
  </Style>
  <!-- For an inspector section or any panel that is itself the new thing. -->
  <Style Selector="Border.newFeature">
    <Setter Property="BoxShadow" Value="0 0 7 0 #8B7CF7" />
    <Setter Property="BorderBrush" Value="{DynamicResource ReyAccent2Brush}" />
  </Style>

  <!-- The "NEW" pill, for putting next to a highlighted control's label. Reuses the badge vocabulary. -->
  <Style Selector="Border.badge.new">
    <Setter Property="Background" Value="{DynamicResource ReyAccent2SoftBrush}" />
  </Style>
  <Style Selector="Border.badge.new > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ReyAccent2Brush}" />
  </Style>

  <!-- ── document tabs and outliner rows (M686) ───────────────────────────────
       These were BoolToBrushConverters holding Kalista's cyan from before the palettes existed, so the
       active tab and the selected outliner row stayed cyan under every palette and ignored a custom
       accent. A class bound to the view-model flag, styled here, follows both. -->
  <Style Selector="Border.docTab.active">
    <Setter Property="Background" Value="{DynamicResource ReyHoverBrush}" />
  </Style>
  <Style Selector="Border.docTabLine">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.docTabLine.active">
    <Setter Property="Background" Value="{DynamicResource ReyAccentBrush}" />
  </Style>
  <Style Selector="Border.outRow.selected">
    <Setter Property="Background" Value="{DynamicResource ReySelectionBrush}" />
  </Style>

  <!-- ── popups (M685) ──────────────────────────────────────────────────────────
       The flyouts the viewport buttons open (Display, Overlays, NavGrid, Sky) and every tooltip took
       Fluent's own FlyoutPresenter/ToolTip greys - the one surface in the editor that ignored the
       palette. They take the menu's colours now: the palettes define MenuFlyoutPresenterBackground as
       an OPAQUE panel colour, so a popup over the 3D view stays readable when the glass slider makes
       the docked panels see-through. -->
  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource MenuFlyoutPresenterBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ReyBorderAccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource ReyTextBrush}" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource MenuFlyoutPresenterBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ReyBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Foreground" Value="{DynamicResource ReyTextBrush}" />
    <Setter Property="Padding" Value="8,5" />
  </Style>

</Styles>
