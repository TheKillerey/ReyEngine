<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ReyEngine.App.App"
             RequestedThemeVariant="Dark">

  <!-- M39/M72: theme system — swappable palettes in Themes/Palettes (same keys each), control styles in
       Themes/ReyTheme.axaml. Views consume tokens via DynamicResource only; ThemeService swaps
       MergedDictionaries[0] live at runtime. The include below is only the pre-settings default. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ReyEngine.App/Themes/Palettes/Crimson.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <!-- M155: ColorPicker/ColorView ship their control themes in their own assembly. FluentTheme above
         only themes the base Avalonia.Controls, so without this include the picker resolves at compile
         time but renders as a zero-size blank. Must come before ReyTheme so our styles can override it. -->
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <StyleInclude Source="avares://ReyEngine.App/Themes/ReyTheme.axaml" />
  </Application.Styles>

</Application>
